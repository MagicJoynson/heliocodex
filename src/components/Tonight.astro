---
// "Tonight" strip for the home page. Filled in by the visitor's own device from the sky sums
// (src/lib/sky/tonight.ts), for the same place every other page uses (src/lib/sky/remember.ts herePlace),
// with times as the clocks read there. Nothing is sent anywhere.
import { upcoming } from '../lib/sky/upcoming';
// the next few events worth looking up for, worked out when the site is built; the page picks the first one still ahead
const t0 = new Date();
const ahead = upcoming(t0, new Date(t0.getTime() + 400 * 86400000)).filter((i) => !['sun', 'near', 'far'].includes(i.kind)).slice(0, 12)
  .map((i) => ({ at: i.at.toISOString(), title: i.title }));
---
<section class="tonight" aria-labelledby="tn-h" data-tonight data-ahead={JSON.stringify(ahead)}>
  <noscript><style>.tonight .tn-where, .tonight .tn-moon svg { display: none; }</style></noscript>
  <div class="tn-where"><h2 id="tn-h">Tonight from <span data-tn-place>London</span></h2><a class="tn-change" href="/sky#where" data-tn-change>Change place</a></div>
  <div class="tn-item tn-moon">
    <svg width="60" height="60" viewBox="-30 -30 60 60" aria-hidden="true" focusable="false"><circle r="26" class="dark" /><path class="lit" d="" /></svg>
    <div><b data-tn-moon>The Moon</b><span data-tn-moon-sub>Its phase tonight is on the sky map</span></div>
  </div>
  <div class="tn-item"><div><b data-tn-planets>The planets</b><span data-tn-planets-sub>Which are up tonight is on the sky map</span></div></div>
  <a class="tn-go" href="/sky">Open tonight’s sky</a>
  <a class="tn-go" href="/sky/week">Sky this week</a>
  <a class="tn-go" href="/sky/events">Sky events</a>
  <p class="tn-next" data-tn-next hidden>Next up: <a href="/sky/events" data-tn-next-t></a>, <span data-tn-next-d></span></p>
</section>

<script>
  import { tonight } from '../lib/sky/tonight';
  import { herePlace } from '../lib/sky/remember';
  import { clockIn, clocksDiffer } from '../lib/sky/cities';

  const root = document.querySelector<HTMLElement>('[data-tonight]');
  const text = (k: string, t: string) => { const e = root?.querySelector(`[data-${k}]`); if (e) e.textContent = t; };
  const list = (a: string[]) => a.length < 2 ? a[0] ?? '' : `${a.slice(0, -1).join(', ')} and ${a[a.length - 1]}`;

  function fill(): void {
    if (!root) return;
    const p = herePlace();
    const t = tonight(new Date(), p.lat, p.lon);
    const at = (d: Date) => clockIn(d, p.zone) + (clocksDiffer(d, p.zone) ? ' local time' : '');
    text('tn-place', p.from);
    const change = root.querySelector<HTMLAnchorElement>('[data-tn-change]');
    if (change) change.textContent = p.guessed ? 'Not there? Change place' : 'Change place';
    const pct = Math.round(t.moon.lit * 100);
    text('tn-moon', t.moon.name);
    const sky = t.moon.up ? `${t.now ? 'up now' : 'up at dusk'}${t.moon.sets ? `, sets ${at(t.moon.sets)}` : ''}` : t.moon.rises ? `rises ${at(t.moon.rises)}` : 'below the horizon';
    text('tn-moon-sub', `${pct} per cent lit, ${sky}`);
    if (t.noDark) { text('tn-planets', 'It does not get fully dark here tonight'); text('tn-planets-sub', 'The Sun stays too close to the horizon'); }
    else if (t.planets.length) {
      text('tn-planets', `${list(t.planets.map((k) => k.name))} ${t.planets.length > 1 ? 'are' : 'is'} up ${t.now ? 'now' : `from about ${at(t.at)}`}`);
      text('tn-planets-sub', t.planets.map((k) => `${k.name}: ${k.where}`).join('; '));
    } else { text('tn-planets', 'No bright planet is up tonight'); text('tn-planets-sub', 'Planets you can see by eye'); }
    // the lit part of the face: right-hand side while the Moon grows (left in the southern hemisphere), the other way as it shrinks
    const r = 26, k = 1 - 2 * t.moon.lit;
    const d = `M0 ${-r} A${r} ${r} 0 0 1 0 ${r} A${Math.abs(k) * r} ${r} 0 0 ${k > 0 ? 0 : 1} 0 ${-r}Z`;
    const path = root.querySelector('path.lit');
    if (path) {
      path.setAttribute('d', d);
      const flip = t.moon.waxing === (p.lat >= 0);
      path.setAttribute('transform', flip ? '' : 'scale(-1 1)');
    }
    // the next event, from the list made at build time, shown in the visitor's own day
    try {
      const now = Date.now();
      const nx = (JSON.parse(root.dataset.ahead ?? '[]') as { at: string; title: string }[]).find((e) => Date.parse(e.at) > now);
      const box = root.querySelector<HTMLElement>('[data-tn-next]');
      if (nx && box) {
        text('tn-next-t', nx.title);
        text('tn-next-d', new Date(nx.at).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' }));
        box.hidden = false;
      }
    } catch { /* the line is an extra: leave it out */ }
    root.setAttribute('data-ready', '');
  }
  fill();
  document.addEventListener('visibilitychange', () => { if (!document.hidden) fill(); });
</script>

<style>
  .tonight { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--bg); padding: 22px var(--edge); display: flex; flex-wrap: wrap; gap: 18px 44px; align-items: center; min-height: 108px; justify-content: flex-start; }
  .tn-where { min-width: 7.5rem; }
  .tn-where h2 { font: 400 .8125rem/1.5 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); margin: 0; }
  .tn-where h2 span { color: var(--ink-soft); }
  .tn-change { display: inline-block; margin-top: 4px; font: 400 .875rem/1.4 var(--serif); color: var(--ink-soft); text-decoration: underline; text-decoration-color: rgba(236,231,220,.35); text-underline-offset: .2em; }
  .tn-change:hover, .tn-change:focus-visible { color: var(--accent); }
  .tn-item { display: flex; gap: 16px; align-items: center; }
  .tn-item b { display: block; font: 400 1.25rem/1.3 var(--serif); color: var(--ink); }
  .tn-item span { display: block; font: 400 .8125rem/1.5 var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--ink-faint); max-width: 34rem; }
  .tn-moon svg .dark { fill: #14161f; stroke: #2c3145; }
  .tn-moon svg .lit { fill: var(--ink); }
  .tn-go { font: 400 .8125rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--accent); border-bottom: 1px solid rgba(255, 179, 71, .5); text-decoration: none; padding-bottom: 3px; }
  .tn-next { margin: 0; font: 400 .8125rem/1.4 var(--serif); color: var(--ink-faint); }
  .tn-next[hidden] { display: none; }
  .tn-next a { color: var(--ink-soft); text-decoration: underline; text-decoration-color: rgba(236,231,220,.35); text-underline-offset: .2em; }
  .tn-next a:hover, .tn-next a:focus-visible { color: var(--accent); }
  @media (max-width: 760px) { .tonight { min-height: 250px; flex-direction: column; align-items: flex-start; } }
</style>
