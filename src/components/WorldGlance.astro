---
// The first screen of a world page: five numbers to keep, and the two ways on (the reference block at the
// end of the page, and the 3D view), in the same instrument lettering as the altitude ruler beside it.
import facts from '../data/facts.json';
import { fmt } from '../lib/format';
import { TEMPS } from '../lib/planet-sheet';
interface Props { world: string }
const { world } = Astro.props;
const p = (facts.planets as unknown as Record<string, { physical: Record<string, number>; elements: { a_au: number } }>)[world];
// the data sheet's first three, in the same order: distance, size, temperature. The rest is in the sheet below.
const items: [string, string][] = [
  world === 'sun' ? ['From the Earth', '1 au'] : ['From the Sun', `${p.elements.a_au < 10 ? p.elements.a_au.toFixed(2).replace(/\.?0+$/, '') : p.elements.a_au.toFixed(1)} au`],
  ['Size', world === 'sun' ? '109 Earths wide' : world === 'earth' ? '12,742 km wide' : `${fmt(p.physical.radius_mean_km / 6371, 2)} Earths wide`],
  ['Temperature', TEMPS[world].short],
];
---
<div class="wglance">
  <dl>{items.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
  <p class="wg-go"><a href="#sheet">All the numbers</a><a href={`/explore?go=${world}`}>In 3D</a></p>
</div>
<style>
  /* a dark band of glass, so the numbers read over a bright planet as well as over black */
  .wglance { margin: 1.6rem 0 0; width: min(36rem, 100%); max-width: 100%; box-sizing: border-box; padding: .9rem 1.1rem 1rem; border-radius: 4px; background: rgba(5,6,9,.72); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border: 1px solid rgba(236,231,220,.1); font-family: 'IBM Plex Mono', ui-monospace, monospace; text-align: left; }
  .wglance dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem 1.2rem; margin: 0; min-width: min(24rem, 100%); }
  .wglance dt { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: rgba(236,231,220,.7); margin: 0 0 .3rem; }
  .wglance dd { margin: 0; font-size: 15px; color: #ece7dc; }
  .wg-note { margin: .6rem 0 0; font-size: 11px; letter-spacing: .02em; color: rgba(236,231,220,.62); }
  .wg-go { display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; margin: 1rem 0 0; }
  .wg-go a { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #ece7dc; text-decoration: none; border-bottom: 1px solid rgba(233,196,138,.6); padding-bottom: 3px; pointer-events: auto; }
  .wg-go a:hover { color: #e9c48a; }
</style>
