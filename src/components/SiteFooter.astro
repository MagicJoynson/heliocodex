---
// The one footer, used by every page: reading pages, the planet falls and the 3D view's menu pages.
import '@fontsource/spectral/300.css';
import '@fontsource/spectral/400.css';
import '@fontsource/ibm-plex-mono/400.css';
import { sections } from '../lib/nav';
---
<footer class="site-footer">
  <div class="foot-grid">
    <div class="foot-brand">
      <a href="/" class="foot-mark">Heliocodex</a>
      <p>The Sun, its worlds and everything beyond, in real photographs and real measurements.</p>
    </div>
    <nav class="foot-col" aria-label="Sections">
      <p class="foot-h">Explore</p>
      <a href="/">Home</a>
      {sections.map((s) => <a href={s.href}>{s.label}</a>)}
    </nav>
    <nav class="foot-col" aria-label="Legal">
      <p class="foot-h">About</p>
      <a href="/sources">Sources</a>
      <a href="/licences">Licences and credits</a>
      <a href="/privacy">Privacy</a>
      <a href="/cookies">Cookies and storage</a>
      <a href="/terms">Terms</a>
      <a href="/accessibility">Accessibility</a>
      <a href="mailto:hello@fallinghippo.com">hello@fallinghippo.com</a>
    </nav>
  </div>
  <p class="foot-small">Heliocodex is run by FALLINGHIPPO LIMITED, company number 17415391, registered in England and Wales. Registered office: 71-75 Shelton Street, London, England, WC2H 9JQ. It is independent of NASA, ESA and every mission named here, and none of them endorses it. Physical data comes from NASA NSSDC planetary fact sheets, orbits from NASA/JPL Solar System Dynamics, and planet maps from Solar System Scope (CC BY 4.0). See <a href="/sources">Sources</a> for everything we use and how.</p>
</footer>

<style>
.site-footer { border-top: 1px solid rgba(236,231,220,.12); padding: 56px clamp(20px, 5vw, 64px) 48px; color: #8a8478; background: #08080a; font: 300 1rem/1.55 'Spectral', Georgia, serif; }
.foot-grid { max-width: 80rem; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr)); gap: 2rem 3rem; }
.foot-mark { font: 400 1.5rem/1 'Spectral', Georgia, serif; color: #ece7dc; text-decoration: none; }
.foot-brand p { margin: .8rem 0 0; max-width: 24rem; }
.foot-col { display: grid; gap: .45rem; align-content: start; }
.foot-h { font: 400 .7rem/1.4 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; margin: 0 0 .3rem; color: #8a8478; }
.foot-col a { color: #c4bdaf; text-decoration: none; }
.foot-col a:hover { color: #e9c48a; }
.foot-small { max-width: 80rem; margin: 2.6rem auto 0; padding-top: 1.4rem; border-top: 1px solid rgba(236,231,220,.12); font-size: .86rem; }
.foot-small a { color: inherit; }
@media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-brand { grid-column: 1 / -1; } }
  .site-footer { position: relative; z-index: 5; }
</style>
