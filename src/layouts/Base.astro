---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { sections, groups } from '../lib/nav';
import SiteFooter from '../components/SiteFooter.astro';
import ThreeDReturn from '../components/ThreeDReturn.astro';
interface Props { title: string; description?: string; path?: string; accent?: string; noindex?: boolean }
const { title, description = 'An interactive, data-driven atlas of the Sun and the planets, built on open NASA and JPL data.', path = '/', accent, noindex } = Astro.props;
const url = new URL(path, Astro.site).toString();
const full = title === 'Heliocodex' ? title : `${title} · Heliocodex`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="Heliocodex" />
    <meta property="og:image" content={new URL('/brand/heliocodex-social-card-1200x630.png', Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Heliocodex: an amber Sun with a small dark world crossing it" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#07080d" />
    {accent && <style set:html={`:root{--accent:${accent}}`} />}
    <Analytics />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/"><img src="/brand/heliocodex-lockup.svg" alt="Heliocodex" width="660" height="133" /></a>
      <nav class="site-nav" aria-label="Main">
        {groups.map((g) => <span class="nav-group" data-group={g.id}>{g.sections.map((x) => <a href={x.href} aria-current={x.match(path) ? 'page' : undefined}>{x.label}</a>)}</span>)}
      </nav>
      <button type="button" class="site-menu-btn" aria-expanded="false" aria-controls="site-menu">Menu</button>
      <nav class="site-menu" id="site-menu" aria-label="Main" hidden>
        <a href="/"><b>Home</b><span>Where to start</span></a>
        {groups.map((g) => <><p class="menu-h">{g.name}</p>{g.sections.map((x) => <a href={x.href} aria-current={x.match(path) ? 'page' : undefined}><b>{x.label}</b><span>{x.about}</span></a>)}</>)}
      </nav>
      <script>
        const btn = document.querySelector<HTMLButtonElement>('.site-menu-btn')!;
        const menu = document.getElementById('site-menu')!;
        const set = (open: boolean) => { menu.hidden = !open; btn.setAttribute('aria-expanded', String(open)); };
        btn.addEventListener('click', () => set(Boolean(menu.hidden)));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
        document.addEventListener('click', (e) => { if (!menu.hidden && !menu.contains(e.target as Node) && e.target !== btn) set(false); });
      </script>
    </header>
    <slot />
    <SiteFooter />
    <ThreeDReturn />
  </body>
</html>
