---
import Analytics from '../components/Analytics.astro';
import { sections } from '../lib/nav';
/**
 * Shared bones of a "world" page: the fixed 3D canvas, the haze, the altitude ruler and the scroll
 * driver. Everything you see (type, colour, layout, copy) belongs to the page that uses it.
 */
interface Props { world: string; title: string; description: string; readout?: string; accent?: string }
const { world, title, description, readout = 'Altitude' } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Heliocodex</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(`/${world}`, Astro.site).toString()} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#07080d" />
    <Analytics />
  </head>
  <body data-world={world}>
    <canvas id="journey" aria-hidden="true"></canvas>
    <div id="haze" aria-hidden="true"></div>
    <div id="shade" aria-hidden="true"></div>
    <div id="topfade" aria-hidden="true"></div>
    <div id="arrive" aria-hidden="true"></div>

    <header class="top">
      <a class="mark" href="/">Heliocodex</a>
      <nav class="wnav" aria-label="Main">
        {sections.map((x) => <a href={x.href} aria-current={x.href === '/bodies' ? 'page' : undefined}>{x.href === '/bodies' ? 'All planets' : x.label}</a>)}
      </nav>
      <button type="button" class="wmenu-btn" aria-expanded="false" aria-controls="wmenu">Menu</button>
    </header>
    <nav class="wmenu" id="wmenu" aria-label="Main" hidden>
      <a href="/">Home</a>
      {sections.map((x) => <a href={x.href}>{x.href === '/bodies' ? 'All planets' : x.label}</a>)}
    </nav>

    <aside class="altitude" aria-hidden="true">
      <span class="alt-label">{readout}</span>
      <span class="alt-value" id="alt"></span>
      <span class="ruler"><i id="tick"></i></span>
    </aside>

    <main><slot /></main>
    <footer class="wfoot">
      <a href="/bodies">All planets</a><a href={`/explore?go=${world}`}>See it in 3D</a><a href="/sources">Sources</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/cookies">Cookies and storage</a><a href="/licences">Licences and credits</a><a href="/accessibility">Accessibility</a>
    </footer>

    <script>
      import { createJourney } from '../lib/journey/engine';
      import { worlds } from '../lib/journey/worlds';
      const wbtn = document.querySelector<HTMLButtonElement>('.wmenu-btn')!;
      const wmenu = document.getElementById('wmenu')!;
      const wset = (open: boolean) => { wmenu.hidden = !open; wbtn.setAttribute('aria-expanded', String(open)); };
      wbtn.addEventListener('click', () => wset(Boolean(wmenu.hidden)));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !wmenu.hidden) { wset(false); wbtn.focus(); } });
      document.addEventListener('click', (e) => { if (!wmenu.hidden && !wmenu.contains(e.target as Node) && e.target !== wbtn) wset(false); });
      const id = document.body.dataset.world!;
      const canvas = document.getElementById('journey') as HTMLCanvasElement;
      const journey = createJourney(canvas, document.getElementById('haze')!, worlds[id]);
      const alt = document.getElementById('alt')!;
      const tick = document.getElementById('tick')!;
      const altLabel = document.querySelector<HTMLElement>('.alt-label')!;

      // arriving from the solar system: start in the dark and let the planet come up
      const arrive = document.getElementById('arrive')!;
      if (location.search.includes('from=sys')) {
        arrive.style.opacity = '1';
        requestAnimationFrame(() => requestAnimationFrame(() => { arrive.style.opacity = '0'; }));
        history.replaceState(null, '', location.pathname);
      } else arrive.style.display = 'none';

      const beats = [...document.querySelectorAll<HTMLElement>('.beat')];
      const anchors = beats.map((b) => ({ el: b, p: Number(b.dataset.p) }));
      function progress() {
        const mid = scrollY + innerHeight / 2;
        const pts = anchors.map((a) => ({ y: a.el.offsetTop + a.el.offsetHeight / 2, p: a.p }));
        if (mid <= pts[0].y) return pts[0].p;
        for (let i = 1; i < pts.length; i++) {
          if (mid <= pts[i].y) {
            const t = (mid - pts[i - 1].y) / (pts[i].y - pts[i - 1].y);
            return pts[i - 1].p + t * (pts[i].p - pts[i - 1].p);
          }
        }
        return 1;
      }
      // copy fades out as it reaches the header, rather than sliding underneath it
      const fadeEls = [...document.querySelectorAll<HTMLElement>('main .copy > *, main figure')];
      function fadeCopy() {
        const top = innerWidth < 760 ? 46 : 64;
        for (const el of fadeEls) {
          const r = el.getBoundingClientRect();
          const edge = r.top + Math.min(r.height * 0.5, 60);
          const o = Math.min(1, Math.max(0, (edge - top) / 80));
          el.style.opacity = o >= 0.999 ? '' : o.toFixed(3);
        }
      }
      let last = '';
      function update() {
        fadeCopy();
        const p = progress();
        journey.setProgress(p);
        tick.style.top = `${p * 100}%`;
        const txt = journey.readout();
        if (txt !== last) {
          alt.textContent = txt; last = txt;
          // above the clouds it is height; inside a gas giant it is pressure
          altLabel.textContent = /^[\d.]+ bar$/.test(txt) ? 'Pressure' : 'Altitude';
        }
      }
      addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);
      addEventListener('pointermove', (e) => journey.setPointer((e.clientX / innerWidth) * 2 - 1, (e.clientY / innerHeight) * 2 - 1));
      setInterval(update, 100);
      update();
    </script>

    <style is:global>
      :root { --pad: clamp(20px, 6vw, 88px); }
      * { box-sizing: border-box; }
      html { background: var(--night); }
      body { margin: 0; color: var(--ink); font: 400 clamp(1.02rem, 0.96rem + 0.3vw, 1.2rem)/1.62 var(--text); -webkit-font-smoothing: antialiased; }
      #journey { position: fixed; inset: 0; width: 100%; height: 100%; display: block; z-index: 0; }
      #haze { position: fixed; inset: 0; z-index: 1; pointer-events: none; opacity: 0; }
      #shade { position: fixed; inset: 0; z-index: 2; pointer-events: none; background: var(--shade); }
      #topfade { position: fixed; z-index: 9; left: 0; right: 0; top: 0; height: 96px; pointer-events: none; background: linear-gradient(to bottom, var(--night-a), transparent); }
      #arrive { position: fixed; inset: 0; z-index: 50; background: #000; opacity: 0; pointer-events: none; transition: opacity 1.4s ease; }
      .top { position: fixed; z-index: 10; left: 0; right: 0; top: 0; display: flex; justify-content: space-between; gap: 16px; padding: 18px var(--pad); font: 400 .78rem/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
      .top a { color: var(--ink); text-decoration: none; text-shadow: 0 1px 10px rgba(0,0,0,.55); }
      .wnav { display: flex; gap: clamp(12px, 1.6vw, 22px); }
      .wnav a { color: var(--ink-soft); }
      .wnav a[aria-current] { color: var(--ink); }
      .wmenu-btn { display: none; font: inherit; letter-spacing: inherit; text-transform: inherit; color: var(--ink); background: rgba(0,0,0,.35); border: 1px solid rgba(255,255,255,.25); border-radius: 999px; padding: 9px 14px; cursor: pointer; }
      .wmenu { position: fixed; z-index: 11; top: 58px; right: var(--pad); display: grid; min-width: 14rem; background: rgba(8,8,10,.96); border: 1px solid rgba(255,255,255,.16); padding: 6px 0; font: 400 .78rem/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
      .wmenu[hidden] { display: none; }
      .wfoot { position: relative; z-index: 5; display: flex; flex-wrap: wrap; gap: 10px 22px; padding: 28px var(--pad) 36px; background: rgba(0,0,0,.7); font: 400 .72rem/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
      .wfoot a { color: var(--ink-soft); text-decoration: none; }
      .wfoot a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
      .wmenu a { color: var(--ink); text-decoration: none; padding: 14px 18px; }
      .wmenu a:hover { background: rgba(255,255,255,.06); }
      .top a:hover { text-decoration: underline; text-underline-offset: 4px; }
      .altitude { position: fixed; z-index: 10; right: var(--pad); top: 50%; transform: translateY(-50%); display: grid; justify-items: end; gap: 4px; font: 400 .72rem/1.2 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink); text-shadow: 0 0 2px rgba(0,0,0,.85), 0 1px 3px rgba(0,0,0,.7), 0 1px 12px rgba(0,0,0,.6); }
      .ruler { filter: drop-shadow(0 0 1px rgba(0,0,0,.9)) drop-shadow(0 1px 4px rgba(0,0,0,.6)); }
      .alt-value { font-size: .95rem; color: var(--ink); letter-spacing: .02em; font-variant-numeric: tabular-nums; }
      .ruler { position: relative; display: block; width: 1px; height: 38vh; margin-top: 10px; margin-right: 3px; background: repeating-linear-gradient(to bottom, var(--ink-faint) 0 1px, transparent 1px 12px); }
      .ruler::before { content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 7px; background: repeating-linear-gradient(to bottom, var(--ink-soft) 0 1px, transparent 1px 12px); }
      .ruler i { position: absolute; right: -2px; width: 17px; height: 2px; background: var(--accent); top: 0; transition: top .12s linear; }
      @media (max-width: 760px) { .altitude { display: none; } }
      @media (max-width: 1020px) { .wnav { display: none; } .wmenu-btn { display: block; } .top { align-items: center; padding-top: 12px; } }
      main { position: relative; z-index: 5; overflow-x: clip; }
      .beat { min-height: 120svh; display: grid; align-content: center; gap: 56px; padding: 18svh var(--pad); }
      .beat:first-child { min-height: 100svh; align-content: end; padding-bottom: 12svh; }
      .beat.last { min-height: 100svh; align-content: end; padding-bottom: 12svh; padding-top: 22svh; }
      .copy { max-width: 31rem; position: relative; }
      /* a soft pool of shade behind copy that sits over bright sky */
      .ground .copy::before, .sky .copy::before { content: ''; position: absolute; inset: -12% -18%; z-index: -1; pointer-events: none; background: radial-gradient(closest-side, var(--scrim, rgba(0,0,0,.3)), transparent); }
      .beat.wide .copy { max-width: 36rem; }
      h1, h2 { font-family: var(--display); font-weight: 400; margin: 0 0 .5em; line-height: 1.04; text-wrap: balance; }
      .copy p { margin: 0 0 1em; color: var(--ink); text-shadow: var(--tshadow); text-wrap: pretty; }
      .kicker { font: 400 .8rem/1.2 var(--mono) !important; letter-spacing: .1em; text-transform: uppercase; color: var(--accent) !important; margin-bottom: 1.2em !important; }
      .aside { font-size: .84em; color: var(--ink-faint) !important; }
      .figure-caption, figcaption { font: 400 .74rem/1.5 var(--mono); letter-spacing: .03em; color: var(--ink-soft); margin-top: 8px; max-width: 46em; text-shadow: 0 1px 10px rgba(10,5,4,.8); }
      .numbers { margin: 0 0 1.6em; display: grid; max-width: 29rem; }
      .numbers div { display: flex; align-items: baseline; gap: 8px; padding: .32em 0; }
      .numbers div::after { content: ''; order: 1; flex: 1; border-bottom: 1px dotted var(--ink-faint); transform: translateY(-.28em); }
      .numbers dt { order: 0; color: var(--ink-soft); }
      .numbers dd { order: 2; margin: 0; font: 400 .95rem var(--mono); font-variant-numeric: tabular-nums; }
      .onward { display: flex; justify-content: space-between; gap: 20px; max-width: 29rem; margin: 2.2em 0 2em; font: 400 1.15rem var(--display); }
      .onward a { color: var(--ink); text-underline-offset: 5px; }
      .onward a:hover { color: var(--accent); }
      a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
      @media (prefers-reduced-motion: reduce) { .ruler i, #arrive { transition: none; } }
    </style>
  </body>
</html>
