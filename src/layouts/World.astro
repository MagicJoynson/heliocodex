---
import Analytics from '../components/Analytics.astro';
import { groups } from '../lib/nav';
import SiteNav from '../components/SiteNav.astro';
import SiteSearch from '../components/SiteSearch.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThreeDReturn from '../components/ThreeDReturn.astro';
import { allLessons, STRAND_NAMES } from '../lib/v2/margin/content';
import { bodies } from '../data/bodies';
import { portraits } from '../lib/portraits';
import facts from '../data/facts.json';
import { moonCount, MOONS_AS_OF_TEXT } from '../data/moon-counts';
import { plates } from '../lib/v2/atlas/plates/index';
import { fmt, daysToYear, hoursToDay } from '../lib/format';
import { thumb as lessonThumb } from '../lib/learn/map';
/**
 * Shared bones of a "world" page: the fixed 3D canvas, the haze, the altitude ruler and the scroll
 * driver. Everything you see (type, colour, layout, copy) belongs to the page that uses it.
 */
interface Props { world: string; title: string; description: string; readout?: string; accent?: string }
const { world, title, description, readout = 'Altitude' } = Astro.props;
// lessons whose camera looks at this world, so the fall leads on into reading
const named = world === 'sun' ? /\bSun\b/ : world === 'earth' ? /\bEarth\b/ : new RegExp(`\\b${title}\\b`);
const all = await allLessons();
const aimed = all.filter((l) => (l.data as { view?: { target?: string } }).view?.target === world);
const lessons = [...aimed, ...all.filter((l) => !aimed.includes(l) && named.test(`${l.data.title} ${l.data.summary} ${(l.data as { scene?: string }).scene ?? ''}`))].slice(0, 6);
const about = lessons.filter((l) => aimed.includes(l));
const elsewhere = lessons.filter((l) => !aimed.includes(l));
if (!about.length && elsewhere.length) about.push(elsewhere.shift()!);
const leadPic = about[0] ? lessonThumb(about[0]) : null;
const who = world === 'sun' ? 'the Sun' : world === 'earth' ? 'the Earth' : title;
const face = portraits.find((p) => p.slug === world);
const order = bodies.map((b) => b.slug);
const i = order.indexOf(world);
const near = [order[i - 1], order[i + 1]].filter(Boolean).map((slug) => bodies.find((b) => b.slug === slug)!);
// the ending's reference block: the same few numbers and two small drawings for every world
const planet = (facts.planets as unknown as Record<string, { physical: Record<string, number>; elements: { a_au: number } }>)[world];
const EARTH_KM = 6371, SUN_KM = 695700;
const radius = world === 'sun' ? SUN_KM : planet.physical.radius_mean_km;
const LO = Math.log2(0.25), HI = Math.log2(40);
const along = (a: number) => (Math.log2(a) - LO) / (HI - LO);
const track = Object.entries(facts.planets as Record<string, { elements: { a_au: number } }>).map(([slug, f]) => ({ slug, x: along(f.elements.a_au), me: slug === world }));
const lightMin = world === 'sun' ? 0 : planet.elements.a_au * 8.317;
const lightSays = lightMin < 60 ? `${fmt(lightMin, 1)} minutes` : `${Math.floor(lightMin / 60)} h ${Math.round(lightMin % 60)} min`;
const n = moonCount(world);
const glance: [string, string][] = world === 'sun'
  ? [['Width', '1,392,700 km, 109 Earths'], ['Surface', 'about 5,500 °C'], ['Light to the Earth', '8 min 19 s'], ['Worlds going round it', '8 planets and countless smaller bodies']]
  : [
      ['From the Sun', `${fmt(planet.elements.a_au, 3)} au, ${lightSays} of light`],
      ['Width', `${fmt(radius * 2)} km, ${fmt(radius / EARTH_KM, 2)} × the Earth`],
      ['A year', daysToYear(planet.physical.orbit_period_days)],
      ['A day', hoursToDay(planet.physical.day_hours)],
      ['Gravity at the surface', `${fmt(planet.physical.gravity_ms2 / 9.81, 2)} × the Earth's`],
      ['Known moons', `${n === 0 ? 'none' : n}, as of ${MOONS_AS_OF_TEXT}`],
    ];
const moonChart = plates[world] && n > 0 ? `/atlas/${world}` : null;
// the two discs: this world and the Earth, at their true sizes against each other
const big = Math.max(radius, EARTH_KM);
const discMe = Math.max(3, Math.round((radius / big) * 150));
const discEarth = Math.max(2, Math.round((EARTH_KM / big) * 150));
const nameOf = (b: (typeof bodies)[number]) => (b.slug === 'sun' ? 'The Sun' : b.slug === 'earth' ? 'The Earth' : b.name);
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Heliocodex</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(`/${world}`, Astro.site).toString()} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#07080d" />
    <Analytics />
  </head>
  <body data-world={world}>
    <canvas id="journey" aria-hidden="true"></canvas>
    <div id="haze" aria-hidden="true"></div>
    <div id="shade" aria-hidden="true"></div>
    <div id="topfade" aria-hidden="true"></div>
    <div id="arrive" aria-hidden="true"></div>

    <header class="top">
      <a class="mark" href="/"><img src="/brand/heliocodex-lockup.svg" alt="Heliocodex" width="660" height="133" /></a>
      <SiteNav path={`/${world}`} />
      <SiteSearch />
      <button type="button" class="wmenu-btn" aria-expanded="false" aria-controls="wmenu">Menu</button>
    </header>
    <nav class="wmenu" id="wmenu" aria-label="Main" hidden>
      <a href="/">Home</a>
      {groups.map((g) => <><p class="wmenu-h">{g.name}</p>{g.sections.map((x) => <a href={x.href} data-outline={x.outline ? "" : undefined}>{x.label}</a>)}</>)}
    </nav>

    <aside class="altitude" aria-hidden="true">
      <span class="alt-label">{readout}</span>
      <span class="alt-value" id="alt"></span>
      <span class="ruler"><i id="tick"></i></span>
    </aside>

    <main><slot /></main>
    <section class="more" aria-labelledby="more-h">
      <div class="more-in">
        <h2 id="more-h">Keep exploring</h2>
        <div class="more-go">
          <a class="more-btn" href={`/explore?go=${world}`}>See {world === 'sun' ? 'the Sun' : world === 'earth' ? 'the Earth' : title} in 3D</a>
          {near.map((b) => <a class="more-link" href={`/${b.slug}`}>{order.indexOf(b.slug) < i ? '← ' : ''}{nameOf(b)}{order.indexOf(b.slug) > i ? ' →' : ''}</a>)}
          <a class="more-link" href="/worlds">The whole Solar System</a>
        </div>
        <div class="glance">
          <figure class="g-size">
            <div class="g-discs" aria-hidden="true">
              {face && <img class="g-me" src={face.src} alt="" style={`--px:${Math.round(discMe / face.disc)}px;--ar:${(face.width / face.height).toFixed(3)}`} loading="lazy" />}
              {world !== 'earth' && <span class="g-earth" style={`--px:${discEarth}px`}><img src={portraits.find((p) => p.slug === 'earth')!.src} alt="" loading="lazy" /></span>}
            </div>
            <figcaption>{world === 'earth' ? 'The Earth, 12,742 km across.' : `${title} and the Earth, to scale.`}</figcaption>
          </figure>
          {world !== 'sun' && (
            <figure class="g-where">
              <div class="g-track" aria-hidden="true">
                <span class="g-sun" />
                {track.map((t) => <i class:list={[{ me: t.me }]} style={`--x:${t.x}`} />)}
              </div>
              <figcaption>Its place among the eight planets. Each step out is twice as far from the Sun as the last.</figcaption>
            </figure>
          )}
        </div>
        <p class="more-go more-go2">
          {moonChart && <a class="more-link" href={moonChart}>Chart of its {n === 1 ? 'moon' : 'moons'}</a>}
          <a class="more-link" href="/worlds">Next to the other worlds</a>
          <a class="more-link" href="/sky">Find it in tonight's sky</a>
        </p>
        {about.length > 0 && (
          <div class="ml-about">
            <p class="more-h3">Lessons about {who}</p>
            <a class="ml-lead" href={`/learn/${about[0].id}`}>
              <span class="ml-pic">{leadPic && <img src={leadPic.src} class:list={[{ face: leadPic.face }]} alt="" loading="lazy" decoding="async" />}</span>
              <span class="ml-words"><span class="name">{about[0].data.title}</span><span class="line">{about[0].data.summary}</span><span class="ml-strand">{STRAND_NAMES[about[0].data.strand]}</span></span>
            </a>
            {about.length > 1 && (
              <ul class="ml-rest">
                {about.slice(1).map((l) => <li><a href={`/learn/${l.id}`}><span class="name">{l.data.title}</span><span class="line">{l.data.summary}</span></a></li>)}
              </ul>
            )}
          </div>
        )}
        {elsewhere.length > 0 && (
          <div class="ml-else">
            <p class="more-h3">Where {who} comes up elsewhere</p>
            <ul class="ml-mentions">
              {elsewhere.map((l) => <li><a href={`/learn/${l.id}`}><span class="ml-strand">{STRAND_NAMES[l.data.strand]}</span><span class="name">{l.data.title}</span></a></li>)}
            </ul>
          </div>
        )}
      </div>
    </section>
    <SiteFooter />
    <ThreeDReturn />
    <script>
      // the altitude ruler belongs to the fall; it steps aside once the page reaches its ending
      const ruler = document.querySelector<HTMLElement>('.altitude');
      const end = document.querySelector('.more');
      if (ruler && end && 'IntersectionObserver' in window) {
        new IntersectionObserver(([e]) => { ruler.style.opacity = e.isIntersecting ? '0' : ''; }).observe(end);
      }
    </script>

    <script>
      import { createJourney } from '../lib/journey/engine';
      import { worlds } from '../lib/journey/worlds';
      const wbtn = document.querySelector<HTMLButtonElement>('.wmenu-btn')!;
      const wmenu = document.getElementById('wmenu')!;
      const wset = (open: boolean) => { wmenu.hidden = !open; wbtn.setAttribute('aria-expanded', String(open)); };
      wbtn.addEventListener('click', () => wset(Boolean(wmenu.hidden)));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !wmenu.hidden) { wset(false); wbtn.focus(); } });
      document.addEventListener('click', (e) => { if (!wmenu.hidden && !wmenu.contains(e.target as Node) && e.target !== wbtn) wset(false); });
      const id = document.body.dataset.world!;
      const canvas = document.getElementById('journey') as HTMLCanvasElement;
      const journey = createJourney(canvas, document.getElementById('haze')!, worlds[id]);
      const alt = document.getElementById('alt')!;
      const tick = document.getElementById('tick')!;
      const altLabel = document.querySelector<HTMLElement>('.alt-label')!;

      // arriving from the solar system: start in the dark and let the planet come up
      const arrive = document.getElementById('arrive')!;
      if (location.search.includes('from=sys')) {
        arrive.style.opacity = '1';
        requestAnimationFrame(() => requestAnimationFrame(() => { arrive.style.opacity = '0'; }));
        history.replaceState(null, '', location.pathname);
      } else arrive.style.display = 'none';

      const beats = [...document.querySelectorAll<HTMLElement>('.beat')];
      const anchors = beats.map((b) => ({ el: b, p: Number(b.dataset.p) }));
      function progress() {
        const mid = scrollY + innerHeight / 2;
        const pts = anchors.map((a) => ({ y: a.el.offsetTop + a.el.offsetHeight / 2, p: a.p }));
        if (mid <= pts[0].y) return pts[0].p;
        for (let i = 1; i < pts.length; i++) {
          if (mid <= pts[i].y) {
            const t = (mid - pts[i - 1].y) / (pts[i].y - pts[i - 1].y);
            return pts[i - 1].p + t * (pts[i].p - pts[i - 1].p);
          }
        }
        return 1;
      }
      // copy fades out as it reaches the header, rather than sliding underneath it
      const fadeEls = [...document.querySelectorAll<HTMLElement>('main .copy > *, main figure, main .psheet h2, main .psheet .rc, main .psheet-src')];
      function fadeCopy() {
        const top = innerWidth < 760 ? 46 : 64;
        for (const el of fadeEls) {
          const r = el.getBoundingClientRect();
          const edge = r.top + Math.min(r.height * 0.5, 60);
          const o = Math.min(1, Math.max(0, (edge - top) / 80));
          el.style.opacity = o >= 0.999 ? '' : o.toFixed(3);
        }
      }
      let last = '';
      function update() {
        fadeCopy();
        const p = progress();
        journey.setProgress(p);
        tick.style.top = `${p * 100}%`;
        const txt = journey.readout();
        if (txt !== last) {
          alt.textContent = txt; last = txt;
          // above the clouds it is height; inside a gas giant it is pressure
          altLabel.textContent = /^[\d.]+ bar$/.test(txt) ? 'Pressure' : 'Altitude';
        }
      }
      addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);
      addEventListener('pointermove', (e) => journey.setPointer((e.clientX / innerWidth) * 2 - 1, (e.clientY / innerHeight) * 2 - 1));
      setInterval(update, 100);
      update();
    </script>

    <style is:global>
      /* the first screen: words that cross a bright planet keep a soft dark edge so they stay readable */
      .beat[data-p="0"] .copy .lead { text-shadow: 0 0 14px rgba(0,0,0,.85), 0 1px 3px rgba(0,0,0,.9); }
      .beat[data-p="0"] .copy .kicker { display: inline-block; width: max-content; padding: .35em .6em; margin-left: -.6em; border-radius: 3px; background: rgba(5,6,9,.66); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
      :root { --pad: clamp(20px, 6vw, 88px); }
      * { box-sizing: border-box; }
      html { background: var(--night); }
      body { margin: 0; color: var(--ink); font: 400 clamp(1.02rem, 0.96rem + 0.3vw, 1.2rem)/1.62 var(--text); -webkit-font-smoothing: antialiased; }
      #journey { position: fixed; inset: 0; width: 100%; height: 100%; display: block; z-index: 0; }
      #haze { position: fixed; inset: 0; z-index: 1; pointer-events: none; opacity: 0; }
      #shade { position: fixed; inset: 0; z-index: 2; pointer-events: none; background: var(--shade); }
      #topfade { position: fixed; z-index: 9; left: 0; right: 0; top: 0; height: 96px; pointer-events: none; background: linear-gradient(to bottom, var(--night-a), transparent); }
      #arrive { position: fixed; inset: 0; z-index: 50; background: #000; opacity: 0; pointer-events: none; transition: opacity 1.4s ease; }
      .top { position: fixed; z-index: 10; left: 0; right: 0; top: 0; display: flex; align-items: center; gap: 16px; height: 60px; padding: 0 var(--pad); }
      .top .nav-top { text-shadow: 0 1px 10px rgba(0,0,0,.7); }
      .top .find-q { background-color: rgba(0,0,0,.35); border-color: rgba(255,255,255,.22); }
      .top .find { --hd-h: 60px; }
      .top a { color: var(--ink); text-decoration: none; text-shadow: 0 1px 10px rgba(0,0,0,.55); }
      .wnav { display: flex; gap: clamp(12px, 1.6vw, 22px); }
      .wnav a { color: var(--ink-soft); }
      /* the opening words sit over the brightest view of the planet: a soft shade behind them keeps them readable */
      main > .beat:first-of-type { position: relative; isolation: isolate; }
      main > .beat:first-of-type::before { content: ''; position: absolute; z-index: -1; inset: -10vh -6vw -6vh -6vw; pointer-events: none;
        background: radial-gradient(ellipse 60% 70% at 18% 55%, rgba(0,0,0,.62), rgba(0,0,0,.35) 45%, transparent 75%); }
      main > .beat:first-of-type :is(h1, p) { text-shadow: 0 1px 3px rgba(0,0,0,.55), 0 2px 24px rgba(0,0,0,.55); }
      @media (max-width: 760px) { main > .beat:first-of-type::before { background: linear-gradient(to top, rgba(0,0,0,.72), rgba(0,0,0,.4) 55%, transparent 90%); } }
      .wgroup { display: flex; gap: clamp(12px, 1.6vw, 22px); }
      .wgroup + .wgroup { padding-left: clamp(12px, 1.6vw, 22px); border-left: 1px solid rgba(255,255,255,.22); }
      .wgroup[data-group='explore'] a { color: var(--ink); }
      .wmenu-h { font: 400 .64rem/1 var(--mono); letter-spacing: .14em; color: var(--ink-faint, #a8a296); margin: 12px 16px 2px; }
      .wnav a[aria-current] { color: var(--ink); }
      .wmenu-btn { display: none; font: 400 .74rem/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--ink); background: rgba(0,0,0,.35); border: 1px solid rgba(255,255,255,.25); border-radius: 999px; padding: 9px 14px; cursor: pointer; }
      .wmenu { position: fixed; z-index: 11; top: 58px; right: var(--pad); display: grid; min-width: 15rem; background: rgba(8,8,10,.96); border: 1px solid rgba(255,255,255,.16); padding: 6px 0; font: 400 1.02rem/1 var(--serif, 'Spectral', Georgia, serif); }
      .wmenu-h { text-transform: uppercase; }
      .wmenu[hidden] { display: none; }
      .top .mark img { display: block; height: 22px; width: auto; filter: drop-shadow(0 1px 8px rgba(0,0,0,.6)); }
      .more { position: relative; z-index: 5; background: #0b0b0c; color: #ece7dc; font-family: 'Spectral', Georgia, serif; border-top: 1px solid rgba(236,231,220,.12); }
      .more-in { max-width: 80rem; margin: 0 auto; padding: clamp(48px, 7vw, 88px) clamp(20px, 5vw, 64px); }
      .more h2::before, .more h2::after { display: none !important; }
      .more h2 { font: 300 clamp(1.8rem, 3vw, 2.6rem)/1.1 'Spectral', Georgia, serif; letter-spacing: -.015em; margin: 0 0 1.4rem; color: #ece7dc; }
      .more-go { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; font: 400 .76rem/1 'IBM Plex Mono', monospace; letter-spacing: .1em; text-transform: uppercase; }
      .more-btn { padding: 15px 22px; border-radius: 999px; background: #e9c48a; color: #160f05 !important; text-decoration: none; }
      .more-btn:hover { background: #f3d4a2; }
      .more-link { color: #ece7dc; text-decoration: none; border-bottom: 1px solid rgba(233,196,138,.5); padding-bottom: 3px; }
      .more-link:hover { color: #e9c48a; }
      .more-h3 { font: 400 .72rem/1.4 'IBM Plex Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: #a8a296; margin: 3rem 0 1.2rem; }
      .glance { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1fr) minmax(0, 1.2fr); gap: 2rem 3rem; align-items: end; margin: 3rem 0 0; padding: 2.2rem 0 0; border-top: 1px solid rgba(236,231,220,.12); }
      .glance figure { margin: 0; }
      .glance figcaption { font: 300 .92rem/1.45 'Spectral', Georgia, serif; color: #a8a296; margin-top: .9rem; }
      .g-discs { display: flex; align-items: flex-end; gap: 14px; min-height: 150px; }
      .g-me { width: calc(var(--px) * var(--ar, 1)); height: var(--px); max-width: min(100%, calc(var(--px) * var(--ar, 1))); object-fit: contain; mix-blend-mode: lighten; }
      .g-earth { display: block; width: var(--px); height: var(--px); border-radius: 50%; overflow: hidden; flex: none; }
      .g-earth img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.09); }
      .g-track { position: relative; height: 40px; border-bottom: 1px solid rgba(236,231,220,.18); margin: 0 6px 0 18px; }
      .g-sun { position: absolute; left: -18px; bottom: -9px; width: 18px; height: 18px; border-radius: 50%; background: radial-gradient(circle, #ffd27a, #f39a2e 70%); }
      .g-track i { position: absolute; left: calc(var(--x) * 100%); bottom: -4px; width: 7px; height: 7px; margin-left: -3.5px; border-radius: 50%; background: rgba(236,231,220,.35); }
      .g-track i.me { width: 13px; height: 13px; margin-left: -6.5px; bottom: -7px; background: #e9c48a; box-shadow: 0 0 12px rgba(233,196,138,.6); }
      .g-facts { margin: 0; display: grid; gap: 0; }
      .g-facts div { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 1rem; padding: .5rem 0; border-top: 1px solid rgba(236,231,220,.08); }
      .g-facts dt { font: 400 .7rem/1.6 'IBM Plex Mono', monospace; letter-spacing: .08em; text-transform: uppercase; color: #a8a296; }
      .g-facts dd { margin: 0; font: 300 1rem/1.45 'Spectral', Georgia, serif; color: #ece7dc; }
      .more-go2 { margin: 2rem 0 0; }
      /* lessons: the one that looks at this world, large, the rest of its own beside it, then the places it comes up elsewhere */
      .ml-about { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 0 3rem; align-items: start; }
      .ml-about .more-h3 { grid-column: 1 / -1; }
      .ml-lead { display: grid; gap: 1rem; text-decoration: none; color: #ece7dc; }
      .ml-lead .ml-pic { aspect-ratio: 16 / 10; }
      .ml-about:not(:has(.ml-rest)) .ml-lead { grid-column: 1 / -1; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 3rem; align-items: center; }
      @media (max-width: 700px) { .ml-about:not(:has(.ml-rest)) .ml-lead { grid-template-columns: minmax(0, 1fr); gap: 1rem; } }
      .ml-lead .name { font: 400 1.6rem/1.2 'Spectral', Georgia, serif; }
      .ml-words { display: grid; gap: .4rem; }
      .ml-lead .line, .ml-rest .line { font: 300 1rem/1.5 'Spectral', Georgia, serif; color: #a9a396; }
      .ml-strand { font: 400 .66rem/1.4 'IBM Plex Mono', monospace; letter-spacing: .1em; text-transform: uppercase; color: #a8a296; }
      .ml-rest { list-style: none; margin: 0; padding: 0; }
      .ml-rest a { display: grid; gap: .3rem; padding: 1rem 0 1.1rem; border-bottom: 1px solid rgba(236,231,220,.1); text-decoration: none; color: #ece7dc; }
      .ml-rest li:first-child a { padding-top: 0; }
      .ml-rest .name { font: 400 1.2rem/1.25 'Spectral', Georgia, serif; }
      .ml-lead:hover .name, .ml-rest a:hover .name, .ml-mentions a:hover .name { color: #e9c48a; }
      .ml-else { margin-top: 2.6rem; }
      .ml-mentions { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .9rem 2.4rem; }
      .ml-mentions a { display: grid; gap: .15rem; text-decoration: none; color: #ece7dc; }
      .ml-mentions .name { font: 400 1.1rem/1.3 'Spectral', Georgia, serif; }
      .ml-pic { position: relative; display: block; overflow: hidden; border-radius: 3px; background: #000; }
      .ml-pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .ml-pic img.face { object-fit: contain; transform: scale(.85); }
      @media (max-width: 1000px) { .glance { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .g-facts { grid-column: 1 / -1; } }
      @media (max-width: 700px) {
        .glance { grid-template-columns: minmax(0, 1fr); }
        .g-facts div { grid-template-columns: 8.5rem minmax(0, 1fr); }
        .ml-about { grid-template-columns: minmax(0, 1fr); }
