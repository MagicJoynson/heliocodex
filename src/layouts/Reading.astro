---
import Base from './Base.astro';
import '../styles/reading.css';
import VideoEmbeds from '../components/VideoEmbeds.astro';
interface Props { title: string; description: string; path: string }
const { title, description, path } = Astro.props;
---
<Base title={title} description={description} path={path}>
  <article class="reading">
    <slot />
  </article>
  <VideoEmbeds />
</Base>
