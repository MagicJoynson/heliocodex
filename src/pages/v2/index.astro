---
// The 3D view now lives at /explore. Old links (/v2?go=…) still work: this forwards them, keeping the query.
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Heliocodex</title>
    <link rel="canonical" href={new URL('/explore', Astro.site).toString()} />
    <meta http-equiv="refresh" content="0; url=/explore" />
    <script is:inline>location.replace('/explore' + location.search + location.hash);</script>
  </head>
  <body>
    <p>The 3D view is now at <a href="/explore">/explore</a>.</p>
  </body>
</html>
