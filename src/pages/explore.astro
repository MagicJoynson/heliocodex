      const PLANET_LABEL: Record<string, string> = { sun: 'The Sun', mercury: 'Mercury', venus: 'Venus', earth: 'Earth', mars: 'Mars', jupiter: 'Jupiter', saturn: 'Saturn', uranus: 'Uranus', neptune: 'Neptune' };
      let stepIn: [string, string] | null = null, stepOut: [string, string] | null = null;
