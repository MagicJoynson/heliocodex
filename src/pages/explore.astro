        return out;
      }
      stepInB.addEventListener('click', () => { if (stepIn) goTo(stepIn[0]); });
      stepOutB.addEventListener('click', () => { if (stepOut) goTo(stepOut[0]); });
      const phone = matchMedia('(max-width: 600px)');
      // on a phone the innermost ring stands well off the Sun, so that the Sun and the first stops are each a thumb apart
      const ringRadius = (k: number, R: number) => phone.matches ? R * (0.32 + 0.68 * k) : R * (0.08 + 0.92 * k);
      function drawLadder(c: number, R: number, dpr: number, cam: number[], distAu: number) {
        hits = [{ id: 'sun', x: c / dpr, y: c / dpr }];
        const here = rungR(distAu);
        mctx.lineWidth = 1 * dpr;
