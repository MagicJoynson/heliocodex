      });

      // ---- the map: the Solar System from above, on a stretched scale so Mercury and Neptune both fit
      const map = $('map') as HTMLCanvasElement;
      const mctx = map.getContext('2d')!;
      const COL: Record<string, string> = { mercury: '#a8a29a', venus: '#e6cf9c', earth: '#7aa9da', mars: '#d4714a', jupiter: '#d9b48c', saturn: '#e2cf98', uranus: '#9fd5db', neptune: '#7190e2' };
      const EDGE = 34; // au at the rim
      const rr = (au: number) => Math.log10(1 + au / 0.22) / Math.log10(1 + EDGE / 0.22);
      let hits: { id: string; x: number; y: number }[] = [];
      // beyond Neptune the map changes with the scale: rings for each stop out to the oldest light, on a scale where every step is a thousand times further
      const RUNGS: [string, string, number][] = [
        ['solar-system', 'The whole Solar System', EDGE], ['oort-cloud', 'The Oort cloud', 1e5], ['neighbourhood', 'Our neighbour stars', 30 * 63_241],
        ['pleiades', 'The Pleiades', 444 * 63_241], ['orion-nebula', 'The Orion Nebula', 1266 * 63_241], ['night-sky', 'Every star you can see', 1500 * 63_241], ['milky-way', 'The Milky Way', 150_000 * 63_241], ['local-group', 'The Local Group', 3e6 * 63_241],
        ['cosmic-web', 'The cosmic web', 1e9 * 63_241], ['cmb', 'The oldest light', 46e9 * 63_241],
