      .eta button { pointer-events: auto; margin-top: 18px; padding: 14px 22px; min-height: 48px; font: 400 .8125rem/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--ink); background: var(--glass); border: 1px solid var(--line); border-radius: 999px; cursor: pointer; }
