---
import Analytics from '../components/Analytics.astro';
import '@fontsource/spectral/300.css';
import '@fontsource/spectral/300-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import Margin from '../components/v2/Margin.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteSearch from '../components/SiteSearch.astro';
const site = Astro.site!;
const title = 'Explore in 3D · Heliocodex';
const description = 'Fly through the Solar System at its true size, from beyond Neptune to the ground of Mars, then out past the stars to the oldest light.';
import { sections } from '../lib/nav';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL('/explore', site).toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL('/explore', site).toString()} />
    <meta property="og:site_name" content="Heliocodex" />
    <meta property="og:image" content={new URL('/brand/heliocodex-social-card-1200x630.png', site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Heliocodex: an amber Sun with a small dark world crossing it" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <Analytics />
    <script is:inline>
      // coming in from another page of the site, with ?enter=1, or having been in before: no second "Enter" to press
      (function () {
        try {
          var q = new URLSearchParams(location.search), quick = q.has('enter') || q.has('go') || q.has('tour');
          if (!quick && document.referrer) { var r = new URL(document.referrer); quick = r.origin === location.origin && r.pathname.indexOf('/explore') !== 0; }
          if (!quick) quick = JSON.parse(localStorage.getItem('heliocodex-view') || '{}').entered === true;
          if (quick) document.documentElement.classList.add('quick');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skiplink" href="#main">Skip to what you are looking at</a>
    <div class="veil" id="veil" aria-hidden="true"></div>

    <header class="top">
      <a class="mark" href="/" aria-label="Heliocodex, home"><img src="/brand/heliocodex-lockup.svg" alt="" width="660" height="133" /></a>
      <SiteNav path="/explore" />
      <SiteSearch />
      <button type="button" class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu">Menu</button>
    </header>
    <nav class="menu" id="menu" aria-label="Main, small screens" hidden>
      <a href="/"><b>Home</b><span>Where to start</span></a>
      {sections.filter((x) => x.href !== '/explore').map((x) => <a href={x.href}><b>{x.label}</b><span>{x.about}</span></a>)}
      <a href="/sources"><b>Sources</b><span>Where every number comes from</span></a>
    </nav>

    <main id="main" tabindex="-1">
    <canvas id="space" tabindex="-1" aria-label="The Solar System at its true size and distance. The whole journey is also available as a list at Travel the universe in a list, and the controls work from the keyboard."></canvas>

    <section class="threshold" id="threshold">
      <p class="name">Heliocodex</p>
      <p class="line">The Sun and its worlds at their true size and distance. Start from the whole Solar System, click any planet or moon to visit it, then keep going, past the stars, out to the oldest light there is.</p>
      <button class="aperture" id="enter" type="button" aria-label="Enter">
        <svg viewBox="0 0 200 200" aria-hidden="true">
          <circle class="ring outer" cx="100" cy="100" r="96" />
          <circle class="ring inner" cx="100" cy="100" r="78" />
          <g class="ticks"></g>
        </svg>
        <span class="word">Enter</span>
      </button>
      <p class="note alt"><a href="/explore/list">Prefer text? Travel the universe as a list</a></p>
      <p class="note" id="status">Loading the Solar System…</p>
      <div class="nope" id="nope" hidden>
        <p>This browser cannot draw the 3D view, but the rest of Heliocodex works without it. <a href="/explore/list">The whole journey is also here as a plain list.</a></p>
        <p class="links"><a href="/learn">Learn</a><a href="/worlds">The Solar System</a><a href="/sky">Tonight’s sky</a><a href="/atlas">Atlas</a></p>
      </div>
      <noscript><p class="nope-ns">The 3D view needs JavaScript. <a href="/explore/list">The whole journey is available as a plain list</a>. Everything else is on the <a href="/learn">Learn</a>, <a href="/worlds">Solar System</a>, <a href="/sky">Sky</a> and <a href="/atlas">Atlas</a> pages.</p></noscript>
    </section>

    <!-- Back: the place you were at before (the only part of the old place panel that is kept) -->
    <button type="button" class="back-chip" id="step-back" disabled title="Back to the place you were at before (B)" inert><span aria-hidden="true">←</span> <span id="back-name">Back</span></button>

    <div class="hud" id="hud">
      <div class="hud-l">
        <div class="readout" aria-hidden="true">
          <span class="k" id="r-k">Height above Mars</span>
          <span class="v" id="r-v">—</span>
          <span class="k2" id="r-k2"></span>
        </div>
        <!-- speed: a small pill beside the readout; the full throttle opens only while you change gear -->
        <div class="gears" id="gears" hidden>
          <button type="button" class="gear-pill" id="gear-pill" aria-expanded="false" aria-controls="gear-panel"><span class="gp-k">Speed</span><span class="gp-v" id="gear-name">Local</span></button>
          <div class="gear-panel throttle" id="gear-panel" role="group" aria-label="Throttle" hidden>
            <div class="tl" aria-hidden="true"><span>Local</span><span id="gear-name-big"></span><span>Warp 5</span></div>
            <input type="range" id="throttle" min="0" max="8" step="1" value="0" aria-label="Throttle" />
            <p class="th" aria-hidden="true"><span class="fine-only">Scroll one notch, one gear · hold W to go · speed eases off near a world</span><span class="coarse-only">Slide to go faster · it eases off near a world</span></p>
          </div>
        </div>
      </div>
      <button type="button" class="skip" id="skip">Skip ahead</button>
    </div>

    <!-- the controls: always in the same place, all reachable by keyboard -->
    <div class="controls" id="controls" inert role="toolbar" aria-label="3D view controls">
      <button type="button" class="pill" id="tour-btn" aria-controls="tour" aria-expanded="false">Tour</button>
      <div class="pop" id="goto">
        <button type="button" class="pill" id="goto-btn" aria-expanded="false" aria-controls="goto-list">Go to</button>
        <nav class="sheet goto-list" id="goto-list" aria-label="Go to" hidden></nav>
      </div>
      <div class="pop" id="time">
        <button type="button" class="pill" id="time-btn" aria-expanded="false" aria-controls="time-sheet">Time</button>
        <div class="sheet time-sheet" id="time-sheet" role="group" aria-label="Time" hidden>
          <p class="time-now" id="time-now"></p>
          <div class="time-f"><label for="time-date">Go to a date</label><input type="date" id="time-date" min="1800-01-01" max="2199-12-31" /></div>
          <div class="time-f"><label for="time-slide">Scrub, 1950 to 2050</label><input type="range" id="time-slide" min="0" max="36889" step="1" /></div>
          <fieldset>
            <legend>Clock speed</legend>
            <label><input type="radio" name="speed" value="0" /> Paused</label>
            <label><input type="radio" name="speed" value="1" checked /> Normal speed</label>
            <label><input type="radio" name="speed" value="86400" /> A day a second</label>
            <label><input type="radio" name="speed" value="604800" /> A week a second</label>
            <label><input type="radio" name="speed" value="2629800" /> A month a second</label>
            <label><input type="radio" name="speed" value="31557600" /> A year a second</label>
            <label class="time-back"><input type="checkbox" id="time-rev" /> Run backwards</label>
          </fieldset>
          <button type="button" class="free-btn" id="time-reset">Back to now</button>
          <p class="time-note">The planets are placed from NASA and JPL orbit fits for 1800 to 2050, and the moons for 2000 to 2040. Outside those years positions are approximate.</p>
        </div>
      </div>
      <div class="pop" id="view">
        <button type="button" class="pill icon" id="view-btn" aria-expanded="false" aria-controls="view-sheet" aria-label="Settings" title="Settings"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h10M17 7h4M3 17h4M11 17h10" /><circle cx="15" cy="7" r="2.2" /><circle cx="9" cy="17" r="2.2" /></svg><span class="lbl">Settings</span></button>
        <div class="sheet view-sheet" id="view-sheet" role="group" aria-label="View settings" hidden>
          <fieldset>
            <legend>Planet sizes</legend>
            <label><input type="radio" name="size" value="true" checked /> True size <small>tiny dots from far away, as they really are</small></label>
            <label><input type="radio" name="size" value="big" /> Easier to see <small>drawn bigger from far off, true size up close</small></label>
          </fieldset>
          <fieldset>
            <legend>Motion</legend>
            <label><input type="radio" name="motion" value="full" checked /> Smooth trips <small>a short glide from place to place</small></label>
            <label><input type="radio" name="motion" value="reduced" /> Reduced motion <small>a quick fade instead of moving</small></label>
            <div class="look-f"><label for="look-sens">Look sensitivity</label><input type="range" id="look-sens" min="0.25" max="3" step="0.05" value="1" aria-describedby="look-sens-v" /><output id="look-sens-v" for="look-sens">1×</output></div>
            <label><input type="checkbox" id="speed-lines" /> Speed lines on fast trips <small>thin streaks from the middle of the screen. Off, you get only a soft darkening at the edges</small></label>
          </fieldset>
          <fieldset>
            <legend>Picture quality</legend>
            <label><input type="radio" name="quality" value="auto" checked /> Automatic <small>sharp as your device can manage while keeping smooth</small></label>
            <label><input type="radio" name="quality" value="smooth" /> Smoother <small>a softer picture, for a slow device or a battery</small></label>
            <label><input type="radio" name="quality" value="sharp" /> Sharper <small>keeps the picture crisp, and may stutter on a slow device</small></label>
          </fieldset>
          <fieldset>
            <legend>Moons</legend>
            <label><input type="checkbox" id="moon-orbits" /> Show moon orbit lines <small>the paths moons follow round the planet you are near</small></label>
          </fieldset>
          <fieldset>
            <legend>On screen</legend>
            <label><input type="checkbox" id="centre-mark" checked /> Centre mark <small>a faint ring in the middle of the view while you fly, to keep your bearings</small></label>
            <button type="button" class="free-btn" id="hide-ui-btn">Hide the controls <span class="kbd">H</span></button>
            <button type="button" class="free-btn" id="help-open-2">Keys and help <span class="kbd">?</span></button>
          </fieldset>
        </div>
      </div>
      <button type="button" class="pill icon" id="help-btn" aria-haspopup="dialog" aria-label="Keys and help" title="Keys and help (?)"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.2" /><path d="M9.6 9.4a2.5 2.5 0 1 1 3.6 2.2c-.8.5-1.2 1-1.2 2" /><circle class="dot" cx="12" cy="16.9" r=".6" /></svg><span class="lbl">Help</span></button>
    </div>

    <!-- keys and help: its own full-screen page, opened by ? or the Help button -->
    <div class="help" id="help" role="dialog" aria-modal="true" aria-labelledby="help-h" hidden>
      <div class="help-in">
        <button type="button" class="help-x" id="help-x">Close <span class="kbd">Esc</span></button>
        <h2 id="help-h">Keys and help</h2>
        <p class="help-lead fine-only">You steer like a small ship. Drag to look, W A S D to move, scroll to change gear.</p>
        <p class="help-lead coarse-only">You steer like a small ship. Drag to look, press the pad to move, slide the throttle for speed.</p>
        <div class="help-grid">
          <section>
            <h3>Look and move</h3>
            <dl>
              <div><dt>Look round</dt><dd>drag, or the left and right arrow keys</dd></div>
              <div><dt>Move</dt><dd>W or the up arrow ahead, S or the down arrow astern, A and D sideways, E up, Q down</dd></div>
              <div><dt>Brake</dt><dd>X stops you at once. Speed always eases off near a world</dd></div>
            </dl>
          </section>
          <section>
            <h3>Speed</h3>
            <dl>
              <div><dt>Change gear</dt><dd>scroll (one gear a notch), the throttle, or . faster and , slower</dd></div>
              <div><dt>Quicker</dt><dd>hold Shift</dd></div>
              <div><dt>Gears</dt><dd>Local, Quick, Fast, Faster, then Warp 1 to 5. Warp gears coast when you let go</dd></div>
            </dl>
          </section>
          <section>
            <h3>Places</h3>
            <dl>
              <div><dt>Go to a world</dt><dd>click or tap it or its name, or [ and ] for the next planet</dd></div>
              <div><dt>Circle a world</dt><dd>Esc eases a trip to a stop. In free flight it stops you, and unless you are close to the ground it then circles the nearest world. F sets you flying free again</dd></div>
              <div><dt>Back</dt><dd>B goes back to the last place</dd></div>
            </dl>
          </section>
          <section>
            <h3>The screen</h3>
            <dl>
              <div><dt>Hide the controls</dt><dd>H hides everything but the view, and brings it back</dd></div>
              <div><dt>The Codex</dt><dd>M opens the notes on where you are</dd></div>
              <div><dt>Help</dt><dd>? opens this page</dd></div>
              <div class="pad-only"><dt>Game controller</dt><dd>sticks to move and look, triggers up and down, bumpers for speed, Y to circle or fly</dd></div>
            </dl>
          </section>
        </div>
      </div>
    </div>
    <button type="button" class="ui-show" id="ui-show" hidden aria-label="Show the controls">Show controls <span class="kbd">H</span></button>
    <div class="centre" id="centre" aria-hidden="true"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="11" /><path d="M20 2v6M20 32v6M2 20h6M32 20h6" /></svg></div>

    <nav class="scale" id="scale" aria-label="Where you are, from the Sun out to the whole universe. Choose a stop to fly there." inert>
      <div class="scale-line"><i class="scale-you" id="scale-you"></i></div>
      <ol>
        <li><button type="button" data-go="sun">The Sun</button></li>
        <li><button type="button" data-go="solar-system">Planets</button></li>
        <li><button type="button" data-go="neighbourhood">Stars</button></li>
        <li><button type="button" data-go="milky-way">Galaxy</button></li>
        <li><button type="button" data-go="cosmic-web">Universe</button></li>
      </ol>
    </nav>
    <div class="vignette" id="vignette" aria-hidden="true"></div>
    <canvas class="streaks" id="streaks" aria-hidden="true"></canvas>
    <div class="eta" id="eta" hidden aria-hidden="true"><b id="eta-n"></b><span id="eta-d"></span><div class="eta-bar"><i id="eta-f"></i></div><button type="button" id="eta-stop">Stop here</button></div>
    <div class="coach" id="coach" hidden role="note">
      <p><b>1</b><span class="fine-only">Drag to look around</span><span class="coarse-only">Drag to look around</span></p>
      <p><b>2</b><span class="fine-only">Click a world to fly there</span><span class="coarse-only">Tap a world to fly there</span></p>
      <p><b>3</b><span class="fine-only">Scroll: one notch, one gear. Or hold W</span><span class="coarse-only">Slide the throttle for speed</span></p>
      <button type="button" id="coach-ok">Got it</button>
    </div>
    <div class="aim" id="aim" hidden aria-hidden="true"><b id="aim-n"></b><span id="aim-d"></span><i>Click to fly there</i><button type="button" class="aim-go" id="aim-go">Fly here</button></div>
    <p class="hint" id="hint" aria-hidden="true"><span class="fine-only">Drag to look round · Scroll one notch, one gear · Click a world to go there</span><span class="coarse-only">Drag to look round · Slide the throttle for speed · Tap a world to go there</span></p>
    <section class="tour" id="tour" aria-label="Guided tour" hidden>
      <p class="tour-k" id="tour-k">Stop 1 of 10</p>
      <h2 class="tour-h" id="tour-h">Home</h2>
      <p class="tour-p" id="tour-p"></p>
      <div class="tour-b">
        <button type="button" id="tour-back">Back</button>
        <button type="button" id="tour-next" class="tour-go">Next</button>
        <button type="button" id="tour-stop">Stop the tour</button>
      </div>
    </section>
    <p class="sr" id="said" role="status" aria-live="polite"></p>

    <div class="pad" id="pad" aria-hidden="true"><span>Ahead</span><i></i><span>Astern</span></div>
    <p class="tech" id="tech"></p>
    <p class="gen" id="gen"></p>
    <Margin />
    </main>

    <script>
      import { createWorld } from '../lib/v2/engine/world';
      import { GEARS } from '../lib/v2/engine/flight';
      const $ = (id: string) => document.getElementById(id)!;
      const body = document.body;

      const ticks = document.querySelector('.ticks')!;
      for (let i = 0; i < 120; i++) {
        const a = (i / 120) * Math.PI * 2, long = i % 10 === 0;
        const r1 = 86, r2 = long ? 92 : 89;
        const l = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        l.setAttribute('x1', String(100 + Math.cos(a) * r1)); l.setAttribute('y1', String(100 + Math.sin(a) * r1));
        l.setAttribute('x2', String(100 + Math.cos(a) * r2)); l.setAttribute('y2', String(100 + Math.sin(a) * r2));
        ticks.appendChild(l);
      }

      // ---- the menu, for narrow screens; works before the 3D view has loaded
      const menu = $('menu'), menuBtn = $('menu-btn');
      const shutMenu = () => { menu.hidden = true; menuBtn.setAttribute('aria-expanded', 'false'); };
      menuBtn.addEventListener('click', () => { const open = menu.hidden; menu.hidden = !open; menuBtn.setAttribute('aria-expanded', String(open)); if (open) (menu.querySelector('a') as HTMLElement).focus(); });
      addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { shutMenu(); menuBtn.focus(); } });
      addEventListener('pointerdown', (e) => { if (!menu.hidden && !menu.contains(e.target as Node) && e.target !== menuBtn) shutMenu(); });

      // ---- settings, kept in this browser only (see the cookies page)
      const KEY = 'heliocodex-view';
      type Prefs = { big?: boolean; reduced?: boolean; quality?: 'auto' | 'smooth' | 'sharp'; marks?: [string, string][]; coached?: boolean; moonOrbits?: boolean; look?: number; streaks?: boolean; entered?: boolean; centre?: boolean };
      let prefs: Prefs = {};
      try { prefs = JSON.parse(localStorage.getItem(KEY) ?? '{}') ?? {}; } catch {}
      const save = () => { try { localStorage.setItem(KEY, JSON.stringify(prefs)); } catch {} };
      const systemReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reducedNow = () => prefs.reduced ?? systemReduced;

      const AU = 149_597_870_700;
      const LY = 9.4607304725808e15;
      const fmt = (m: number) => {
        if (m >= 0.995e9 * LY) return `${(m / LY / 1e9).toLocaleString('en-GB', { maximumFractionDigits: 1 })} billion light years`;
        if (m > 1e6 * LY) return `${(m / LY / 1e6).toLocaleString('en-GB', { maximumFractionDigits: 1 })} million light years`;
        if (m > 0.05 * LY) return `${(m / LY).toLocaleString('en-GB', { maximumFractionDigits: m > 100 * LY ? 0 : 2 })} light years`;
        if (m > 0.1 * AU) return `${(m / AU).toFixed(m > 10 * AU ? 1 : 2)} au`;
        if (m > 1e9) return `${(m / 1e9).toFixed(1)} million km`;
        if (m > 10_000) return `${Math.round(m / 1000).toLocaleString('en-GB')} km`;
        if (m > 1000) return `${(m / 1000).toFixed(2)} km`;
        return `${Math.max(0, Math.round(m)).toLocaleString('en-GB')} m`;
      };
      // a speed in the unit that fits the scale: m/s, km/s, au/s, light years a second, or a multiple of light speed in between
      const fmtSpeed = (v: number) => {
        if (v < 0.5) return 'Still';
        if (v >= 0.05 * LY) return `${(v / LY).toLocaleString('en-GB', { maximumFractionDigits: v / LY >= 100 ? 0 : v / LY >= 1 ? 1 : 2 })} ly/s`;
        if (v >= 3e10) return `${(v / AU).toLocaleString('en-GB', { maximumFractionDigits: v / AU >= 10 ? 0 : 1 })} au/s`;
        if (v > 3e9) return `${(v / 299_792_458).toLocaleString('en-GB', { maximumFractionDigits: 0 })} × light speed`;
        if (v >= 1000) return `${Math.round(v / 1000).toLocaleString('en-GB')} km/s`;
        return `${Math.round(v)} m/s`;
      };
      // a catalogue star the camera has flown to is shown at the distance its page gives (Gaia for Proxima Centauri),
      // not at where the camera stopped, which is a little short of it
      let focusId = '';
      let starLy: Record<string, number | undefined> = {};
      fetch('/v2/margin.json').then((r) => r.json()).then((j: { stars?: Record<string, [string, string, number?]> }) => { for (const [i, v] of Object.entries(j.stars ?? {})) starLy[`star:${i}`] = v[2]; }).catch(() => {});
      /** metres from the Sun as shown: snapped to the cited figure when beside the star in focus */
      const shown = (m: number) => { const c = starLy[focusId]; return c !== undefined && Math.abs(m / LY - c) < 0.06 ? c * LY : m; };
      const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);

      const params = new URLSearchParams(location.search);
      const linkedTo = params.has('go'); // a link that names a place goes in without the click
      // coming back to the 3D view in the same tab, with nowhere asked for: carry on from where you were
      if (!params.has('go') && !params.has('tour')) { try { const at = sessionStorage.getItem('hc-at'); if (at) params.set('go', at); } catch {} }
      // coming from the lesson on how big space is: show distances again on its scale, the Sun as a football 22 cm across
      let football = false;
      // the one Back control. With places behind you it goes to the last place. With none, and a page of the site you
      // came in from, it leaves the 3D view for that page, and says so ("Home", "Back to Mars").
      type Origin = { href: string; name: string; from: Record<string, unknown>; label?: string };
      let origin = null as Origin | null;
      try {
        const from = JSON.parse(sessionStorage.getItem('hc-from') ?? 'null');
        if (from?.href && from.href !== '/explore') {
          football = String(from.href).split('?')[0].replace(/\/$/, '') === '/learn/how-big-is-space';
          // short enough to read at any width: "Home" or "Back"; the full name is in the tooltip
          const short = String(from.name || '').split(/[:·|,–—]/)[0].trim().slice(0, 40);
          origin = { href: String(from.href), name: String(from.href).split('?')[0] === '/' ? 'Home' : 'Back', from, label: short } as Origin;
        }
      } catch {}
      const GEAR_NAMES = ['Local', 'Quick', 'Fast', 'Faster', 'Warp 1', 'Warp 2', 'Warp 3', 'Warp 4', 'Warp 5'];
      const gearName = (g: number) => GEAR_NAMES[g] ?? 'Local';
      // the places you have been, for Back
      const trail: [string, string][] = [];
      // speed: the pill always shows the gear; the full throttle opens when you press the pill or change gear, then tucks away
