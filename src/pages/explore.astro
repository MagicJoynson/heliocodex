      body.touring .eta { opacity: 0; pointer-events: none; }
      .coach { position: fixed; z-index: 17; left: 50%; bottom: calc(var(--bot) + 132px); transform: translateX(-50%); display: flex; align-items: center; gap: 18px; padding: 14px 20px; max-width: calc(100vw - 32px); background: var(--glass); border: 1px solid var(--line); border-radius: 14px; }
      .coach[hidden] { display: none; }
      .coach p { margin: 0; display: flex; align-items: center; gap: 9px; font: 300 1.0625rem/1.3 var(--serif); color: var(--ink); }
      .coach b { flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--warm); color: #111; font: 600 .8125rem/24px var(--mono); text-align: center; }
      .coach button { flex: none; background: none; border: 0; color: var(--warm); font: 400 .8125rem/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; padding: 14px 6px; min-height: 44px; cursor: pointer; }
      @media (max-width: 600px) { .coach { flex-direction: column; align-items: flex-start; gap: 8px; bottom: calc(var(--dock) + 112px); padding: 14px 18px; } .coach button { align-self: flex-end; padding: 4px 6px; } }
      .deep-labels { clip-path: inset(calc(var(--top) + 100px) 52px 0 0); }
      .aim .aim-go { display: none; }
      @media (pointer: coarse) { .aim { z-index: 30; background: rgba(9,9,11,.94); left: 0; right: 0; bottom: calc(var(--dock, 0px) + 8px); top: auto; width: auto; margin: 0 var(--gut); pointer-events: auto; transform: none !important; padding: 16px 18px; } .aim i { display: none; } .aim .aim-go { display: block; margin-top: 12px; padding: 16px; min-height: 52px; border: 0; border-radius: 999px; background: var(--warm); color: #111; font: 600 .875rem/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; cursor: pointer; } }
      .gear-name { margin: 0; min-width: 9.5rem; text-align: center; font: 400 .8125rem/1.25 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--soft); }
      .pill[aria-pressed="true"], .pill[aria-pressed="true"]:hover, .pill[aria-pressed="true"]:focus-visible { color: #111; background: var(--warm); border-color: var(--warm); }
      .goto-marks { margin-bottom: 4px; }
      .goto-row.marks { grid-template-columns: 1fr; margin-bottom: 8px; }
      .mark { display: flex; border-bottom: 1px solid rgba(236,231,220,.08); }
      .mark button:first-child { flex: 1; border-bottom: 0; }
      .mark .rm { width: 44px; text-align: center; color: var(--faint); font-size: 1.2rem; border-bottom: 0; }
      .save-place { font: 400 .8125rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--warm); border: 1px solid var(--line); border-radius: 999px; padding: 12px 16px; min-height: 44px; margin: 0 0 14px; }
      .save-place[hidden] { display: none; }

      /* ---- readout */
      .hud { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; padding: 0 var(--gut) var(--bot); display: flex; justify-content: space-between; align-items: end; opacity: 0; transition: opacity 1s ease .8s; pointer-events: none; }
      body.in .hud { opacity: 1; }
      /* a near-solid dark backing, so the figures stay readable over bright ground (the Sun, Saturn's tan cloud tops close up) */
      .readout { display: grid; gap: .3rem; width: fit-content; padding: 12px 16px; margin: -12px -14px; border-radius: 14px; background: rgba(9,9,11,.94); backdrop-filter: blur(6px); text-shadow: 0 1px 10px rgba(0,0,0,.85), 0 0 2px rgba(0,0,0,.9); }
      .readout .k, .readout .k2 { font: 400 .8125rem/1.3 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--soft); }
      .readout .k2 { text-transform: none; }
      .readout .v { font: 200 clamp(1.8rem, 4.4vw, 3rem)/1 var(--serif); font-variant-numeric: tabular-nums; letter-spacing: -.01em; }
      .skip { pointer-events: auto; font: 400 .8125rem/1.3 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--soft); border-bottom: 1px solid rgba(236,231,220,.3); padding: 10px 0 3px; margin-bottom: 70px; }
      body.arrived .skip { opacity: 0; pointer-events: none; transition: opacity .6s; }

      /* ---- controls */
      @media (max-width: 600px) { .hud { padding-bottom: calc(var(--bot) + 112px); } .readout { max-width: none; padding-bottom: 2px; margin-bottom: 0; } .readout .k, .readout .k2 { letter-spacing: .04em; } .controls { gap: 6px; } .controls .pill { padding: 15px 11px; letter-spacing: .08em; font-size: .8125rem; } .zoom button { width: 44px; } }
      .controls { position: fixed; z-index: 31; right: var(--gut); bottom: var(--bot); display: flex; align-items: flex-end; gap: 10px; opacity: 0; pointer-events: none; transition: opacity .8s ease .4s; }
      body.arrived .controls { opacity: 1; pointer-events: auto; }
      .pop { position: relative; }
      .pill { white-space: nowrap; font: 400 .8125rem/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--ink); background: var(--glass); border: 1px solid var(--line); border-radius: 999px; padding: 15px 18px; min-height: 48px; }
      .pill:hover, .pill:focus-visible, .pill[aria-expanded="true"] { color: var(--warm); border-color: rgba(241,201,142,.6); outline: none; }
      .sheet { position: absolute; right: 0; bottom: calc(100% + 62px); width: min(22rem, calc(100vw - 2 * var(--gut))); max-height: min(66vh, 36rem); overflow-y: auto; padding: 16px 18px 8px; background: rgba(9,9,11,.96); border: 1px solid var(--line); }
      .sheet[hidden] { display: none; }
      @media (max-width: 600px) { .sheet { position: fixed; left: var(--gut); right: var(--gut); width: auto; bottom: calc(var(--bot) + 66px); max-height: 60vh; } }
      .goto-find { width: 100%; min-height: 44px; margin: 0 0 10px; padding: 10px 12px; font: 400 1rem/1.2 var(--serif); color: var(--ink); background: rgba(236,231,220,.06); border: 1px solid var(--line); border-radius: 8px; }
      .goto-find::placeholder { color: var(--faint); }
      .goto-results[hidden], .goto-list [hidden] { display: none; }
      .goto-h { font: 400 .8125rem/1.3 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--faint); margin: 0 0 6px; }
      .goto-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 12px; margin-bottom: 14px; }
      .goto-row button { text-align: left; display: flex; align-items: center; min-height: 44px; font: 300 1.02rem/1.25 var(--serif); color: var(--soft); padding: 4px 0; border-bottom: 1px solid rgba(236,231,220,.08); }
      .goto-row button:hover, .goto-row button:focus-visible { color: var(--warm); outline: none; }
      .view-sheet fieldset { border: 0; margin: 0 0 14px; padding: 0; }
      .view-sheet legend { font: 400 .8125rem/1.3 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--faint); margin-bottom: 6px; padding: 0; }
      .view-sheet label { display: block; min-height: 44px; font: 300 1rem/1.3 var(--serif); color: var(--ink); padding: 10px 0 6px 50px; position: relative; cursor: pointer; }
      .view-sheet label small { display: block; font-size: .85rem; color: var(--faint); }
      .view-sheet input, .time-sheet fieldset input { position: absolute; left: 0; top: 0; width: 44px; height: 44px; margin: 0; cursor: pointer; appearance: none; -webkit-appearance: none; background-color: transparent; background-repeat: no-repeat; background-position: center; }
      /* the drawn control is about 22 px; the whole 44 px square around it takes the tap */
      input[type="radio"] { background-image: radial-gradient(circle, transparent 0 9px, rgba(236,231,220,.7) 9.5px 11px, transparent 11.5px); }
      input[type="radio"]:checked { background-image: radial-gradient(circle, var(--warm) 0 5.5px, transparent 6px 9px, var(--warm) 9.5px 11px, transparent 11.5px); }
      input[type="checkbox"] { background-image: linear-gradient(rgba(9,9,11,.96), rgba(9,9,11,.96)), linear-gradient(rgba(236,231,220,.7), rgba(236,231,220,.7)); background-size: 19px 19px, 22px 22px; }
      input[type="checkbox"]:checked { background-image: linear-gradient(var(--warm), var(--warm)), linear-gradient(var(--warm), var(--warm)); }
      .time-sheet { padding-bottom: 12px; }
      .time-now { font: 300 1.1rem/1.3 var(--serif); color: var(--ink); margin: 0 0 12px; }
      .time-f { margin: 0 0 14px; }
      .time-f label { display: block; font: 400 .8125rem/1.3 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--faint); margin-bottom: 6px; }
      .time-f input[type="date"] { width: 100%; padding: 10px 12px; font: 400 1rem/1.2 var(--serif); color: var(--ink); background: rgba(236,231,220,.06); border: 1px solid var(--line); border-radius: 8px; color-scheme: dark; min-height: 44px; }
      .time-f input[type="range"] { width: 100%; accent-color: #f1c98e; height: 44px; margin: 0; }
      .time-sheet fieldset { border: 0; margin: 0 0 12px; padding: 0; }
      .time-sheet legend { font: 400 .8125rem/1.3 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--faint); margin-bottom: 4px; padding: 0; }
      .time-sheet fieldset label { display: block; min-height: 44px; font: 300 1rem/1.3 var(--serif); color: var(--ink); padding: 12px 0 6px 50px; position: relative; cursor: pointer; }
      .time-back { margin-top: 4px; border-top: 1px solid rgba(236,231,220,.08); }
      .time-note { font: 300 .85rem/1.4 var(--serif); color: var(--faint); margin: 0; }
      .free-btn { width: 100%; min-height: 44px; font: 400 .8125rem/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; border: 1px solid var(--line); border-radius: 999px; padding: 13px 16px; margin: 2px 0 14px; }
      .keys { margin: 0 0 8px; border-top: 1px solid rgba(236,231,220,.1); padding-top: 10px; }
      .keys div { display: grid; grid-template-columns: 8.5rem 1fr; gap: 10px; padding: 4px 0; }
      .keys dt { font: 400 .8125rem/1.5 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--faint); }
      .keys dd { margin: 0; font: 300 .9rem/1.35 var(--serif); color: var(--soft); }
      @media (pointer: coarse) { .keys { display: none; } }
      @media (min-width: 601px) and (max-width: 760px) { body.margin-open .controls { opacity: 0; pointer-events: none; } }

      /* a hint, once, after arriving */
      .hint.show { opacity: 1; }
      .tour { position: fixed; z-index: 30; left: 50%; bottom: calc(var(--bot) + 76px); transform: translateX(-50%); width: min(30rem, calc(100vw - 32px)); padding: 16px 18px 14px; background: var(--glass); border: 1px solid var(--line); border-radius: 14px; text-shadow: 0 1px 10px #000; }
      .tour[hidden] { display: none; }
      .tour-k { margin: 0; font: 400 .8125rem/1.4 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--faint); }
      .tour-h { margin: 2px 0 6px; font: 300 1.4rem/1.2 var(--serif); color: var(--ink); }
      .tour-p { margin: 0 0 12px; font: 300 1rem/1.5 var(--serif); color: var(--soft); }
      .tour-b { display: flex; flex-wrap: wrap; gap: 8px; }
      .tour-b button { font: 400 .8125rem/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--ink); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 14px 16px; min-height: 48px; }
      .tour-b .tour-go { border-color: rgba(241,201,142,.6); color: var(--warm); }
      .tour-b button:hover, .tour-b button:focus-visible { color: var(--warm); border-color: rgba(241,201,142,.6); outline: none; }
      .tour-b button:disabled { opacity: .4; }
      @media (max-width: 600px) { .tour { bottom: calc(var(--bot) + 112px); padding: 12px 14px; } .tour-h { font-size: 1.2rem; } .tour-p { font-size: .9375rem; } .tour-b { flex-wrap: nowrap; } .tour-b button { flex: 1 1 auto; padding: 14px 8px; letter-spacing: .06em; } }
      .coarse-only { display: none; }
      @media (pointer: coarse) { .coarse-only { display: inline; } .fine-only { display: none; } }

      /* the touch pad, only while flying yourself */
      .pad { position: fixed; z-index: 12; right: var(--gut); bottom: calc(var(--bot) + 150px); width: 72px; height: 150px; border: 1px solid var(--line); border-radius: 36px; background: rgba(9,9,11,.86); display: none; flex-direction: column; align-items: center; justify-content: space-between; padding: 20px 0; touch-action: none; user-select: none; -webkit-user-select: none; }
      .pad span { font: 400 .8125rem/1 var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--soft); }
      .pad i { width: 22px; height: 1px; background: rgba(236,231,220,.3); }
      .pad.on { border-color: var(--warm); }
      @media (pointer: coarse) { body.arrived.free .pad { display: flex; } }

      /* ---- phone dock: four big slots along the bottom, in place of the floating pills */
      @media (max-width: 600px) {
        :root { --dock: calc(56px + env(safe-area-inset-bottom, 0px)); }
        .controls { box-sizing: border-box; left: 0; right: 0; bottom: 0; gap: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); align-items: stretch; height: var(--dock); padding-bottom: env(safe-area-inset-bottom, 0px); background: rgba(7,8,13,.92); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border-top: 1px solid var(--line); }
        .controls .pop { display: block; min-width: 0; }
        .controls .pop > .pill, .controls > .pill { width: 100%; height: 100%; min-height: 55px; border: 0; border-radius: 0; background: transparent; padding: 0 4px; font-size: .8125rem; letter-spacing: .12em; display: grid; place-items: center; }
        .controls > #tour-btn { order: 3; }
        .throttle .th { display: none; }
        .scale { top: calc(var(--top) + 50px); }
        .coach { left: var(--gut); right: var(--gut); width: auto; transform: none; bottom: calc(var(--dock) + 10px); padding: 12px 16px; gap: 6px; }
        .coach p { font-size: 1rem; }
        body.picking .gears, body.picking .pad { visibility: hidden; }
        body.coaching .hud, body.picking .hud { padding-bottom: calc(var(--dock) + 170px); }
        .controls > #goto { order: 1; } .controls > #time { order: 2; } .controls > #view { order: 4; } .controls > #help-btn { order: 5; }
        .controls .pill[aria-expanded="true"] { box-shadow: inset 0 2px 0 var(--warm); }
        .controls > .pill[aria-pressed="true"] { color: var(--warm); background: transparent; box-shadow: inset 0 2px 0 var(--warm); }
        .sheet { bottom: calc(var(--dock) + 8px); }
        /* the Codex leaves the header and the dock free, so Menu and the pills stay usable */
        body .margin { top: 56px; bottom: var(--dock); }
        .hud { padding-bottom: calc(var(--dock) + 14px); }
        .gears { position: static; }
        .gear-panel { position: fixed; left: var(--gut); bottom: calc(var(--dock) + 10px); width: calc(100vw - 2 * var(--gut) - 88px); }
        .tour { bottom: calc(var(--dock) + 10px); }
        .hint { bottom: calc(var(--dock) + 176px); width: auto; }
        .pad { bottom: calc(var(--dock) + 10px); }
      }

      /* ---- keeping things apart: the caption under the ribbon, the throttle clear of the pills, the pad clear of the Codex tab */
      body:has(.back-chip:not(:disabled)) .gen { left: calc(var(--gut) + 104px); }
      @media (min-width: 601px) { .coach { width: max-content; max-width: calc(100vw - 112px); } }
      body.tripping .coach, body.tripping .readout, body.tripping .hint { opacity: 0; pointer-events: none; }
      /* one thing at a time: the Fly here sheet, or the first-visit prompts, not both; and a sheet hides what it would cover */
      body.picking .coach { visibility: hidden; }
      .under-sheet { visibility: hidden !important; }
      @media (max-height: 520px) { .sheet { bottom: calc(100% + 12px); max-height: calc(100dvh - var(--bot) - 48px - 12px - 64px); } }
      @media (min-width: 601px) and (max-width: 1180px) {
        .throttle .th { display: none; }
        .readout { max-width: 180px; }
      }
      @media (min-width: 601px) and (max-width: 760px) {
        body .pad { right: calc(var(--gut) + 44px); bottom: calc(var(--bot) + 150px); height: 96px; padding: 14px 0; }
      }
      /* the Codex tab sits at the right edge, so on a mid-sized touch screen the pad stands clear of it */
      @media (min-width: 761px) and (max-width: 1180px) { .pad { right: calc(var(--gut) + 44px); } }
      @media (max-height: 520px) { .pad { right: calc(var(--gut) + 44px); bottom: calc(var(--bot) + 66px); height: 116px; padding: 16px 0; } }
      @media (max-width: 600px) {
        .gen { top: calc(var(--top) + 164px); }
        .eta { width: calc(100vw - 96px); }
        body:has(.back-chip:not(:disabled)) .gen { left: var(--gut); top: calc(var(--top) + 164px); }
        .controls .pill:focus-visible { outline-offset: -4px; }
      }


      /* when the row is crowded (a phone, a small tablet) the speed pill stacks over the readout instead of beside it */
      @media (max-width: 900px) { .hud-l { flex-direction: column-reverse; align-items: flex-start; gap: 8px; } .gears { margin-bottom: 12px; } }
      /* a short landscape screen has no room for the passing hint: Help and the first-visit card cover it */
      @media (max-height: 520px) { .hint { display: none; } }
      @media (pointer: coarse) { body.free .hud-l { max-width: calc(100vw - 2 * var(--gut) - 88px); } }
      /* a ring that shows where the keyboard is, whatever the colours do */
      .pill:focus-visible, .back-chip:focus-visible, .eta button:focus-visible, .tour-b button:focus-visible, .goto-row button:focus-visible, .coach button:focus-visible, .free-btn:focus-visible, .save-place:focus-visible, .aim-go:focus-visible, .scale button:focus-visible, .pages a:focus-visible { outline: 2px solid var(--warm); outline-offset: 2px; }
      .scale button:focus-visible { outline-offset: -4px; border-radius: 8px; }
      .view-sheet input:focus-visible, .time-sheet input:focus-visible, .throttle input:focus-visible, .goto-find:focus-visible { outline: 2px solid var(--warm); outline-offset: 0; }

      /* testing only */
      .tech { display: none; } body.debug .tech { display: block; }
      .tech { position: fixed; z-index: 5; right: var(--gut); top: calc(var(--top) + 48px); margin: 0; max-width: 60vw; text-align: right; font: 400 .8125rem/1.5 var(--mono); letter-spacing: .06em; color: rgba(236,231,220,.38); pointer-events: none; }
      /* what is drawn from a model, and what was measured, for wherever you are: always shown, beside the map */
      .gen { position: fixed; z-index: 5; top: calc(var(--top) + 112px); left: var(--gut); right: var(--gut); max-width: min(26rem, calc(100vw - 2 * var(--gut) - 48px)); margin: 0; font: 400 .9375rem/1.45 var(--serif); font-style: normal; color: var(--ink); background: rgba(8, 8, 10, .62); border-left: 2px solid rgba(241, 201, 142, .6); padding: .4rem .7rem; text-shadow: 0 1px 8px #000; pointer-events: none; }
      .gen:empty { display: none; }
      .gen.illus { font: 500 .8125rem/1.4 var(--sans, system-ui, sans-serif); font-style: normal; color: var(--ink, #f4efe4); background: rgba(8, 6, 4, .78); border: 1px solid rgba(241, 201, 142, .55); border-radius: 6px; padding: .45rem .65rem; text-shadow: none; }
      body:not(.in) .gen, body.margin-open .gen { visibility: hidden; }

      @media (prefers-reduced-motion: reduce) {
        .ticks { animation: none; }
        .aperture, .ring, .aperture::after { transition-duration: .01s !important; }
        body.in .aperture { transform: none; }
      }
    </style>
  </body>
