        if (yau > 100) {
          const distAu = Math.hypot(st.cam[0], st.cam[1], st.cam[2]) / AU;
          mctx.clearRect(0, 0, S, S);
          drawLadder(c, R, dpr, st.cam, distAu);
          const next = ladderSteps(distAu, st.focus);
          $('where-d').textContent = `${fmt(shown(distAu * AU))} from the Sun.${next ? ` Next out: ${next[1]}.` : ''}`;
          map.setAttribute('aria-label', `A map of the scales of the universe, one ring for each stop from the Solar System out to the oldest light. You are ${fmt(shown(distAu * AU))} from the Sun${next ? `, between ${RUNGS[RUNGS.indexOf(next) - 1]?.[1] ?? 'the Sun'} and ${next[1]}` : ''}.`);
