        const speedIn = [...document.querySelectorAll<HTMLInputElement>('input[name="speed"]')], rev = $('time-rev') as HTMLInputElement;
        const DAY = 86_400_000, START = Date.UTC(1950, 0, 1), LO = Date.UTC(1800, 0, 1), HI = Date.UTC(2200, 0, 1);
        const fmtDate = (ms: number) => new Date(ms).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
        const isoDay = (ms: number) => new Date(ms).toISOString().slice(0, 10);
        const refresh = () => {
          const ms = world.timeMs, live = world.rate === 1 && Math.abs(ms - Date.now()) < 5000;
