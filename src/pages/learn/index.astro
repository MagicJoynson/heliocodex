---
import { PLANNED_LESSONS, plannedCount } from '../../data/plan';
import Reading from '../../layouts/Reading.astro';
import { PACKS, packLessons } from '../../lib/learn/packs';
import { PLACES, IDEAS, TICKS, along } from '../../lib/learn/map';
import { allLessons, allTerms, allFacts, STRAND_NAMES } from '../../lib/v2/margin/content';

const [lessons, terms, facts] = await Promise.all([allLessons(), allTerms(), allFacts()]);
const inStrand = (id: string) => lessons.filter((l) => l.data.strand === id);
const count = (n: number) => `${n} ${n === 1 ? 'lesson' : 'lessons'}`;
const planned = (id: string) => PLANNED_LESSONS[id]?.length ?? 0;
// nearer places glow the colour of sunlight, the farthest the cold blue of very old light
const tint = (t: number) => `color-mix(in oklab, #f0c27a, #8eaeff ${Math.round(t * 100)}%)`;
const places = PLACES.map((p) => {
  const a = along(p.from), b = along(p.to);
  return { ...p, name: STRAND_NAMES[p.strand], lessons: inStrand(p.strand), a, b, tint: tint((a + b) / 2) };
}).filter((p) => p.lessons.length);
const ideas = IDEAS.map((id) => ({ id, name: STRAND_NAMES[id], lessons: inStrand(id) })).filter((i) => i.lessons.length);
const first = PACKS[0];
// the other packs are drawn as discs whose area grows with the number of lessons in them
const most = Math.max(...PACKS.slice(1).map((p) => packLessons(p).length));
const packs = PACKS.slice(1).map((p) => ({ ...p, n: packLessons(p).length, d: Math.sqrt(packLessons(p).length / most) }));
const ticks = TICKS.filter((t) => t.s > 1);
---
<Reading title="Learn" path="/learn" description="Short lessons on how space works, from why there are seasons to what the Sun is made of, set out from the ground under your feet to the oldest light there is.">
  <header class="reading-head with-pic" style="--pic: url(/img/learn/orion-nebula-hubble.jpg)">
    <p class="label">Learn</p>
    <h1>How it all works</h1>
    <p class="lead">{lessons.length} short lessons, with {plannedCount} more outlined and being written, each written at more than one depth. The first look needs nothing but curiosity; the next level down has the numbers and the reasons.</p>
  </header>

  <section class="start" aria-labelledby="start-h">
    <a class="start-pic" href={`/learn/packs/${first.id}`} tabindex="-1" aria-hidden="true"><img src={first.photo.src} alt="" width={first.photo.width} height={first.photo.height} /></a>
    <div class="start-words">
      <p class="label">New here? Start here</p>
      <h2 id="start-h">{first.name}</h2>
      <p class="start-line">{first.blurb} About five minutes each.</p>
      <p class="start-go">
        <a class="start-btn" href={`/learn/${packLessons(first)[0]}`}>Begin the first lesson</a>
        <a class="start-link" href={`/learn/packs/${first.id}`}>See all {packLessons(first).length}</a>
      </p>
    </div>
  </section>

  <section class="outward" aria-labelledby="out-h">
    <div class="out-head">
      <h2 id="out-h">Outward from here</h2>
      <p>Every place the lessons go, set out by how long its light takes to reach you. Each step along the scale is ten times longer than the one before.</p>
    </div>
    <div class="scale" aria-hidden="true">
      <span class="scale-here">Here</span>
      <span class="scale-track">{ticks.map((t) => <i style={`--x:${along(t.s)}`}><b>{t.label}</b></i>)}</span>
    </div>
    <ol class="places">
      {places.map((p) => (
        <li>
          <a href={`/learn/subject/${p.strand}`} style={`--a:${p.a};--b:${p.b};--tint:${p.tint}`}>
            <span class="p-name">{p.name}</span>
            <span class="p-count">{count(p.lessons.length)}{planned(p.strand) > 0 && <span class="outline-n"> + {planned(p.strand)} outlined</span>}</span>
            <span class="p-track" aria-hidden="true">{ticks.map((t) => <i style={`--x:${along(t.s)}`} />)}<span class:list={['p-bar', { dot: p.b - p.a < 0.012 }]} /></span>
            <span class="p-reach">{p.reach}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <div class="lower">
    <section class="ideas" aria-labelledby="ideas-h">
      <h2 id="ideas-h">Ideas that run through all of it</h2>
      <p class="sub">Not places but the rules and the tools: what holds everything together, and how anyone knows.</p>
      <ul>
        {ideas.map((i) => (
          <li>
            <a class="i-name" href={`/learn/subject/${i.id}`}>{i.name}</a>
            <span class="i-count">{i.lessons.length}{planned(i.id) > 0 && <span class="outline-n"> + {planned(i.id)}</span>}</span>
            <p>{i.lessons.slice(0, 3).map((l) => l.data.title).join(' · ')}</p>
          </li>
        ))}
      </ul>
    </section>

    <aside class="side">
      <section class="lookups" aria-labelledby="look-h">
        <h2 id="look-h">Look something up</h2>
        <p><a href="/glossary">Glossary</a> {terms.length} words, each in one plain sentence.</p>
        <p><a href="/learn/facts">Facts</a> {facts.length} short facts with a number in them, and where each comes from.</p>
      </section>
    </aside>
  </div>

  <section class="packs" aria-labelledby="packs-h">
    <h2 id="packs-h">Lesson packs</h2>
    <p class="sub">One subject, from every part of the site, in the best order to read it. Drawn to scale by how many lessons they hold.</p>
    <ul class="discs">
      {packs.map((p) => (
        <li style={`--d:${p.d}`}>
          <a href={`/learn/packs/${p.id}`}>
            <span class="disc"><img src={p.photo.src} alt="" width={p.photo.width} height={p.photo.height} loading="lazy" /></span>
            <span class="d-name">{p.name}</span>
            <span class="d-count">{p.n} lessons</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Reading>

<style>
  h2 { font: 400 clamp(1.6rem, 2.6vw, 2.1rem)/1.12 var(--r-serif); letter-spacing: -.01em; margin: 0; }
  .sub { font: 300 1.02rem/1.5 var(--r-serif); color: var(--ink-faint); margin: .6rem 0 1.6rem; max-width: 34rem; }

  .start { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1fr); gap: 2rem 3.5rem; align-items: center; padding: 2.4rem 0 2.8rem; border-top: 1px solid var(--rule); }
  .start-pic { display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 4px; background: #000; }
  .start-pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .start h2 { font: 300 clamp(2rem, 3.4vw, 2.8rem)/1.05 var(--r-serif); letter-spacing: -.015em; margin: .7rem 0 .9rem; }
  .start-line { font: 300 1.12rem/1.6 var(--r-serif); color: var(--ink-soft); margin: 0; }
  .start-go { display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: center; margin: 1.5rem 0 0; font: 400 .76rem/1 var(--r-mono); letter-spacing: .12em; text-transform: uppercase; }
  .start-btn { padding: 15px 22px; border-radius: 999px; background: var(--accent); color: #160f05 !important; text-decoration: none; }
  .start-btn:hover { background: #f3d4a2; }
  .start-link { text-decoration: none; border-bottom: 1px solid rgba(233,196,138,.5); padding-bottom: 3px; }

  /* the map: one row per place, its reach drawn on a scale of light-travel time */
  .outward { --name-col: 17rem; --reach-col: 15rem; padding: 2.6rem 0 1rem; border-top: 1px solid var(--rule); }
  .out-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .6rem 2rem; margin-bottom: 1.8rem; }
  .out-head p { font: 300 1.02rem/1.5 var(--r-serif); color: var(--ink-faint); margin: 0; max-width: 34rem; }
  .scale { display: grid; grid-template-columns: var(--name-col) minmax(0, 1fr) var(--reach-col); gap: 0 1.6rem; font: 400 .66rem/1 var(--r-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); padding-bottom: .7rem; }
  .scale-here { grid-column: 1; text-align: right; }
  .scale-track { grid-column: 2; position: relative; height: 1em; margin: 0 10px; }
  .scale-track i { position: absolute; left: calc(var(--x) * 100%); font-style: normal; }
  .scale-track b { position: absolute; left: 0; transform: translateX(-50%); white-space: nowrap; font-weight: 400; }
  .places { list-style: none; margin: 0; padding: 0; }
  .places a { display: grid; grid-template-columns: var(--name-col) minmax(0, 1fr) var(--reach-col); grid-template-areas: 'name track reach' 'count track reach'; gap: .1rem 1.6rem; align-items: center; padding: .85rem 0; border-top: 1px solid var(--rule); color: var(--ink); text-decoration: none; }
  .places li:last-child a { border-bottom: 1px solid var(--rule); }
  .p-name { grid-area: name; font: 400 1.3rem/1.2 var(--r-serif); text-align: right; align-self: end; }
  .p-count { grid-area: count; font: 400 .7rem/1.4 var(--r-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); text-align: right; align-self: start; }
  .p-reach { grid-area: reach; font: 300 .98rem/1.35 var(--r-serif); color: var(--ink-soft); }
  .p-track { grid-area: track; position: relative; height: 2.6rem; margin: 0 10px; }
  .p-track::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--rule); }
  .p-track i { position: absolute; left: calc(var(--x) * 100%); top: 30%; bottom: 30%; width: 1px; background: rgba(236,231,220,.1); }
  .p-bar { position: absolute; top: 50%; left: calc(var(--a) * 100%); width: max(calc((var(--b) - var(--a)) * 100%), 14px); height: 6px; margin-top: -3px; border-radius: 3px; background: var(--tint); box-shadow: 0 0 14px color-mix(in srgb, var(--tint) 45%, transparent); transition: height .2s ease, margin .2s ease; }
  .p-bar.dot { width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; }
  .places a:hover .p-name { color: var(--accent); }
  .places a:hover .p-bar:not(.dot) { height: 10px; margin-top: -5px; }
  .places a:hover { background: linear-gradient(90deg, transparent, rgba(236,231,220,.03) 30%, transparent); }

  .lower { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr); gap: 3rem 5rem; padding: 3.2rem 0 0; }
  .ideas ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2.4rem; }
  .ideas li { padding: 1rem 0 1.1rem; border-top: 1px solid var(--rule); display: grid; grid-template-columns: 1fr auto; gap: .35rem 1rem; align-content: start; }
  .i-name { font: 400 1.22rem/1.25 var(--r-serif); text-decoration: none; }
  .i-count { font: 400 .74rem/1.9 var(--r-mono); color: var(--ink-faint); }
  .ideas li p { grid-column: 1 / -1; font: 300 .94rem/1.45 var(--r-serif); color: var(--ink-faint); margin: 0; }

  .side { display: grid; gap: 2.6rem; align-content: start; }
  .packs { margin-top: 3.4rem; padding-top: 2.6rem; border-top: 1px solid var(--rule); }
  .discs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); gap: 2rem 1rem; }
  .discs li { min-width: 0; }
  .discs a { display: grid; justify-items: center; text-align: center; gap: .3rem; text-decoration: none; color: var(--ink); }
  .disc { display: block; width: calc(2.6rem + var(--d) * 5rem); aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: #000; margin: calc((1 - var(--d)) * 2.5rem) 0 .7rem; box-shadow: 0 0 0 1px var(--rule); transition: box-shadow .3s ease; }
  .disc img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .discs a:hover .disc { box-shadow: 0 0 0 1px var(--accent), 0 0 24px rgba(233,196,138,.25); }
  .d-name { font: 400 1.04rem/1.25 var(--r-serif); }
  .discs a:hover .d-name { color: var(--accent); }
  .d-count { font: 400 .68rem/1.4 var(--r-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); }
  .lookups { padding-top: .2rem; }
  .lookups h2 { font-size: 1.3rem; margin-bottom: .8rem; }
  .lookups p { font: 300 1rem/1.5 var(--r-serif); color: var(--ink-faint); margin: .4rem 0 0; }
  .lookups a { font: 400 1.12rem/1.3 var(--r-serif); margin-right: .5rem; }

  @media (max-width: 1100px) { .outward { --name-col: 13rem; --reach-col: 11rem; } }
  @media (max-width: 900px) { .lower { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 760px) {
    .start { grid-template-columns: 1fr; }
    .scale { grid-template-columns: minmax(0, 1fr); }
    .scale-here { display: none; }
    .scale-track { grid-column: 1; height: 2.2em; }
    .scale-track i:nth-child(even) b { top: 1.2em; }
    .places a { grid-template-columns: 1fr auto; grid-template-areas: 'name count' 'track track' 'reach reach'; gap: .2rem 1rem; padding: .9rem 0 1rem; }
    .p-name, .p-count { text-align: left; align-self: baseline; }
    .p-track { height: 1.6rem; }
    .p-reach { font-size: .92rem; color: var(--ink-faint); }
    .ideas ul { grid-template-columns: minmax(0, 1fr); }
    .discs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.6rem .8rem; }
    .disc { width: calc(2.2rem + var(--d) * 3.6rem); margin-top: calc((1 - var(--d)) * 1.8rem); }
    .d-name { font-size: .95rem; }
  }
  @media (prefers-reduced-motion: reduce) { .p-bar, .disc { transition: none; } }
  .outline-n { color: var(--accent); opacity: .85; }
</style>
