---
import Reading from '../../layouts/Reading.astro';
import { PACKS, packLessons } from '../../lib/learn/packs';
import { portraits } from '../../lib/portraits';
import { allLessons, allTerms, allFacts, STRAND_NAMES, STRAND_ORDER, LEVEL_NAMES, levelOf } from '../../lib/v2/margin/content';

const [lessons, terms, facts] = await Promise.all([allLessons(), allTerms(), allFacts()]);
const strands = STRAND_ORDER.map((id) => ({ id, name: STRAND_NAMES[id], lessons: lessons.filter((l) => l.data.strand === id) }));
const written = strands.filter((s) => s.lessons.length);
const toCome = strands.filter((s) => !s.lessons.length).map((s) => s.name);
// each lesson's card shows the first real picture in its first look
const thumb = (l: (typeof lessons)[number]) => {
  for (const lv of l.levels) { const m = /src="(\/img\/learn\/[^"]+\.(?:jpg|png|webp))"/.exec(lv.body ?? ''); if (m) return m[1]; }
  const target = (l.data as { view?: { target?: string } }).view?.target;
  const face = portraits.find((p) => p.slug === target);
  if (face) return face.src + '#face';
  const pack = PACKS.find((p) => packLessons(p).includes(l.id));
  return pack ? pack.photo.src : '';
};
const first = PACKS[0];
const levelCount = Math.max(...lessons.map((l) => l.levels.length));
---
<Reading title="Learn" path="/learn" description="Short lessons on how space works, from why there are seasons to what the Sun is made of. Each one can be read at more than one depth.">
  <header class="reading-head with-pic" style="--pic: url(/img/learn/orion-nebula-hubble.jpg)">
    <p class="label">Learn</p>
    <h1>How it all works</h1>
    <p class="lead">Short lessons, each written more than once. Start with the first look, which needs nothing but curiosity. If you want the numbers and the reasons, the next level down is on the same page.</p>
  </header>

  <section class="start" aria-labelledby="start-h">
    <a class="start-pic" href={`/learn/packs/${first.id}`} tabindex="-1" aria-hidden="true"><img src={first.photo.src} alt="" width={first.photo.width} height={first.photo.height} /></a>
    <div class="start-words">
      <p class="label">New here? Start here</p>
      <h2 id="start-h">{first.name}</h2>
      <p class="start-line">{first.blurb} {packLessons(first).length} lessons, about five minutes each.</p>
      <p class="start-go">
        <a class="start-btn" href={`/learn/${packLessons(first)[0]}`}>Begin the first lesson</a>
        <a class="start-link" href={`/learn/packs/${first.id}`}>See the whole pack</a>
      </p>
    </div>
  </section>

  <section class="row wide" id="packs">
    <div class="hang">
      <h2>Lesson packs</h2>
      <p class="about">Everything on one subject, in the best order to read it.</p>
    </div>
    <ul class="cards">
      {PACKS.slice(1).map((p) => (
        <li>
          <a href={`/learn/packs/${p.id}`}>
            <span class="pic"><img src={p.photo.src} alt="" width={p.photo.width} height={p.photo.height} loading="lazy" /></span>
            <span class="kicker">{packLessons(p).length} lessons</span>
            <span class="name">{p.name}</span>
            <p class="line">{p.blurb}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="row wide" id="subjects">
    <div class="hang">
      <h2>Every lesson, by subject</h2>
      <p class="about">{lessons.length} lessons in {written.length} subjects.</p>
    </div>
    <ol class="subject-index">
      {written.map((s) => <li><a href={`#s-${s.id}`}>{s.name}</a><span>{s.lessons.length}</span></li>)}
    </ol>
  </section>

  {written.map((s) => (
    <section class="row wide" id={`s-${s.id}`}>
      <div class="hang">
        <h2>{s.name}</h2>
        <p class="about">{s.lessons.length} {s.lessons.length === 1 ? 'lesson' : 'lessons'}</p>
      </div>
      <ol class="cards lesson-cards" style="--card-min: 15rem">
        {s.lessons.map((l) => (
          <li>
            <a href={`/learn/${l.id}`}>
              <span class="pic">{thumb(l) ? <img src={thumb(l).replace('#face', '')} class:list={[{ face: thumb(l).endsWith('#face') }]} alt="" loading="lazy" decoding="async" /> : <span class="no-pic" />}</span>
              <span class="name">{l.data.title}</span>
              <p class="line">{l.data.summary}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <section class="row quiet">
    <div class="hang">
      <h2>Still being written</h2>
    </div>
    <div>
      <p class="coming">{toCome.join(', ')}. There are {lessons.length} lessons so far, at {levelCount} levels each, with two deeper levels to follow.</p>
    </div>
  </section>

  <section class="row">
    <div class="hang">
      <h2>Look something up</h2>
    </div>
    <ul class="plain-list lookups">
      <li><a href="/glossary">Glossary</a><p>{terms.length} terms, each explained in one plain sentence.</p></li>
      <li><a href="/learn/facts">Facts</a><p>{facts.length} short facts with a number in them, and where each one comes from.</p></li>
    </ul>
  </section>
</Reading>

<style>
  .about { font: 300 1rem/1.5 var(--r-serif); color: var(--ink-faint); margin: .5rem 0 0; }
  .pack-list { display: grid; gap: 2.2rem 2rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
  .pack-list a { display: grid; gap: .8rem; text-decoration: none; color: var(--ink); }
  .pack-list img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; background: #000; filter: saturate(.9); transition: filter .3s ease; }
  .pack-list a:hover img { filter: none; }
  .pack-list span { font: 400 1.32rem/1.25 var(--r-serif); }
  .pack-list a:hover span { color: var(--accent); }
  .pack-list p { font: 300 1rem/1.5 var(--r-serif); color: var(--ink-soft); margin: .35rem 0 0; }
  .start { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 2rem 3.5rem; align-items: center; padding: 2.6rem 0 3rem; border-top: 1px solid var(--rule); }
  .start-pic { display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 4px; background: #000; }
  .start-pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .start h2 { font: 300 clamp(2rem, 3.6vw, 3rem)/1.05 var(--r-serif); letter-spacing: -.015em; margin: .7rem 0 .9rem; }
  .start-line { font: 300 1.14rem/1.6 var(--r-serif); color: var(--ink-soft); margin: 0; }
  .start-go { display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: center; margin: 1.6rem 0 0; font: 400 .76rem/1 var(--r-mono); letter-spacing: .12em; text-transform: uppercase; }
  .start-btn { padding: 15px 22px; border-radius: 999px; background: var(--accent); color: #160f05 !important; text-decoration: none; }
  .start-btn:hover { background: #f3d4a2; }
  .start-link { text-decoration: none; border-bottom: 1px solid rgba(233,196,138,.5); padding-bottom: 3px; }
  @media (max-width: 760px) { .start { grid-template-columns: 1fr; } }
  .subject-index { list-style: none; margin: 0; padding: 0; columns: 3 15rem; column-gap: 2.4rem; }
  .subject-index li { break-inside: avoid; display: flex; justify-content: space-between; gap: 1rem; padding: .6rem 0; border-top: 1px solid var(--rule); }
  .subject-index a { font: 400 1.12rem/1.3 var(--r-serif); text-decoration: none; }
  .subject-index span { font: 400 .78rem/1.6 var(--r-mono); color: var(--ink-faint); }
  .jump { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0 0 1rem; }
  .jump a { font: 400 .74rem/1 var(--r-mono); letter-spacing: .06em; text-transform: uppercase; text-decoration: none; color: var(--ink-soft); border: 1px solid var(--rule); border-radius: 999px; padding: .6rem .9rem; }
  .jump a:hover { color: var(--accent); border-color: var(--accent); }
  .jump span { color: var(--ink-faint); margin-left: .3rem; }
  .lesson-cards .pic { aspect-ratio: 16 / 9; }
  .lesson-cards .name { font-size: 1.18rem; }
  .lesson-cards .line { font-size: .95rem; color: var(--ink-faint); }
  .lesson-cards .pic img.face { object-fit: contain; padding: 6% 0; }
  .no-pic { position: absolute; inset: 0; background: radial-gradient(circle at 30% 30%, #2a2217, #0b0b0c 70%); }
  .all-head { margin: 3.5rem 0 0; }
  .all-head h2 { font: 400 .76rem/1.4 var(--r-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-faint); margin: 0; }
  .lessons, .lookups { display: grid; gap: 1.5rem; }
  .lessons a, .lookups a { font: 400 1.32rem/1.25 var(--r-serif); color: var(--ink); text-decoration: none; background: linear-gradient(rgba(233,196,138,.5), rgba(233,196,138,.5)) 0 100% / 0 1px no-repeat; transition: background-size .3s ease; }
  .lessons a:hover, .lookups a:hover { background-size: 100% 1px; }
  .lessons p, .lookups p, .coming { font: 300 1.06rem/1.5 var(--r-serif); color: var(--ink-soft); margin: .25rem 0 0; }
  .coming { margin: 0; color: var(--ink-faint); }
  .quiet h2 { color: var(--ink-faint); }
  @media (prefers-reduced-motion: reduce) { .lessons a, .lookups a { transition: none; } }
</style>
