---
import Reading from '../../../layouts/Reading.astro';
import { allFacts, allLessons } from '../../../lib/v2/margin/content';
import { linksFor, PLAIN, LEAD } from '../../../lib/fact-links';

const [all, lessons] = await Promise.all([allFacts(), allLessons()]);
const SUBJECTS: Record<string, string> = {
  sun: 'The Sun', 'earth-and-moon': 'The Earth and the Moon', 'inner-planets': 'The inner planets', 'giant-planets': 'The giant planets',
  moons: 'Moons', 'small-bodies': 'Dwarf planets, asteroids and comets', beyond: 'Beyond the Solar System',
};
const basisNote = { measured: '', 'worked-out': 'Worked out from measurements', theory: 'From a model, not a direct measurement' } as const;
const pool = all.filter((f) => !PLAIN.has(f.id)).map((f) => ({
  id: f.id, text: f.text, subject: SUBJECTS[f.subject] ?? '', basis: basisNote[f.basis],
  source: f.source, links: linksFor(f, lessons), lead: LEAD.includes(f.id),
}));
const first = pool.find((f) => f.lead) ?? pool[0];
---
<Reading title="A fact at a time" path="/learn/facts/random" description="One fact about space, with its source. Press the button for another.">
  <header class="reading-head">
    <p class="label"><a href="/learn">Learn</a> / <a href="/learn/facts">Facts</a> / One at a time</p>
    <h1>A fact at a time</h1>
    <p class="lead">Each one names its source and says whether it was measured, worked out from measurements, or comes from a model. Press the button for another.</p>
  </header>

  <section class="draw" data-draw>
    <div class="hang">
      <svg class="ring" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
        <circle cx="60" cy="60" r="52" fill="none" stroke="currentColor" stroke-width="1" opacity=".35" />
        <circle cx="60" cy="60" r="3.5" fill="currentColor" />
        <g class="arm"><circle cx="112" cy="60" r="4" fill="var(--accent)" /></g>
      </svg>
      <p class="label" data-subject>{first.subject}</p>
    </div>
    <div class="fx-panel">
      <div class="fact" aria-live="polite" aria-atomic="true">
        <p class="text" data-text>{first.text}</p>
        <p class="label cite"><span class="basis" data-basis>{first.basis}</span><a data-source href={first.source.url} rel="noopener">{first.source.label}</a></p>
        <p class="more" data-links>
          {first.links.map((l) => <a href={l.href}>{l.kind === 'lesson' ? 'Lesson: ' : l.kind === 'record' ? 'Visit ' : 'See '}{l.label}</a>)}
        </p>
      </div>
      <noscript><p class="note">The button needs JavaScript. <a href="/learn/facts">All the facts are listed on one page</a>.</p></noscript>
    </div>
      <p class="actions" data-actions hidden>
        <button type="button" class="go" data-next>Another fact</button>
        <button type="button" class="back" data-prev disabled>Previous</button>
      </p>
  </section>

  <script type="application/json" id="facts-pool" set:html={JSON.stringify(pool).replace(/</g, '\\u003c')} />
</Reading>

<script>
  type L = { href: string; label: string; kind: string };
  type F = { id: string; text: string; subject: string; basis: string; source: { label: string; url: string }; links: L[]; lead: boolean };
  const root = document.querySelector<HTMLElement>('[data-draw]');
  const pool: F[] = JSON.parse(document.getElementById('facts-pool')?.textContent ?? '[]');
  if (root && pool.length > 1) {
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const fact = $('.fact'), arm = root.querySelector<SVGGElement>('.arm')!;
    const next = $('[data-next]') as HTMLButtonElement, prev = $('[data-prev]') as HTMLButtonElement;
    $('[data-actions]').hidden = false;
    // A shuffled deck, so nothing repeats until every fact has been shown. Nothing is stored.
    const shuffle = (d: number[]) => { for (let i = d.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [d[i], d[j]] = [d[j], d[i]]; } };
    // The strongest facts come first, in random order, then the rest.
    const lead = pool.flatMap((f, i) => (f.lead ? [i] : [])), rest = pool.flatMap((f, i) => (f.lead ? [] : [i]));
    shuffle(lead); shuffle(rest);
    const deck = [...lead, ...rest];
    const wanted = pool.findIndex((f) => f.id === decodeURIComponent(location.hash.slice(1)));
    if (wanted >= 0) { deck.splice(deck.indexOf(wanted), 1); deck.unshift(wanted); }
    let pos = -1, angle = Math.random() * 360;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const verb = (k: string) => (k === 'lesson' ? 'Lesson: ' : k === 'record' ? 'Visit ' : 'See ');
    function show(p: number, turn: number) {
      const f = pool[deck[p]];
      const paint = () => {
        $('[data-text]').textContent = f.text;
        $('[data-subject]').textContent = f.subject;
        $('[data-basis]').textContent = f.basis;
        const a = $('[data-source]') as HTMLAnchorElement; a.href = f.source.url; a.textContent = f.source.label;
        $('[data-links]').replaceChildren(...f.links.map((l) => { const x = document.createElement('a'); x.href = l.href; x.textContent = verb(l.kind) + l.label; return x; }));
        fact.style.opacity = '1';
      };
      angle += turn;
      arm.style.transform = `rotate(${angle}deg)`;
      prev.disabled = p === 0;
      if (reduce) return paint();
      fact.style.opacity = '0';
      setTimeout(paint, 180);
    }
    function go(d: number) {
      const n = pos + d, turn = d * (47 + Math.random() * 120);
      if (n < 0) return;
      if (n >= deck.length) { // deck used up: reshuffle, but never open on the fact just shown
        const last = deck[deck.length - 1];
        shuffle(deck);
        if (deck[0] === last) [deck[0], deck[1]] = [deck[1], deck[0]];
        pos = 0; return show(0, turn);
      }
      pos = n; show(n, turn);
    }
    // A link to a fact (#id) opened while the page is already showing: put it next in the deck.
    addEventListener('hashchange', () => {
      const w = pool.findIndex((f) => f.id === decodeURIComponent(location.hash.slice(1)));
      if (w < 0) return;
      deck.splice(deck.indexOf(w), 1); deck.splice(pos + 1, 0, w); go(1);
    });
    next.addEventListener('click', () => go(1));
    prev.addEventListener('click', () => go(-1));
    go(1);
  }
</script>

<style>
  .reading-head { margin-bottom: clamp(24px, 3.5vw, 40px); }
  .reading-head h1 { font-size: clamp(2rem, 1.4rem + 2vw, 2.9rem); margin-bottom: .8rem; }
  .draw { display: grid; grid-template-columns: var(--margin-col) minmax(0, 1fr); grid-template-areas: "hang panel" "actions panel"; grid-template-rows: auto 1fr; column-gap: clamp(24px, 5vw, 72px); row-gap: 1.6rem; padding-top: clamp(28px, 4vw, 48px); border-top: 1px solid var(--rule); }
  .hang { grid-area: hang; display: grid; gap: 1rem; align-content: start; color: var(--ink-faint); }
  .ring { width: 7.5rem; height: auto; overflow: visible; }
  .arm { transform-origin: 60px 60px; transition: transform 900ms cubic-bezier(.2, .7, .2, 1); }
  .fx-panel { grid-area: panel; max-width: 44rem; }
  .fact { transition: opacity 180ms ease; min-height: 15rem; }
  .text { font: 300 clamp(1.6rem, 1.1rem + 1.9vw, 2.3rem)/1.3 var(--r-serif); letter-spacing: -.01em; color: var(--ink); margin: 0 0 1.6rem; text-wrap: pretty; }
  .cite { display: flex; flex-wrap: wrap; gap: .3rem 1.1rem; }
  .basis { color: var(--accent); }
  .basis:empty { display: none; }
  .more { display: flex; flex-wrap: wrap; gap: .4rem 1.6rem; margin: 1.1rem 0 0; font: 300 1.05rem/1.5 var(--r-serif); }
  .actions { grid-area: actions; display: flex; align-items: center; gap: 1.4rem; margin: 0; align-self: start; }
  .actions[hidden] { display: none; }
  .go { white-space: nowrap; font: 400 .85rem/1 var(--r-mono); letter-spacing: .1em; text-transform: uppercase; color: #15110a; background: var(--accent); border: 0; padding: .95rem 1.5rem; min-height: 44px; cursor: pointer; border-radius: 2px; }
  .go:hover { background: #f3d6a4; }
  .back { font: 400 .85rem/1 var(--r-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); background: none; border: 0; padding: .9rem .2rem; min-height: 44px; cursor: pointer; text-decoration: underline; text-decoration-color: rgba(233, 196, 138, .5); text-underline-offset: .25em; }
  .back:hover:not(:disabled) { color: var(--accent); }
  .back:disabled { opacity: .4; cursor: default; text-decoration: none; }
  .go:focus-visible, .back:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .draw .label { font-size: .85rem; }
  .note { color: var(--ink-soft); }
  @media (max-width: 760px) {
    .draw { grid-template-columns: minmax(0, 1fr); grid-template-areas: "hang" "panel" "actions"; grid-template-rows: auto auto auto; row-gap: 1.2rem; }
    .hang { grid-template-columns: auto 1fr; align-items: center; gap: 1rem; }
    .ring { width: 3.6rem; }
    .fact { min-height: 16rem; }
  }
  @media (prefers-reduced-motion: reduce) { .arm, .fact { transition: none; } }
</style>
