---
import '@fontsource/spectral/300.css';
import '@fontsource/ibm-plex-mono/400.css';
import Base from '../layouts/Base.astro';
---
<Base title="Lost in space" path="/404" description="This page does not exist.">
  <section class="lost">
    <p class="lost-k">404</p>
    <h1>Nothing out here.</h1>
    <p>This page doesn’t exist, or has drifted off somewhere. The solar system is <a href="/">back this way</a>.</p>
  </section>
</Base>

<style is:global>
  body { background: #020203; }
  .lost { max-width: 40rem; margin: 0 auto; padding: clamp(80px, 18vh, 200px) var(--gutter); font-family: 'Spectral', Georgia, serif; color: #ece7dc; }
  .lost-k { font: 400 .74rem/1.4 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: .1em; color: #a8a296; margin: 0 0 1rem; }
  .lost h1 { font: 300 clamp(2.6rem, 7vw, 4.6rem)/1 'Spectral', Georgia, serif; letter-spacing: -.02em; margin: 0 0 1.2rem; }
  .lost p { font: 300 1.15rem/1.6 'Spectral', Georgia, serif; color: #d8d2c5; }
  .lost a { color: #ece7dc; text-decoration-color: rgba(233,196,138,.5); text-underline-offset: .18em; }
</style>
