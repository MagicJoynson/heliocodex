---
// Every world the site knows, set out by distance from the Sun. Worlds with a full page are written in
// full; the rest have outline pages built from their measured orbits, marked as outlines.
import Reading from '../../layouts/Reading.astro';
import { outlineWorlds, PLANET_PAGES, sunAu, nameOf } from '../../lib/worlds';
import { allBodies, body } from '../../data/bodies/index';
import { moonCount } from '../../data/moon-counts';

const LO = Math.log10(0.3), HI = Math.log10(700);
const x = (au: number) => ((Math.log10(Math.min(700, Math.max(0.3, au))) - LO) / (HI - LO)) * 100;
const planets = PLANET_PAGES.filter((p) => p !== 'sun').map((id) => body(id)!);
const outline = new Set(outlineWorlds.map((b) => b.id));
const dots = [
  ...planets.map((b) => ({ id: b.id, name: b.name, au: sunAu(b), href: `/${b.id}`, built: true, kind: 'planet' })),
  ...outlineWorlds.filter((b) => b.kind !== 'moon').map((b) => ({ id: b.id, name: b.name, au: sunAu(b), href: `/worlds/${b.id}`, built: false, kind: b.kind })),
];
const ZONES = [
  { name: 'The inner planets', from: 0.3, to: 1.7, about: 'Four rocky worlds close to the Sun.' },
  { name: 'The asteroid belt', from: 1.7, to: 4, about: 'Rubble between Mars and Jupiter, and the near-Earth rocks that strayed from it.' },
  { name: 'The giant planets', from: 4, to: 31, about: 'Four giants and most of the Sun’s moons.' },
  { name: 'The Kuiper belt', from: 31, to: 100, about: 'Icy worlds past Neptune, among them most of the dwarf planets.' },
  { name: 'Far out', from: 100, to: 700, about: 'Worlds on long paths that reach far beyond the planets.' },
];
const inZone = (z: (typeof ZONES)[number]) => dots.filter((d) => d.au >= z.from && d.au < z.to).sort((a, b) => a.au - b.au);
const moonsOf = (id: string) => outlineWorlds.filter((b) => b.kind === 'moon' && b.parent === id);
const ticks = [0.5, 1, 2, 5, 10, 20, 50, 100, 200, 500];
const built = planets.length + 1, outlines = outlineWorlds.length;
---
<Reading title="Every world" path="/worlds" description={`Every world on the site, by distance from the Sun: ${built} with full pages and ${outlines} outline pages still being written.`}>
  <header class="w-head">
    <p class="label">Worlds</p>
    <h1>Every world, by distance from the Sun</h1>
    <p class="lead">The Sun and its eight planets have full pages. The larger moons, the dwarf planets and the asteroids and comets on the atlas have outline pages: their measured orbits and sizes now, the rest still being written.</p>
    <p class="w-key"><span class="k-built">Written</span> {built} pages <span class="k-out">Outline</span> {outlines} pages</p>
  </header>

  <figure class="w-scale" aria-label="Every world as a dot on a line from the Sun outwards; each step of the scale is a multiple of ten or of two.">
    <div class="w-line">
      <a class="w-sun" href="/sun" aria-label="The Sun"></a>
      {ticks.map((t) => <i style={`--x:${x(t)}`}><b>{t} au</b></i>)}
      {dots.map((d) => <a href={d.href} class:list={['w-dot', d.kind, { out: !d.built }]} style={`--x:${x(d.au)}`} title={`${d.name}, ${d.au.toFixed(d.au < 10 ? 2 : 0)} au`}><span>{d.built ? d.name : ''}</span></a>)}
    </div>
    <figcaption>Distance from the Sun, on a scale where each step is a multiple: the near worlds would otherwise be lost in the first sliver. One au is the Earth’s distance from the Sun. Solid dots have full pages; hollow ones have outlines.</figcaption>
  </figure>

  <div class="zones">
    {ZONES.map((z) => (
      <section class="zone" style={`--a:${x(z.from)};--b:${x(z.to)}`}>
        <h2>{z.name}</h2>
        <p class="z-range">{z.from < 1 ? z.from : Math.round(z.from)} to {z.to} au · {z.about}</p>
        <ul>
          {inZone(z).map((d) => (
            <li class:list={[{ out: !d.built }]}>
              <a href={d.href}>{d.name}</a>
              {d.kind === 'planet' && moonCount(d.id) > 0 && (
                <span class="z-moons">{moonCount(d.id)} known moon{moonCount(d.id) === 1 ? '' : 's'}{moonsOf(d.id).length > 0 && <>; outline{moonsOf(d.id).length === 1 ? '' : 's'} for {moonsOf(d.id).map((m, i) => <>{i > 0 && ', '}<a href={`/worlds/${m.id}`}>{m.name}</a></>)}</>}</span>
              )}
              {d.kind === 'dwarf' && moonsOf(d.id).length > 0 && <span class="z-moons">Its moon{moonsOf(d.id).length > 1 ? 's' : ''}: {moonsOf(d.id).map((m, i) => <>{i > 0 && ', '}<a href={`/worlds/${m.id}`}>{m.name}</a></>)}</span>}
              {!d.built && <span class="z-kind">{d.kind}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <p class="w-more">Further out still, the Oort cloud has no outline page yet; you can <a href="/explore?go=oort-cloud">fly out to it in 3D</a>. Stars have their own pages under <a href="/stars">Stars</a>.</p>
</Reading>

<style>
  .w-head { max-width: 48rem; margin-bottom: clamp(32px, 5vw, 56px); }
  .w-head h1 { font: 300 clamp(2.4rem, 5.5vw, 4.2rem)/1.04 var(--r-serif); margin: .6rem 0 1rem; text-wrap: balance; }
  .w-head .lead { font: 300 clamp(1.08rem, 1rem + .3vw, 1.25rem)/1.55 var(--r-serif); color: var(--ink-soft); margin: 0; }
  .w-key { display: flex; flex-wrap: wrap; gap: .6rem 1rem; align-items: center; margin: 1.4rem 0 0; font: 300 1rem/1 var(--r-serif); color: var(--ink-soft); }
  .k-built, .k-out { font: 400 .64rem/1 var(--r-mono); letter-spacing: .14em; text-transform: uppercase; padding: .4rem .55rem; border-radius: 2px; }
  .k-built { background: var(--accent); color: #0b0b0c; }
  .k-out { color: var(--accent); border: 1px dashed var(--accent); }
  .w-scale { margin: 0 0 clamp(40px, 6vw, 72px); }
  .w-line { position: relative; height: 7rem; margin: 0 12px 0 28px; border-bottom: 1px solid var(--rule); }
  .w-sun { position: absolute; left: -26px; bottom: -14px; width: 28px; height: 28px; border-radius: 50%; background: #f6d38e; box-shadow: 0 0 24px rgba(246,211,142,.7); }
  .w-line i { position: absolute; left: calc(var(--x) * 1%); bottom: -1.6rem; font-style: normal; }
  .w-line i b { position: absolute; transform: translateX(-50%); font: 400 .62rem/1 var(--r-mono); color: var(--ink-faint); white-space: nowrap; font-weight: 400; }
  .w-dot { position: absolute; left: calc(var(--x) * 1%); bottom: -5px; width: 9px; height: 9px; margin-left: -4.5px; border-radius: 50%; background: var(--accent); }
  .w-dot.out { background: #0b0b0c; border: 1px solid rgba(233,196,138,.75); width: 7px; height: 7px; margin-left: -3.5px; bottom: -4px; }
  .w-dot.planet { width: 13px; height: 13px; margin-left: -6.5px; bottom: -7px; }
  .w-dot span { position: absolute; bottom: 1.4rem; left: 50%; transform: translateX(-50%) rotate(-40deg); transform-origin: left bottom; font: 400 .95rem/1 var(--r-serif); color: var(--ink); white-space: nowrap; }
  .w-dot:hover { background: #ece7dc; }
  .w-scale figcaption { font: 300 .9rem/1.5 var(--r-serif); color: var(--ink-faint); margin-top: 2.6rem; max-width: 44rem; }
  .zones { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 2rem; border-top: 1px solid var(--rule); padding-top: 1.6rem; }
  .zone h2 { font: 400 1.25rem/1.2 var(--r-serif); margin: 0 0 .4rem; }
  .z-range { font: 300 .88rem/1.45 var(--r-serif); color: var(--ink-faint); margin: 0 0 1rem; }
  .zone ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
  .zone li > a { font: 400 1.04rem/1.3 var(--r-serif); text-decoration: none; }
  .zone li.out > a { color: var(--ink-soft); border-bottom: 1px dashed rgba(233,196,138,.45); }
  .z-moons { display: block; font: 300 .86rem/1.45 var(--r-serif); color: var(--ink-faint); margin-top: .2rem; }
  .z-moons a { color: var(--ink-soft); }
  .z-kind { margin-left: .4rem; font: 400 .58rem/1 var(--r-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); }
  .w-more { font: 300 1rem/1.5 var(--r-serif); color: var(--ink-faint); margin-top: 2.4rem; }
  @media (max-width: 1100px) { .zones { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .zones { grid-template-columns: minmax(0, 1fr); } .w-dot span { display: none; } .w-line { height: 3rem; } .w-line i:nth-child(odd) b { display: none; } }
</style>
