---
// Every world the site knows, set out by distance from the Sun, one region at a time. Each region has its own
// scale, so no two labels share a space; every figure is measured (JPL orbits and radii, the JPL satellite
// list) or worked out from those (light travel time, length of the year). Worlds with a full page are solid dots;
// the rest have outline pages built from the same measured data.
import Reading from '../../layouts/Reading.astro';
import { outlineWorlds, IAU_DWARFS, PLANET_PAGES, sunAu, AU_KM, kindName, why } from '../../lib/worlds';
import { body, smallSpread, smallFetched } from '../../data/bodies/index';
import { moonCount, MOONS_AS_OF_TEXT } from '../../data/moon-counts';
import facts from '../../data/facts.json';
import { WORLD_PAGES } from '../../data/world-pages';
const written = (id: string) => !!WORLD_PAGES[id];

const radius = (b: { meanRadiusKm?: number; radiiKm?: [number, number, number] }) => b.meanRadiusKm ?? (b.radiiKm ? Math.cbrt(b.radiiKm[0] * b.radiiKm[1] * b.radiiKm[2]) : undefined);
const ECC: Record<string, number> = Object.fromEntries(Object.entries((facts as unknown as { planets: Record<string, { physical: { eccentricity: number } }> }).planets).map(([k, v]) => [k, v.physical.eccentricity]));
const LIGHT_S = 499.004784; // seconds light takes to cross one au
const fmtAu = (a: number) => (a < 10 ? a.toFixed(2) : a < 100 ? a.toFixed(1) : Math.round(a).toLocaleString('en-GB'));
const fmtLight = (au: number) => { const s = au * LIGHT_S; return s < 7200 ? `${s < 600 ? (s / 60).toFixed(1) : Math.round(s / 60)} min` : s < 172800 ? `${(s / 3600).toFixed(1)} hr` : `${(s / 86400).toFixed(1)} days`; };
const fmtYear = (au: number) => { const d = 365.25 * au ** 1.5; if (d < 1000) return `${Math.round(d)} days`; const y = d / 365.25; return `${y < 10 ? y.toFixed(1) : y < 1000 ? Math.round(y) : (Math.round(y / 10) * 10).toLocaleString('en-GB')} yr`; };
const fmtKm = (r: number) => r < 1 ? `${Math.round(r * 1000)} m` : `${r < 10 ? r.toFixed(1) : Math.round(r).toLocaleString('en-GB')} km`;
const moonsOf = (id: string) => outlineWorlds.filter((b) => b.kind === 'moon' && b.parent === id)
  .sort((a, b) => ((a.orbit as { aKm: number }).aKm) - ((b.orbit as { aKm: number }).aKm));

type Row = { id: string; name: string; href: string; solid: boolean; kind: string; a: number; q: number; Q: number; r?: number; d: number; note?: string; total: number; moons: { id: string; name: string; w: boolean }[]; planet: boolean };
const rows: Row[] = [];
for (const id of PLANET_PAGES.filter((p) => p !== 'sun')) {
  const b = body(id)!, a = sunAu(b), e = ECC[id] ?? 0, r = radius(b);
  rows.push({ id, name: b.name, href: `/${id}`, solid: true, kind: 'Planet', a, q: a * (1 - e), Q: a * (1 + e), r, d: Math.round(6 + Math.sqrt(r ?? 3000) / 16), total: moonCount(id), moons: moonsOf(id).map((m) => ({ id: m.id, name: m.name, w: written(m.id) })), planet: true });
}
for (const b of outlineWorlds.filter((w) => w.kind !== 'moon')) {
  const o = b.orbit as { aKm: number; e: number }, a = o.aKm / AU_KM, r = radius(b);
  rows.push({ id: b.id, name: b.name, href: `/worlds/${b.id}`, solid: written(b.id), kind: kindName(b), a, q: a * (1 - o.e), Q: a * (1 + o.e), r, d: r ? Math.round(Math.min(12, 5 + Math.sqrt(r) / 3.5)) : 5, note: why(b.id)?.why, total: moonCount(b.id), moons: moonsOf(b.id).map((m) => ({ id: m.id, name: m.name, w: written(m.id) })), planet: false });
}
rows.sort((p, q) => p.a - q.a);

// Where each zone starts and ends is only for sorting worlds into regions; the axes are drawn per region.
type Zone = { id: string; name: string; from: number; to: number; min: number; max: number; ticks: number[]; about: string; rows: Row[] };
const range = (lo: number, hi: number) => { const r = rows.filter((w) => w.a >= lo && w.a < hi); return r; };
const near = range(0, 2), belt = range(2, 4.5), giants = range(4.5, 31), kuiper = range(31, 100), far = range(100, 1e6);
const lt = (au: number) => fmtLight(au);
const ZONES: Zone[] = [
  { id: 'inner', name: 'Inner planets', from: 0.3, to: 2, min: 0, max: 2.4, ticks: [0.5, 1, 1.5, 2], rows: near,
    about: `Four rocky planets, and the small rocks that wander in among them. Sunlight reaches Mercury in ${lt(rows[0].a)} and Mars in ${lt(rows.find((w) => w.id === 'mars')!.a)}.` },
  { id: 'belt', name: 'Asteroid belt', from: 2, to: 4.5, min: 1.5, max: 5.5, ticks: [2, 3, 4, 5], rows: belt,
    about: 'The rubble between Mars and Jupiter, and the short-period comets whose paths bring them into it. Jupiter’s pull has swept some orbits almost clear; the gaps show in the count below.' },
  { id: 'giants', name: 'Giant planets', from: 4.5, to: 31, min: 4, max: 36, ticks: [5, 10, 15, 20, 25, 30, 35], rows: giants,
    about: `Jupiter, Saturn, Uranus and Neptune, with nearly all of the Sun’s known moons. Sunlight takes ${lt(rows.find((w) => w.id === 'jupiter')!.a)} to reach Jupiter and ${lt(rows.find((w) => w.id === 'neptune')!.a)} to reach Neptune.` },
  { id: 'kuiper', name: 'Kuiper belt', from: 31, to: 100, min: 28, max: 100, ticks: [30, 40, 50, 60, 70, 80, 90, 100], rows: kuiper,
    about: 'Icy worlds beyond Neptune, among them Pluto and most of the other dwarf planets. Many keep time with Neptune: they go round twice for every three of its orbits, or once for every two.' },
  { id: 'far', name: 'Far out', from: 100, to: 1100, min: 0, max: 1100, ticks: [200, 400, 600, 800, 1000], rows: far,
    about: 'Past the Kuiper belt only a few bodies are known, on long stretched paths. Sunlight takes days, not hours, to reach the far end of Sedna’s.' },
];
const pct = (z: Zone, au: number) => Math.min(100, Math.max(0, ((au - z.min) / (z.max - z.min)) * 100));

// the overview strip: every region on one scale where each step is a multiple
const LO = Math.log10(0.3), HI = Math.log10(1100);
const lx = (au: number) => ((Math.log10(Math.min(1100, Math.max(0.3, au))) - LO) / (HI - LO)) * 100;
const ovTicks = [0.5, 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000];
const planetRows = rows.filter((r) => r.planet);

// What a region's chart shows: the count of asteroid orbits by size (belt), and of the far objects (Kuiper belt)
type Spread = { fromAu: number; toAu: number; stepAu: number; counts: number[] };
const histPath = (s: Spread) => { const m = Math.max(...s.counts), n = s.counts.length; return `M0 60 ` + s.counts.map((c, i) => `L${((i + 0.5) / n * 400).toFixed(1)} ${(60 - (c / m) * 56).toFixed(1)}`).join(' ') + ` L400 60 Z`; };
const sum = (s: Spread) => s.counts.reduce((p, c) => p + c, 0);
const inner = smallSpread.inner as Spread, outer = smallSpread.outer as Spread;
const FETCHED = new Date(smallFetched + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const JUP = 5.2029, NEP = 30.07;
const res = (a: number, p: number, q: number) => a * (q / p) ** (2 / 3); // size of the orbit of a body that goes round p times while the planet goes round q times
const beltMarks = [{ t: '3:1', au: res(JUP, 3, 1), hi: 0 }, { t: '5:2', au: res(JUP, 5, 2), hi: 1 }, { t: '2:1', au: res(JUP, 2, 1), hi: 0 }, { t: '3:2', au: res(JUP, 3, 2), hi: 1 }];
const kuiperMarks = [{ t: 'Plutinos', au: res(NEP, 2, 3), hi: 0 }, { t: 'Twotinos', au: res(NEP, 1, 2), hi: 0 }];
---
<Reading title="The Solar System" path="/worlds" description="Every planet, moon, dwarf planet, asteroid and comet on the site, set out by its distance from the Sun, region by region, with the measured numbers for each.">
  <header class="w-head">
    <h1>The Solar System, by distance from the Sun</h1>
    <p class="lead">Five regions, each drawn on its own scale so that nothing crowds. For every world: how far it is from the Sun, how long light takes to cross that gap, how long its year is and how big it is. Solid dots have a full page; hollow ones have an outline built from their measured numbers.</p>
  </header>

  <figure class="ov" aria-label="The five regions of the Solar System on one scale of distance from the Sun, where each step is a multiple: inner planets, asteroid belt, giant planets, Kuiper belt and far out.">
    <div class="ov-strip" aria-hidden="true">
      {ZONES.map((z, i) => <i class:list={['ov-z', { alt: i % 2 }]} style={`--a:${lx(z.from)};--b:${lx(z.to)}`}><span>{z.name}</span></i>)}
      {planetRows.map((p) => <b class="ov-p" style={`--x:${lx(p.a)}`} />)}
      <u class="ov-sun" />
    </div>
    <div class="ov-ticks" aria-hidden="true">{ovTicks.map((t) => <i class:list={[{ odd: [0.5, 2, 20, 200].includes(t) }]} style={`--x:${lx(t)}`}><b>{t.toLocaleString('en-GB')}</b></i>)}<em>au</em></div>
    <figcaption>Distance from the Sun on one scale where each step is a multiple: 1 to 10 au takes as much room as 10 to 100. One au is the Earth’s distance from the Sun. The small dots are the eight planets.</figcaption>
    <ol class="ov-nav">
      {ZONES.map((z) => (
        <li><a href={`#${z.id}`}><span class="n">{z.name}</span><span class="r">{z.id === 'far' ? 'beyond 100 au' : `${z.from} to ${z.to} au`}</span></a></li>
      ))}
    </ol>
  </figure>

  {ZONES.map((z) => (
    <section class="z" id={z.id} aria-labelledby={`${z.id}-h`}>
      <header class="z-head">
        <h2 id={`${z.id}-h`}>{z.name}</h2>
        <p class="z-about">{z.about}</p>
      </header>
      <div class="zbox">
        <div class="zgrid" aria-hidden="true"><div class="t">{z.ticks.map((t) => <i style={`--x:${pct(z, t)}`} />)}</div></div>
        <div class="zrow zaxis" aria-hidden="true">
          <span class="who">World</span>
          <div class="ch"><div class="t">{z.ticks.map((t) => <i style={`--x:${pct(z, t)}`}><b>{t.toLocaleString('en-GB')}{z.id === 'far' && <small>{fmtLight(t)}</small>}</b></i>)}<em>au</em></div></div>
          <span class="fg-h">Measured, or worked out from the orbit</span>
        </div>

        {z.id === 'belt' && (
          <div class="zrow zhist">
            <div class="who"><strong>Orbits counted</strong><span>By the size of the orbit, in steps of {inner.stepAu} au</span></div>
            <div class="ch">
              <div class="t">
                <div class="marks">{beltMarks.map((m) => <span class:list={[{ hi: m.hi }]} style={`--x:${pct(z, m.au)}`}>{m.t}</span>)}</div>
                <svg viewBox="0 0 400 60" preserveAspectRatio="none" role="img" aria-label={`Known asteroids by orbit size, from ${inner.fromAu} to ${inner.toAu} au: most lie between 2 and 3.3 au, with gaps at 2.5, 2.8 and 3.3 au where Jupiter’s pull has cleared the orbits.`}><path d={histPath(inner)} />{beltMarks.map((m) => <line x1={(m.au - inner.fromAu) / (inner.toAu - inner.fromAu) * 400} x2={(m.au - inner.fromAu) / (inner.toAu - inner.fromAu) * 400} y1="0" y2="60" />)}</svg>
              </div>
            </div>
            <p class="fg-note">{sum(inner).toLocaleString('en-GB')} asteroid orbits, JPL Small-Body Database, {FETCHED}. Marks: an orbit of that size goes round 3 times (3:1) while Jupiter goes round once.</p>
          </div>
        )}
        {z.id === 'kuiper' && (
          <div class="zrow zhist">
            <div class="who"><strong>Orbits counted</strong><span>By the size of the orbit, in steps of {outer.stepAu} au</span></div>
            <div class="ch">
              <div class="t">
                <div class="marks">{kuiperMarks.map((m, i) => <span class:list={[{ hi: i % 2 }]} style={`--x:${pct(z, m.au)}`}>{m.t}</span>)}</div>
                <svg viewBox="0 0 400 60" preserveAspectRatio="none" style={`width:${(outer.toAu - outer.fromAu) / (z.max - z.min) * 100}%;margin-left:${pct(z, outer.fromAu)}%`} role="img" aria-label={`Known objects beyond Neptune by orbit size, from ${outer.fromAu} to ${outer.toAu} au, bunched around 39 and 44 au.`}><path d={histPath(outer)} /></svg>
                {kuiperMarks.map((m) => <i class="mk" style={`--x:${pct(z, m.au)}`} />)}
              </div>
            </div>
            <p class="fg-note">{sum(outer).toLocaleString('en-GB')} objects with orbits between {outer.fromAu} and {outer.toAu} au, JPL Small-Body Database, {FETCHED}. Counted only to {outer.toAu} au.</p>
          </div>
        )}

        <ol class="zrows">
          {z.rows.map((r) => {
            const x = (au: number) => pct(z, au).toFixed(2);
            const cut = r.Q > z.max, cutl = r.q < z.min;
            return (
              <li class:list={['zrow', 'wrow', { cut, cutl }]} style={`--q:${x(Math.max(r.q, z.min))};--Q:${cut ? 100 : x(r.Q)};--a:${x(r.a)};--d:${r.d}px`}>
                <div class="who">
                  <a class="nm" href={r.href}>{r.name}</a>
                  <span class="kd">{r.kind}</span>{!r.planet && <span class="kd">{fmtAu(r.q)}–{fmtAu(r.Q)} au</span>}
                </div>
                <div class="ch" aria-hidden="true"><div class="t">{z.ticks.map((t) => <i class="tk" style={`--x:${pct(z, t)}`} />)}<span class="rg" /><span class:list={['dt', { solid: r.solid }]} /></div></div>
                <dl class="fg">
                  <div><dt>Distance</dt><dd>{fmtAu(r.a)} au</dd></div>
                  <div><dt>Light</dt><dd>{fmtLight(r.a)}</dd></div>
                  <div><dt>Year</dt><dd>{fmtYear(r.a)}</dd></div>
                  {r.r ? <div><dt>Radius</dt><dd>{fmtKm(r.r)}</dd></div> : null}
                </dl>
                {(r.note || r.total > 0) && (
                  <div class="more">
                    {r.note && <p class="nt">{r.note}</p>}
                    {r.total > 0 && <p class="mo"><span>{r.total.toLocaleString('en-GB')} known {r.total === 1 ? 'moon' : 'moons'}.</span>{r.moons.length > 0 && <> {r.moons.length === r.total ? 'With pages:' : 'With their own pages:'} {r.moons.map((m, i) => <>{i > 0 && ', '}<a class:list={[{ w: m.w }]} href={`/worlds/${m.id}`}>{m.name}</a></>)}.</>}</p>}
                  </div>
                )}
              </li>
            );
          })}
        </ol>
      </div>
      {z.id === 'far' && <p class="z-after">Beyond Sedna’s path, the Oort cloud is thought to wrap the whole Solar System in a thin shell of icy bodies, too far and too faint to have been mapped. You can <a href="/explore?go=oort-cloud">fly out to it in 3D</a>.</p>}
    </section>
  ))}

  <p class="w-more">Orbit sizes and radii: NASA/JPL Solar System Dynamics and the JPL Small-Body Database. Moon counts: JPL’s list of planetary satellites, read on {MOONS_AS_OF_TEXT}. Light time and year length are worked out from the distance. Each line runs from a world’s nearest point to the Sun to its farthest, with the dot at its average distance; a line that runs off the edge of its chart carries on. Stars have their own pages under <a href="/stars">Stars</a>.</p>
</Reading>

<style>
  .w-head { max-width: 52rem; margin-bottom: clamp(24px, 3.5vw, 40px); }
  .w-head h1 { font: 300 clamp(1.8rem, 3.2vw, 2.6rem)/1.1 var(--r-serif); margin: 0 0 .9rem; text-wrap: balance; }
  .w-head .lead { font: 300 clamp(1.08rem, 1rem + .3vw, 1.25rem)/1.55 var(--r-serif); color: var(--ink-soft); margin: 0; }
  .ov-nav a, .who a, .more .mo a { text-decoration: none; }

  /* the overview: the whole range on one scale */
  .ov { margin: 0 0 clamp(36px, 5vw, 64px); }
  .ov-strip { position: relative; height: 3.4rem; border-bottom: 1px solid var(--rule); }
  .ov-z { position: absolute; top: 0; bottom: 0; left: calc(var(--a) * 1%); width: calc((var(--b) - var(--a)) * 1%); background: rgba(233,196,138,.07); border-left: 1px solid rgba(236,231,220,.16); }
  .ov-z.alt { background: rgba(233,196,138,.13); }
  .ov-z span { position: absolute; left: .6rem; top: .55rem; font: 400 .95rem/1.2 var(--r-serif); color: var(--ink-soft); white-space: nowrap; }
  .ov-p { position: absolute; bottom: -4px; left: calc(var(--x) * 1%); width: 8px; height: 8px; margin-left: -4px; border-radius: 50%; background: var(--accent); }
  .ov-sun { position: absolute; left: -.9rem; bottom: -.9rem; width: 1.8rem; height: 1.8rem; border-radius: 50%; background: #f6d38e; box-shadow: 0 0 26px rgba(246,211,142,.55); }
  .ov-ticks { position: relative; height: 1.6rem; margin-top: .5rem; }
  .ov-ticks i { position: absolute; left: calc(var(--x) * 1%); font-style: normal; }
  .ov-ticks b { position: absolute; transform: translateX(-50%); font: 400 .8125rem/1 var(--r-mono); color: var(--ink-faint); white-space: nowrap; }
  .ov-ticks em { position: absolute; right: 0; top: 1.15rem; font: 400 .8125rem/1 var(--r-mono); color: var(--ink-faint); font-style: normal; }
  .ov figcaption { font: 300 .95rem/1.5 var(--r-serif); color: var(--ink-faint); max-width: 44rem; margin: 1rem 0 1.4rem; }
  .ov-nav { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--rule); }
  .ov-nav li { border-left: 1px solid var(--rule); }
  .ov-nav li:first-child { border-left: 0; }
  .ov-nav a { display: block; padding: .9rem 1rem .9rem 1rem; min-height: 24px; }
  .ov-nav li:first-child a { padding-left: 0; }
  .ov-nav .n { display: block; font: 400 1.1rem/1.2 var(--r-serif); color: var(--ink); }
  .ov-nav .r { display: block; margin-top: .3rem; font: 400 .8125rem/1.3 var(--r-mono); color: var(--ink-faint); }
  .ov-nav a:hover .n { color: var(--accent); }

  /* each region */
  .z { margin: 0 0 clamp(40px, 6vw, 72px); scroll-margin-top: 5rem; }
  .z-head { display: grid; grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); gap: 1rem 2.5rem; align-items: baseline; margin-bottom: 1.1rem; }
  .z-head h2 { font: 300 clamp(1.5rem, 2.4vw, 1.9rem)/1.1 var(--r-serif); margin: 0; }
  .z-about { font: 300 1.05rem/1.55 var(--r-serif); color: var(--ink-soft); margin: 0; max-width: 40rem; }
  .z-after { font: 300 1rem/1.55 var(--r-serif); color: var(--ink-faint); margin: 1.2rem 0 0; max-width: 44rem; }
  .zbox { position: relative; --who: 12rem; --fg: 24rem; border-top: 1px solid var(--rule); background: linear-gradient(rgba(236,231,220,.02), transparent 40%); }
  .zrows { list-style: none; margin: 0; padding: 0; }
  .zrow { display: grid; grid-template-columns: var(--who) minmax(0, 1fr) var(--fg); align-items: center; column-gap: 0; }
  .zrow .t { position: absolute; inset: 0 1rem; }
  .ch { position: relative; align-self: stretch; min-height: 3.2rem; }
  .zgrid { position: absolute; top: 0; bottom: 0; left: var(--who); right: var(--fg); pointer-events: none; }
  .zgrid .t { position: absolute; inset: 0 1rem; }
  .zgrid i { position: absolute; top: 0; bottom: 0; left: calc(var(--x) * 1%); width: 1px; background: rgba(236,231,220,.07); }
  .zaxis { min-height: 2.2rem; border-bottom: 1px solid var(--rule); }
  .zaxis .ch { min-height: 2.2rem; }
  .zaxis .who, .zaxis .fg-h { font: 400 .8125rem/1.3 var(--r-mono); color: var(--ink-faint); padding: 0 .75rem 0 1rem; }
  .zaxis .fg-h { padding-left: 1rem; }
  .zaxis .t i { position: absolute; left: calc(var(--x) * 1%); top: 0; bottom: 0; font-style: normal; }
  .zaxis .t b { position: absolute; top: .65rem; transform: translateX(-50%); font: 400 .8125rem/1 var(--r-mono); color: var(--ink-faint); white-space: nowrap; }
  #far .zaxis, #far .zaxis .ch { min-height: 3.2rem; }
  .zaxis .t b small { display: block; margin-top: .3rem; font: 400 .8125rem/1 var(--r-mono); color: var(--ink-faint); opacity: .85; }
  .zaxis .t em { position: absolute; right: -.9rem; top: .15rem; font: 400 .8125rem/1 var(--r-mono); color: var(--ink-faint); font-style: normal; display: none; }

  .wrow { border-top: 1px solid rgba(236,231,220,.08); padding: .5rem 0 .55rem; grid-template-areas: "who ch fg" "more more more"; }
  .wrow > .who { grid-area: who; padding: 0 .75rem 0 1rem; }
  .wrow > .ch { grid-area: ch; }
  .wrow > .fg { grid-area: fg; }
  .wrow > .more { grid-area: more; }
  .zaxis + .zrows, .zaxis + .zhist { }
  .who .nm { display: block; font: 400 1.1rem/1.25 var(--r-serif); color: var(--ink); }
  .who .nm:hover { color: var(--accent); }
  .who .kd { display: block; margin-top: .15rem; font: 400 .8125rem/1.35 var(--r-mono); color: var(--ink-faint); }
  .tk { display: none; }
  .rg { position: absolute; top: 50%; height: 1px; left: calc(var(--q) * 1%); width: calc((var(--Q) - var(--q)) * 1%); background: rgba(233,196,138,.5); }
  .rg::before, .rg::after { content: ''; position: absolute; top: -3px; width: 1px; height: 7px; background: rgba(233,196,138,.5); }
  .rg::before { left: 0; } .rg::after { right: 0; }
  .cut .rg { width: calc((100 - var(--q)) * 1% + .9rem); background: linear-gradient(90deg, rgba(233,196,138,.5) 80%, transparent); }
  .cut .rg::after { display: none; }
  .cutl .rg { left: 0; width: calc(var(--Q) * 1% + .0rem); background: linear-gradient(90deg, transparent, rgba(233,196,138,.5) 20%); }
  .cutl .rg::before { display: none; }
  .cutl.cut .rg { width: 100%; background: linear-gradient(90deg, transparent, rgba(233,196,138,.5) 12%, rgba(233,196,138,.5) 85%, transparent); }
  .dt { position: absolute; top: 50%; left: calc(var(--a) * 1%); width: var(--d); height: var(--d); margin: calc(var(--d) / -2) 0 0 calc(var(--d) / -2); border-radius: 50%; border: 1px solid rgba(233,196,138,.95); background: #0b0b0c; box-sizing: border-box; }
