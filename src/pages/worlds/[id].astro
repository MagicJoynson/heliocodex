---
// An outline page for one world: a moon, dwarf planet, asteroid or comet that has no full page yet.
// Everything shown is measured data from src/data/bodies; the chapters to come are headings only.
import Reading from '../../layouts/Reading.astro';
import { outlineWorlds, kindName, CHAPTERS, nameOf, why, AU_KM, PLANET_PAGES } from '../../lib/worlds';
import { body } from '../../data/bodies/index';
import { plates } from '../../lib/v2/atlas/plates';
import { fmt } from '../../lib/format';
import type { Body } from '../../lib/v2/atlas/types';
import { WORLD_PAGES } from '../../data/world-pages';
import { allLessons, allFacts } from '../../lib/v2/margin/content';
import { goFor, lessonsAbout } from '../../lib/objects';
import { sheet, head, ratio, sig, type Cell } from '../../lib/record';
import { SHOW_OUTLINES } from '../../lib/site';
import { sunAu } from '../../lib/worlds';
import '../../styles/record.css';

export function getStaticPaths() {
  return outlineWorlds.map((b) => ({ params: { id: b.id } }));
}
const { id } = Astro.params as { id: string };
const b = body(id)! as Body;
const page = WORLD_PAGES[id];
const midName = b.name.replace(/^The /, 'the ');
const o = b.orbit as { aKm: number; e: number; iDeg: number; periodDays?: number };
const parent = b.parent ? body(b.parent) : null;
const round = b.parent === 'sun';
const aAu = o.aKm / AU_KM;
const periodDays = o.periodDays ?? 365.25 * Math.pow(aAu, 1.5);
const periodSays = periodDays < 2 ? `${fmt(periodDays * 24, 2)} hours` : periodDays < 800 ? `${fmt(periodDays, 3)} days` : `${fmt(periodDays / 365.25, 3)} years`;
const outSays = round ? `${fmt(aAu, 3)} au from the Sun on average` : `${fmt(o.aKm)} km from ${nameOf(b.parent)} on average`;
const MOON_KM = 1737.4;
const sizeSays = b.meanRadiusKm ? `${fmt(b.meanRadiusKm * 2)} km across${b.kind === 'moon' && b.id !== 'moon' ? `, ${fmt((b.meanRadiusKm / MOON_KM) * 100, 2)} per cent of our Moon’s width` : ''}` : 'Size not well measured';
const kindLine = b.kind === 'moon' ? `Moon of ${nameOf(b.parent)}` : kindName(b);
const parentHref = b.parent && PLANET_PAGES.includes(b.parent) ? `/${b.parent}` : b.parent && b.parent !== 'sun' ? `/worlds/${b.parent}` : null;
const chart = b.kind === 'moon' && b.parent && (plates as Record<string, unknown>)[b.parent] ? `/atlas/${b.parent}` : b.kind === 'dwarf' && (plates as Record<string, unknown>)[b.id] ? `/atlas/${b.id}` : b.kind === 'asteroid' || b.kind === 'comet' ? '/atlas/small-bodies' : b.kind === 'dwarf' ? '/atlas/solar-system' : null;
const note = why(b.id);
// the search snippet uses only measured figures from the record, trimmed to fit
// the data files call Arrokoth an asteroid; it is a Kuiper belt object, so the search text says so
const metaKind = b.id === 'arrokoth' ? 'Kuiper belt object' : kindLine;
const lowerKind = metaKind.replace(/^[A-Z](?!uiper)/, (c) => c.toLowerCase());
// a long list of discoverers (the Pluto moons have nine) would stretch one cell: give the first name and the count
const byShort = (by: string) => { const n = by.split(', '); return !by.includes('(') && n.length > 3 ? `${n[0]} and ${n.length - 1} others` : by; };
const metaParts = [`${b.name} is ${/^[AEIOU]/.test(metaKind) ? 'an' : 'a'} ${lowerKind}.`, `${outSays.charAt(0).toUpperCase()}${outSays.slice(1)}, once round in ${periodSays}.`, b.meanRadiusKm ? `${fmt(b.meanRadiusKm * 2)} km across.` : '', b.discovered ? `Found in ${b.discovered.year}.` : ''].filter(Boolean);
let metaDesc = '';
for (const part of metaParts) if ((metaDesc + ' ' + part).trim().length <= 158) metaDesc = (metaDesc + ' ' + part).trim();
metaDesc = metaDesc.replace(/the Earth/g, 'Earth');
const rows: [string, string][] = [
  ['Kind', kindLine],
  ['Distance', outSays],
  ['Once round', periodSays],
  ['Path', `${o.e < 0.02 ? 'very nearly a circle' : o.e < 0.2 ? 'a slightly stretched circle' : 'a long oval'} (eccentricity ${fmt(o.e, 2)}), ${(b as { orientationUnknown?: boolean }).orientationUnknown ? 'tilt not known' : o.iDeg < 0.1 ? 'with almost no tilt' : `tilted ${fmt(o.iDeg, 2)}°`}`],
  ['Size', sizeSays],
  ...(b.densityGcm3 ? [['Density', `${fmt(b.densityGcm3, 2)} times water`] as [string, string]] : []),
  ...(b.discovered ? [['Found', `${b.discovered.year}, by ${byShort(b.discovered.by)}`] as [string, string]] : []),
];
// the data sheet: the same quantities in the same places as every other record
const EARTH_KM = 12742, EARTH_KG = 5.972e24;
const dKm = b.meanRadiusKm ? b.meanRadiusKm * 2 : null;
const massKg = b.gmKm3S2 ? b.gmKm3S2 / 6.6743e-20 : null;
const sup = (n: number) => `<sup>${String(n).replace('-', '−')}</sup>`;
const parentName = nameOf(b.parent).replace(/^the /, 'the ');
const pathWords = `${o.e < 0.02 ? 'very nearly a circle' : o.e < 0.2 ? 'a slightly stretched circle' : 'a long oval'}, ${(b as { orientationUnknown?: boolean }).orientationUnknown ? 'tilt not known' : o.iDeg < 0.1 ? 'with almost no tilt' : `tilted ${fmt(o.iDeg, 2)}°`}`;
const cells: Cell[] = [
  round
    ? { key: 'distance', label: 'From the Sun', value: fmt(aAu, aAu < 10 ? 2 : 1), unit: 'au on average', note: `From ${fmt(o.aKm * (1 - o.e) / AU_KM, 2)} to ${fmt(o.aKm * (1 + o.e) / AU_KM, 2)} au. One au is the Earth’s distance.` }
    : { key: 'distance', label: `From ${parentName.replace(/^the /, 'the ')}`, value: fmt(o.aKm), unit: 'km on average', note: `${parentName.replace(/^the /, 'The ').replace(/^./, (c) => c.toUpperCase())} is ${fmt(sunAu(b), 2)} au from the Sun.` },
  ...(dKm ? [{ key: 'size', label: 'Size', value: fmt(dKm), unit: 'km across', note: `${ratio(dKm / EARTH_KM, 'the Earth’s width')}.` } as Cell] : []),
  ...(page?.temperature ? [{ key: 'temperature', label: 'Temperature', value: page.temperature.value, note: page.temperature.note } as Cell] : []),
  ...(massKg ? [(() => { const ex = Math.floor(Math.log10(massKg)); return { key: 'mass', label: 'Mass', value: `${(massKg / 10 ** ex).toFixed(2)} × 10${sup(ex)}`, unit: 'kg', note: `${ratio(massKg / EARTH_KG, 'the Earth’s')}.` } as Cell; })()] : []),
  { key: 'orbit', label: 'Once round', value: periodSays.split(' ')[0], unit: `${periodSays.split(' ')[1]}, round ${round ? 'the Sun' : parentName}`, note: `Its path is ${pathWords}.` },
  ...(b.densityGcm3 ? [{ key: 'density', label: 'Density', value: fmt(b.densityGcm3, 2), unit: 'times water', note: b.densityGcm3 < 0.92 ? 'Less dense than solid ice, so it must be full of empty space.' : b.densityGcm3 < 2.2 ? 'Light enough to be roughly half ice.' : b.densityGcm3 > 3 ? 'Dense enough to be mostly rock and metal.' : undefined } as Cell] : []),
  ...(b.discovered ? [{ key: 'found', label: 'Found', value: String(b.discovered.year), note: `By ${byShort(b.discovered.by)}.` } as Cell] : []),
];
const crumbs: [string, string][] = [['Solar System', '/worlds'], ...(b.parent && b.parent !== 'sun' ? [[nameOf(b.parent).replace(/^the /, 'The '), parentHref ?? '/worlds'] as [string, string]] : [])];
const headHtml = head({ crumbs, name: b.name, kind: kindLine, lead: page?.lead ?? note?.why, badge: !page && SHOW_OUTLINES ? 'Outline: the numbers are measured; the rest is being written' : undefined });
// the drawing: the path to scale and filling its frame, with what it goes round at one focus. Round the Sun,
// the planets' paths that fit inside it are drawn as faint named rings; round a planet, its disc to scale.
const W = 600, PAD = 34;
const Q = o.aKm * (1 + o.e), q = o.aKm * (1 - o.e), bKm = o.aKm * Math.sqrt(1 - o.e * o.e);
const pR = !round && parent?.meanRadiusKm ? parent.meanRadiusKm : 0;
const spanKm = Q + Math.max(q, pR);
const k = (W - 2 * PAD) / spanKm;
const H = Math.round(Math.min(W, Math.max(230, 2 * Math.max(bKm, pR) * k + 2 * PAD + 20)));
const fx = PAD + Q * k, fy = H / 2; // the focus: the Sun or the parent
const ecx = fx - o.aKm * o.e * k, erx = o.aKm * k, ery = bKm * k;
const PLANET_AU: [string, number][] = [['Mercury', 0.387], ['Venus', 0.723], ['Earth', 1], ['Mars', 1.524], ['Jupiter', 5.203], ['Saturn', 9.537], ['Uranus', 19.19], ['Neptune', 30.07]];
const rings = round ? PLANET_AU.filter(([, au]) => au * AU_KM <= Q * 1.02).map(([name, au]) => ({ name, r: au * AU_KM * k, crosses: au * AU_KM > q })) : [];
// each ring is named just below the comet's or asteroid's own path, where nothing else is drawn
const ly = fy + ery + 16;
let lastX = -Infinity;
const ringLabels = [...rings].sort((m, n) => n.r - m.r).filter((g) => g.r > ery + 18 && ly < H - 4).map((g) => ({ ...g, x: fx - Math.sqrt(g.r * g.r - (ly - fy) ** 2) }))
  .filter((g) => { const w = g.name.length * 7.4 + 10; if (g.x - w / 2 < 2 || g.x - w / 2 < lastX) return false; lastX = g.x + w / 2; return true; });
const crossed = rings.filter((g) => g.crosses).map((g) => g.name);
const uncrossed = rings.filter((g) => !g.crosses).map((g) => g.name);
const and = (l: string[]) => l.map((n) => (n === 'Earth' ? 'the Earth' : n)).join(', ').replace(/, ([^,]*)$/, ' and $1');
const pDraw = pR * k;
// size drawing for moons: the moon beside our Moon, and the edge of its planet, all to one scale
const isMoon = b.kind === 'moon' && !!b.meanRadiusKm;
const rMe = b.meanRadiusKm ?? 0;
const cmp = b.id === 'moon' ? null : MOON_KM;
const sk = 70 / Math.max(rMe, cmp ?? 0, b.id === 'moon' ? MOON_KM : 0);
const SH = 230, scy = 100;
const parR = (parent?.meanRadiusKm ?? 0) * sk;
const parEdge = parR > 150 ? 150 : 30 + 2 * parR;
const parCx = parEdge - parR;
const meR = Math.max(1.2, rMe * sk), meCx = parEdge + 50 + meR;
const moonR = cmp ? cmp * sk : 0, moonCx = meCx + meR + 50 + moonR;
// the record leads with the whole world; a close view moves into the first chapter
const go = goFor(b);
const related = lessonsAbout(await allLessons(), b.id, b.name.replace(/^The /, ''), 2, await allFacts());
const lead = page ? (page.globe ?? page.picture ?? null) : null;
const closeup = page?.globe ? (page.picture ?? null) : null;
// a body that is not a moon is drawn beside our Moon when it is big enough to compare, and beside a named length when it is not
const sized = !isMoon && rMe > 0;
const bigOne = sized && rMe >= 100;
const D2 = rMe * 2;
const REF = D2 < 1.5 ? { name: 'The Shard, 310 m tall', km: 0.31, up: true } : D2 < 20 ? { name: 'Mount Everest, 8.8 km high', km: 8.8, up: true } : { name: 'Strait of Dover, 34 km', km: 34, up: false };
const sk2 = bigOne ? 70 / Math.max(rMe, MOON_KM) : 70 / Math.max(rMe, REF.km / 2);
const r2 = Math.max(1.2, rMe * sk2), c2 = 90;
const refPx = REF.km * sk2;
const bx = c2 + r2 + 70; // where the length or the Moon sits
const moonR2 = MOON_KM * sk2;
---
<Reading title={(b.kind === 'comet' && /comet/i.test(b.name) ? `${b.name}: orbit and facts` : `${b.name}: ${lowerKind}`).replace(/the Earth/g, 'Earth')} path={`/worlds/${b.id}`} description={metaDesc}>
  <article class="rec world-record">
    <Fragment set:html={headHtml} />
    <section class:list={['rec-top', { 'no-pic': !lead }]}>
      {lead && (
        <figure class:list={['rec-pic', { tall: lead.height > lead.width * 1.25 }]}>
          <img src={lead.src} alt={lead.alt} width={lead.width} height={lead.height} />
          <figcaption set:html={lead.caption} />
        </figure>
      )}
      <div>
        <Fragment set:html={sheet(cells)} />
        <p class="rec-go">
          {parentHref && <a href={parentHref}>{nameOf(b.parent).replace(/^the /, 'The ')}</a>}
          {chart && <a href={chart}>On the charts</a>}
          {go && <a href={`/explore?go=${go}`}>Fly to it in 3D</a>}
          {related.map((l) => <a href={`/learn/${l.id}`}>Lesson: {l.data.title}</a>)}
        </p>
      </div>
    </section>
    <section class="row wide wo-draw">
      <div class="hang"><h2>{isMoon ? 'Its path and size' : 'Its path'}</h2></div>
      <div class:list={['draw-pair', { one: !isMoon && !sized }]}>
      <figure class="wo-orbit" data-e={o.e} data-days={periodDays} data-cx={ecx} data-cy={fy} data-rx={erx} data-ry={ery}>
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`The path of ${b.name} round ${round ? 'the Sun' : nameOf(b.parent)}, drawn to scale`}>
          <defs><clipPath id="frame"><rect x="0" y="0" width={W} height={H} /></clipPath></defs>
          <g clip-path="url(#frame)">
            {rings.map((g) => <circle cx={fx} cy={fy} r={g.r} class:list={['ring', { crossed: g.crosses }]} />)}
            {!round && pDraw > 0 && <circle cx={fx} cy={fy} r={Math.max(3, pDraw)} class="centre" />}
          </g>
          {ringLabels.map((g) => <text x={g.x} y={ly + 4} class="ring-t">{g.name}</text>)}
          <ellipse cx={ecx} cy={fy} rx={erx} ry={ery} class="path" />
          {round && <circle cx={fx} cy={fy} r="6" class="centre sun" />}
          {round && <text x={fx} y={fy + 30} class="foc-t" text-anchor="middle">Sun</text>}
          {!round && <text x={fx} y={fy + Math.max(3, pDraw) + 26} class="foc-t" text-anchor="middle">{nameOf(b.parent).replace(/^the /, 'The ')}</text>}
          <circle cx={ecx + erx} cy={fy} r="5" class="me" />
        </svg>
        <figcaption>The path of {midName} round {round ? 'the Sun' : nameOf(b.parent)}, seen from above and drawn to scale, with the white dot at its nearest point.{round && rings.length > 0 && (crossed.length > 0 ? <> It crosses the {crossed.length === 1 ? 'path' : 'paths'} of {and(crossed)}, drawn as dashed rings{uncrossed.length > 0 && <>; the plain {uncrossed.length === 1 ? 'ring is' : 'rings are'} {and(uncrossed)}</>}.</> : <> The faint rings are the paths of {and(rings.map((g) => g.name))}.</>)} Orbit from {b.sources[0]?.label}.</figcaption>
      </figure>
        {isMoon && (
          <figure class="wo-size">
            <svg viewBox={`0 0 600 ${SH}`} role="img" aria-label={`${b.name} drawn to scale beside ${cmp ? 'our Moon and ' : ''}the edge of ${nameOf(b.parent)}`}>
              <defs><clipPath id="sframe"><rect x="0" y="0" width="600" height={SH} /></clipPath><radialGradient id="shade" cx="35%" cy="35%" r="75%"><stop offset="0" stop-color="#d9d3c6" /><stop offset="1" stop-color="#6d685f" /></radialGradient>
                <radialGradient id="limb" gradientUnits="userSpaceOnUse" cx={parCx} cy={scy} r={parR}><stop offset={Math.max(0, 1 - 140 / parR)} stop-color="#2a2722" stop-opacity="0" /><stop offset="1" stop-color="#5a5244" stop-opacity=".9" /></radialGradient>
                <linearGradient id="fadev" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset=".22" stop-color="#fff" /><stop offset=".78" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>
                <mask id="limbmask"><rect x="0" y="0" width="600" height={SH} fill="url(#fadev)" /></mask></defs>
              {parR > 150
                ? <g mask="url(#limbmask)"><circle cx={parCx} cy={scy} r={parR} fill="url(#limb)" /><circle cx={parCx} cy={scy} r={parR} class="s-limb" /></g>
                : <circle cx={parCx} cy={scy} r={parR} class="s-par" clip-path="url(#sframe)" />}
              <circle cx={meCx} cy={scy} r={meR} fill="url(#shade)" />
              {cmp && <circle cx={moonCx} cy={scy} r={moonR} class="s-moon" />}
              <text x={parR > 150 ? 6 : parCx} y={parR > 150 ? SH - 42 : SH - 14} text-anchor={parR > 150 ? "start" : "middle"} class="s-t">{parR > 150 ? `${nameOf(b.parent).replace(/^the /, 'The ')}’s edge` : nameOf(b.parent).replace(/^the /, 'The ')}</text>
              <text x={meCx} y={SH - 14} text-anchor="middle" class="s-t me">{b.name}</text>
              {cmp && <text x={moonCx} y={SH - 14} text-anchor="middle" class="s-t">Our Moon</text>}
            </svg>
            <figcaption>{b.name}, {cmp ? 'our Moon and ' : ''}{nameOf(b.parent)}, drawn to one scale from their measured sizes, as plain discs.{parR > 150 && <> At this scale {nameOf(b.parent)} is so large that only a gently curving stretch of its edge fits.</>}</figcaption>
          </figure>
        )}
        {sized && (
          <figure class="wo-size">
            <svg viewBox={`0 0 600 ${SH}`} role="img" aria-label={`${b.name} drawn to scale beside ${bigOne ? 'our Moon' : REF.name}`}>
              <defs><radialGradient id="shade2" cx="35%" cy="35%" r="75%"><stop offset="0" stop-color="#d9d3c6" /><stop offset="1" stop-color="#6d685f" /></radialGradient></defs>
              <circle cx={c2} cy={scy} r={r2} fill="url(#shade2)" />
              {bigOne
                ? <circle cx={bx + moonR2} cy={scy} r={moonR2} class="s-moon" />
                : REF.up
                  ? <g class="s-bar"><line x1={bx} y1={scy - refPx / 2} x2={bx} y2={scy + refPx / 2} /><line x1={bx - 7} y1={scy - refPx / 2} x2={bx + 7} y2={scy - refPx / 2} /><line x1={bx - 7} y1={scy + refPx / 2} x2={bx + 7} y2={scy + refPx / 2} /></g>
                  : <g class="s-bar"><line x1={bx} y1={scy} x2={bx + refPx} y2={scy} /><line x1={bx} y1={scy - 7} x2={bx} y2={scy + 7} /><line x1={bx + refPx} y1={scy - 7} x2={bx + refPx} y2={scy + 7} /></g>}
              <text x={c2} y={SH - 14} text-anchor="middle" class="s-t me">{b.name}</text>
              {bigOne
                ? <text x={bx + moonR2} y={SH - 14} text-anchor="middle" class="s-t">Our Moon</text>
                : <text x={REF.up ? bx + 16 : bx} y={REF.up ? scy + 7 : scy + 34} text-anchor="start" class="s-t">{REF.name}</text>}
            </svg>
            <figcaption>{b.name} and {bigOne ? 'our Moon' : REF.name.replace(/^The /, 'the ').replace(/^Strait/, 'the Strait')}, drawn to one scale. {b.name} is drawn as a plain disc from its mean width, {D2 < 1 ? `${fmt(D2 * 1000)} m` : `${fmt(D2)} km`}{bigOne ? '' : ', although it is not round'}.</figcaption>
          </figure>
        )}
      </div>
    </section>
    {page ? page.chapters.map((c, i) => (
      <section class="row">
        <div class="hang"><h2>{c.title}</h2></div>
        <div class="prose">
          {i === 0 && closeup && (
            <figure class="closeup">
              <img src={closeup.src} alt={closeup.alt} width={closeup.width} height={closeup.height} loading="lazy" />
              <figcaption set:html={closeup.caption} />
            </figure>
          )}
          {c.paras.map((t) => <p>{t}</p>)}
        </div>
      </section>
    )) : SHOW_OUTLINES && (
      <section class="row small wo-later">
        <div class="hang"><h2>Being written</h2></div>
        <div class="prose"><p>{CHAPTERS[b.kind].join(' · ')}</p></div>
      </section>
    )}
    <section class="row small">
      <div class="hang"><h2>Where this comes from</h2></div>
      <div class="prose"><p>{[...(page?.sources ?? []), ...b.sources].map((s, i) => <>{i > 0 && '; '}<a href={s.url} rel="noopener">{s.label}</a></>)}.</p></div>
    </section>
  </article>
</Reading>

<script>
  // The path draws itself once as it arrives; then the world moves round it at its true pace (Kepler's equation), one orbit
  // in 24 seconds, with a plain statement of how fast time is running. Reduced motion: the path is simply there, with the world at its nearest point.
  const fig = document.querySelector<HTMLElement>('.wo-orbit');
  const svg = fig?.querySelector<SVGSVGElement>('svg');
  const path = svg?.querySelector<SVGEllipseElement>('ellipse.path');
  const me = svg?.querySelector<SVGCircleElement>('circle.me');
  if (fig && svg && path && me && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const e = Number(fig.dataset.e), days = Number(fig.dataset.days), cx = Number(fig.dataset.cx), cy = Number(fig.dataset.cy), rx = Number(fig.dataset.rx), ry = Number(fig.dataset.ry);
    const LOOP = 24; // seconds for one orbit
    const per = days / LOOP; // days of the world's time in one second of ours
    const rate = per < 1 / 24 ? `${(per * 1440).toFixed(per * 1440 < 10 ? 1 : 0)} minutes` : per < 2 ? `${(per * 24).toFixed(per * 24 < 10 ? 1 : 0)} hours` : per < 400 ? `${per.toFixed(per < 10 ? 1 : 0)} days` : `${(per / 365.25).toFixed(per / 365.25 < 10 ? 1 : 0)} years`;
    const control = document.createElement('p');
    control.className = 'wo-rate';
    const btn = document.createElement('button'); btn.type = 'button'; btn.textContent = 'Pause';
    const say = document.createElement('span'); say.textContent = `One second here is about ${rate}`;
    control.append(btn, say); fig.append(control);
    let playing = true, last = 0, M = 0, visible = false;
    const place = () => {
      // Kepler's equation by a few rounds of Newton's method, then the position on the ellipse from the focus
      let E = M; for (let i = 0; i < 6; i++) E -= (E - e * Math.sin(E) - M) / (1 - e * Math.cos(E));
      me.setAttribute('cx', String(cx + rx * Math.cos(E))); me.setAttribute('cy', String(cy - ry * Math.sin(E)));
    };
    const frame = (t: number) => {
      if (playing && visible && !document.hidden) {
        if (last) M = (M + ((t - last) / 1000 / LOOP) * 2 * Math.PI) % (2 * Math.PI); // a mean anomaly advances evenly with time
        place();
      }
      last = t; requestAnimationFrame(frame);
    };
    btn.addEventListener('click', () => { playing = !playing; btn.textContent = playing ? 'Pause' : 'Play'; });
    path.setAttribute('pathLength', '1'); path.style.strokeDasharray = '1'; path.style.strokeDashoffset = '1'; me.style.opacity = '0';
    const io = new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible && path.style.strokeDashoffset === '1') {
        path.style.transition = 'stroke-dashoffset 2.2s cubic-bezier(.3,.6,.2,1)'; path.style.strokeDashoffset = '0';
        setTimeout(() => { me.style.transition = 'opacity .6s'; me.style.opacity = '1'; requestAnimationFrame(frame); }, 1800);
      }
    }, { threshold: 0.4 });
    io.observe(fig);
  }
