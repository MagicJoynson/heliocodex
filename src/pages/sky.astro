---
// The sky above the visitor: every star the eye can see, the planets, the Moon and the
// constellation figures, worked out in the page for their place and time, and drawn the way the
// sky is seen from the ground. The view can be turned, and tipped back to show the whole sky.
import Base from '../layouts/Base.astro';
import '../styles/reading.css';
import { CITIES } from '../lib/sky/cities';
import { pageStars } from '../lib/sky/starlist';
import { SKY_STARS } from '../lib/sky/chart';
import { MODERN, LY_PER_PC } from '../lib/sky/star';
// which of the stars on the chart have a page of their own
const pages = Object.fromEntries(pageStars().filter((s) => s.index < SKY_STARS).map((s) => [s.index, s.slug]));
// stars whose distance here is a newer one than the star file's, so the card and the star's page agree
const newer = Object.fromEntries(pageStars().filter((s) => MODERN[s.slug]).map((s) => [s.index, [s.distPc * LY_PER_PC, s.lumSun]]));
---
<Base title="The sky tonight" path="/sky" description="The sky above you tonight: the stars, the planets, the Moon and the constellations, worked out for where you are. Turn round, look up, and touch anything to find out what it is.">
  <article class="sky" data-pages={JSON.stringify(pages)} data-newer={JSON.stringify(newer)}>
    <div class="sky-view" id="sky-view">
      <canvas id="sky-canvas" role="img" aria-label="The sky as seen from the ground. The list under the picture says what is up."></canvas>
      <p class="sky-hold" id="sky-hold">Fetching the stars…</p>

      <header class="sky-head">
        <p class="label">The sky tonight</p>
        <h1>Look up</h1>
        <p class="sky-line" id="sky-line"></p>
        <p class="sky-note" id="sky-note" hidden></p>
        <p class="sky-hint" id="sky-hint">Drag to look round. Touch a star.</p>
      </header>

      <aside class="sky-card" id="sky-card" aria-live="polite" hidden></aside>

      <form class="sky-bar" id="sky-controls">
        <div class="bar-when">
          <input id="sky-shift" type="range" min="-720" max="720" step="5" value="0" aria-label="Earlier or later, up to twelve hours either way" />
          <div class="bar-row">
            <button type="button" data-step="-1440">A day back</button>
            <button type="button" id="sky-now">Now</button>
            <button type="button" id="sky-tonight">Tonight</button>
            <button type="button" data-step="1440">A day on</button>
          </div>
        </div>

        <div class="bar-look" role="group" aria-label="Which way to look">
          <span class="label">Face</span>
          <button type="button" data-face="0">North</button>
          <button type="button" data-face="90">East</button>
          <button type="button" data-face="180">South</button>
          <button type="button" data-face="270">West</button>
          <button type="button" id="sky-whole">Whole sky</button>
        </div>

        <div class="bar-more">
          <details class="pop" id="pop-where">
            <summary><span class="label">Where</span> <span id="sky-where-name">London</span></summary>
            <div class="pop-body">
              <label class="label" for="sky-place">Choose a city</label>
              <select id="sky-place">
                {CITIES.map(([name], i) => <option value={i}>{name}</option>)}
                <option value="here" hidden>Where I am</option>
                <option value="typed" hidden>The place typed below</option>
              </select>
              <button type="button" id="sky-here">Use where I am</button>
              <button type="button" id="sky-forget" hidden>Forget my place</button>
              <p class="hint" id="sky-place-note"></p>
              <p class="hint">Your place stays in this browser and is never sent to us. <a href="/cookies">What is kept on your device</a>.</p>
              <div class="pair">
                <label>Latitude, north is plus <input id="sky-lat" type="number" min="-90" max="90" step="0.01" inputmode="decimal" /></label>
                <label>Longitude, east is plus <input id="sky-lon" type="number" min="-180" max="180" step="0.01" inputmode="decimal" /></label>
              </div>
            </div>
          </details>
          <details class="pop" id="pop-show">
            <summary><span class="label">Show</span></summary>
            <div class="pop-body">
              <label class="tick"><input type="checkbox" id="sky-figures" checked /> Constellation figures</label>
              <label class="tick"><input type="checkbox" id="sky-names" checked /> Names</label>
              <label class="tick"><input type="checkbox" id="sky-path" checked /> The path of the Sun and planets</label>
            </div>
          </details>
        </div>
      </form>
    </div>

    <div class="reading sky-rest">
      <section class="row">
        <div class="hang"><h2>Up now</h2></div>
        <div class="prose" id="sky-list"><p>Working it out…</p></div>
      </section>

      <section class="row">
        <div class="hang"><h2>How to use it</h2></div>
        <div class="prose">
          <p>The picture shows the sky as you would see it standing outside, facing the way written on the ground at the foot of the view. Drag the picture to turn round or to look higher. Pinch, or roll the mouse wheel, to look closer.</p>
          <p>Slide the bar to move through the night and watch the sky turn. Touch any bright star, a planet or the Moon to find out what it is.</p>
          <p>"Whole sky" tips the view straight up, so the point overhead is in the middle and the horizon runs round the edge. East is then on the left and west on the right, the other way round from a map of the ground, because you are looking up and not down.</p>
          <p>A bigger dot is a brighter star. The colours are real: blue-white stars are the hottest and orange ones the coolest. Things close to the ground may be hidden by houses, trees or haze.</p>
          <p><a href="/stars">Meet a star</a> has a page for each of the named ones.</p>
        </div>
      </section>

      <section class="row small">
        <div class="hang"><h2>How it is worked out</h2></div>
        <div class="prose">
          <p>Nothing here is looked up from a service. The page works out the sky itself from your place and the time on your device.</p>
          <ul>
            <li>Stars: places, distances, brightness and colour from the <a href="https://codeberg.org/astronexus/hyg" rel="noopener">HYG star database</a> by David Nash (CC BY-SA 4.0), the same stars the 3D view uses.</li>
            <li>Planets and the Sun: orbits from NASA/JPL Solar System Dynamics, the same sums as the rest of this site.</li>
            <li>The Moon: the largest terms of the series in Jean Meeus, <cite>Astronomical Algorithms</cite>, chapter 47.</li>
            <li>Constellation figures: from d3-celestial by Olaf Frohn.</li>
          </ul>
          <p>Checked against NASA's JPL Horizons service, the planets land within a fifth of a degree and the Moon within a tenth. A fifth of a degree is less than half the width of the full Moon. The colour of the sky and the glow at dusk are drawn to give the feel of the hour, and are not measurements. If you use "where I am", your position stays on your device. See <a href="/sources">Sources</a> for the files and their licences.</p>
        </div>
      </section>
    </div>
  </article>
</Base>

<script>
  import { draw, load, wayOf, heightOf, PLANET_NAMES, wholeSky, type Mark, type SkyData, type View, type Room } from '../lib/sky/chart';
  import { moment, toSky, sunFromEarth, planetFromEarth, moonSky, PLANETS, type Moment } from '../lib/sky/place';
  import { CITIES, guess } from '../lib/sky/cities';
  import { readPlace, keepPlace, forgetPlace } from '../lib/sky/remember';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const root = document.querySelector<HTMLElement>('.sky')!, box = $('sky-view');
  const canvas = $<HTMLCanvasElement>('sky-canvas'), ctx = canvas.getContext('2d')!;
  const place = $<HTMLSelectElement>('sky-place'), shift = $<HTMLInputElement>('sky-shift');
  const lat = $<HTMLInputElement>('sky-lat'), lon = $<HTMLInputElement>('sky-lon');
  const card = $('sky-card'), list = $('sky-list'), line = $('sky-line'), note = $('sky-place-note'), dayNote = $('sky-note'), hint = $('sky-hint');
  const pages = JSON.parse(root.dataset.pages!) as Record<string, string>;
  const newer = JSON.parse(root.dataset.newer!) as Record<string, [number, number]>;
  const nf = (n: number, d = 0) => n.toLocaleString('en-GB', { maximumFractionDigits: d, minimumFractionDigits: d });
  const calm = matchMedia('(prefers-reduced-motion: reduce)');

  let data: SkyData | null = null, marks: Mark[] = [], picked: Mark | null = null;
  let where = { name: '', lat: 0, lon: 0 }, dayShift = 0, w = 0, h = 0;
  let view: View = { azDeg: 180, altDeg: 30, fovDeg: 100 };
  let mom: Moment | null = null, momKey = '';
  let room: Room = { foot: 0, clear: [] };

  const when = () => new Date(Date.now() + (Number(shift.value) + dayShift) * 60000);
  /** The view for facing one way, with the ground a little way up from the foot of the picture. */
  function facing(azDeg: number): View {
    // the field is measured across the shorter side, so a tall phone sees far more sky upwards than sideways
    return { azDeg, fovDeg: h > w * 1.15 ? 88 : 100, altDeg: 20 };
  }

  // ---- drawing, at most once a frame
  let due = 0;
  const render = () => { if (!due) due = requestAnimationFrame(paint); };
  function paint(): void {
    due = 0;
    const t = when(), offset = Number(shift.value) + dayShift;
    line.textContent = `${where.name}, ${t.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' })}, ${t.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}${offset === 0 ? ' (now)' : ''}`;
    if (!data || !w) return;
    const key = `${Math.floor(t.getTime() / 20000)}|${where.lat}|${where.lon}`;
    if (key !== momKey || !mom) { mom = moment(t, where.lat, where.lon); momKey = key; upNow(mom); }
    measure();
    marks = draw(ctx, w, h, data, mom, view, { figures: $<HTMLInputElement>('sky-figures').checked, names: $<HTMLInputElement>('sky-names').checked, path: $<HTMLInputElement>('sky-path').checked }, picked, room);
    if (picked && !card.hidden) { const again = marks.find((k) => k.id === picked!.id); if (again) show(again, false); }
  }
  function fit(): void {
    const b = box.getBoundingClientRect(), ratio = Math.min(devicePixelRatio || 1, 2);
    w = Math.floor(b.width); h = Math.floor(b.height);
    canvas.width = Math.round(w * ratio); canvas.height = Math.round(h * ratio);
    ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
    measure();
  }
  /** Where the words and controls sit over the picture, so the sky is framed round them and no name is written under them. */
  function measure(): void {
    const b = box.getBoundingClientRect(), clear: Room['clear'] = [];
    for (const e of [document.querySelector<HTMLElement>('.sky-head')!, card]) {
      if (e.hidden) continue;
      const r = e.getBoundingClientRect();
      if (r.width) clear.push([r.left - b.left - 8, r.top - b.top - 8, r.right - b.left + 8, r.bottom - b.top + 8]);
    }
    // on a narrow screen the words run right across, so the round chart starts beneath them
    const head = document.querySelector<HTMLElement>('.sky-head')!.getBoundingClientRect();
    const last = (dayNote.hidden ? line : dayNote).getBoundingClientRect();
    const top = head.width > b.width * 0.55 ? last.bottom - b.top - 6 : 0;
    let foot = $('sky-controls').getBoundingClientRect().top - b.top + 34;
    // and a card that runs right across the foot takes that room too, so what was touched stays in sight above it
    const cr = card.getBoundingClientRect();
    if (!card.hidden && cr.width > b.width * 0.55) foot = Math.min(foot, cr.top - b.top + 16);
    room = { foot, clear, top };
  }

  // ---- turning the view
  let glide = 0;
  function turnTo(next: View): void {
    cancelAnimationFrame(glide);
    if (calm.matches) { view = next; render(); return; }
    const from = { ...view }, began = performance.now();
    // go the short way round
    const swing = ((next.azDeg - from.azDeg + 540) % 360) - 180;
    const step = (now: number) => {
      const x = Math.min(1, (now - began) / 700), k = x * x * (3 - 2 * x);
      view = { azDeg: (from.azDeg + swing * k + 360) % 360, altDeg: from.altDeg + (next.altDeg - from.altDeg) * k, fovDeg: from.fovDeg + (next.fovDeg - from.fovDeg) * k };
      render();
      if (x < 1) glide = requestAnimationFrame(step);
    };
    glide = requestAnimationFrame(step);
  }
  const fingers = new Map<number, { x: number; y: number }>();
  let moved = 0, spread = 0;
  canvas.addEventListener('pointerdown', (e) => {
    canvas.setPointerCapture(e.pointerId); fingers.set(e.pointerId, { x: e.clientX, y: e.clientY }); moved = 0; cancelAnimationFrame(glide);
    if (fingers.size === 2) { const [a, b] = [...fingers.values()]; spread = Math.hypot(a.x - b.x, a.y - b.y); }
  });
  canvas.addEventListener('pointermove', (e) => {
    const was = fingers.get(e.pointerId);
    if (!was) return;
    const dx = e.clientX - was.x, dy = e.clientY - was.y;
    fingers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    moved += Math.abs(dx) + Math.abs(dy);
    if (fingers.size === 2) {
      const [a, b] = [...fingers.values()], now = Math.hypot(a.x - b.x, a.y - b.y);
      if (spread > 0) view = { ...view, fovDeg: Math.max(30, Math.min(wholeSky(w, h, room).fovDeg, (view.fovDeg * spread) / now)) };
      spread = now;
    } else {
      const perPx = view.fovDeg / Math.min(w, h);
      view = { ...view, azDeg: (view.azDeg - (dx * perPx) / Math.max(0.35, Math.cos((view.altDeg * Math.PI) / 180)) + 360) % 360, altDeg: Math.max(4, Math.min(90, view.altDeg + dy * perPx)) };
    }
    if (moved > 12) hint.classList.add('gone');
    render();
  });
  const lift = (e: PointerEvent) => {
    const only = fingers.size === 1;
    fingers.delete(e.pointerId);
    if (only && moved < 8 && e.type === 'pointerup') pick(e);
  };
  canvas.addEventListener('pointerup', lift);
  canvas.addEventListener('pointercancel', lift);
  // the wheel looks closer only once the picture has been touched or clicked, so the page still scrolls past it
  let engaged = false;
  canvas.addEventListener('pointerdown', () => { engaged = true; });
  document.addEventListener('pointerdown', (e) => { if (e.target !== canvas) engaged = false; });
  canvas.addEventListener('wheel', (e) => {
    if (!engaged && !e.ctrlKey) return;
    e.preventDefault();
    view = { ...view, fovDeg: Math.max(30, Math.min(wholeSky(w, h, room).fovDeg, view.fovDeg * Math.exp(e.deltaY * 0.0012))) };
    render();
  }, { passive: false });
  canvas.tabIndex = 0;
  canvas.addEventListener('keydown', (e) => {
    const by = e.shiftKey ? 15 : 5;
    if (e.key === 'ArrowLeft') view = { ...view, azDeg: (view.azDeg - by + 360) % 360 };
    else if (e.key === 'ArrowRight') view = { ...view, azDeg: (view.azDeg + by) % 360 };
    else if (e.key === 'ArrowUp') view = { ...view, altDeg: Math.min(90, view.altDeg + by) };
    else if (e.key === 'ArrowDown') view = { ...view, altDeg: Math.max(4, view.altDeg - by) };
    else return;
    e.preventDefault(); render();
  });

  // ---- the card for whatever was touched
  const el = (tag: string, text?: string, cls?: string) => { const e = document.createElement(tag); if (text) e.textContent = text; if (cls) e.className = cls; return e; };
  const whereabouts = (k: { altDeg: number; azDeg: number }) => `${heightOf(k.altDeg)} in the ${wayOf(k.azDeg)}`;
  const from = () => (where.name === 'Where you are' ? 'where you are' : where.name);

  function fill(parts: HTMLElement[]): void {
    const shut = el('button', 'Close', 'sky-card-shut') as HTMLButtonElement; shut.type = 'button';
    shut.addEventListener('click', () => { card.hidden = true; picked = null; render(); });
    card.replaceChildren(shut, ...parts); card.hidden = false;
  }
  function show(k: Mark, fresh = true): void {
    picked = k;
    const first = `It is ${whereabouts(k)}, ${nf(k.altDeg)}° above the horizon.`;
    // while the time slides, only the line that says where it is needs to change
    if (!fresh) { const old = card.querySelector('.sky-card-text'); if (old && old.textContent !== first) old.textContent = first; return; }
    const parts: HTMLElement[] = [el('p', k.kind === 'star' ? 'A star' : k.kind === 'planet' ? 'A planet' : k.kind === 'moon' ? 'Our moon' : 'Our star', 'label')];
    parts.push(el('h2', k.name || 'A star with no common name'));
    const lines: string[] = [first];
    if (k.kind === 'star') {
      if (newer[k.index!]) [k.ly, k.suns] = newer[k.index!];
      const year = when().getFullYear() - Math.round(k.ly!);
      // a year is only given where the distance is known well enough to name one
      const far = Number(k.ly!.toPrecision(2));
      lines.push(k.ly! < 200 ? `It is ${nf(k.ly!, k.ly! < 100 ? 1 : 0)} light years away. The light reaching you now left it in about ${year}.` : `It is about ${nf(far)} light years away. The light reaching you now left it about ${nf(far)} years ago.`);
      lines.push(k.suns! >= 1.5 ? `It gives out about ${nf(Number(k.suns!.toPrecision(2)))} times as much visible light as the Sun.` : k.suns! > 0.67 ? 'It gives out about as much visible light as the Sun.' : `It gives out about ${nf(k.suns! * 100)} per cent of the Sun's visible light.`);
    } else if (k.kind === 'planet') {
      lines.push(`It is ${nf(k.au! * 149.5978707, k.au! < 1 ? 1 : 0)} million km from the Earth at this moment, and its light takes ${nf(k.au! * 8.3168, k.au! < 3 ? 1 : 0)} minutes to arrive.`);
      if (k.id === 'uranus' || k.id === 'neptune') lines.push('It is too faint to see without binoculars or a telescope.');
    } else if (k.kind === 'moon') {
      lines.push(`${nf(k.lit! * 100)} per cent of its face is lit. It is ${nf(Math.round(k.km! / 100) * 100)} km from you.`);
    } else lines.push('Never look straight at the Sun.');
    for (const l of lines) parts.push(el('p', l, 'sky-card-text'));
    const go = document.createElement('p'); go.className = 'sky-card-links';
    const link = (href: string, text: string) => { const a = document.createElement('a'); a.href = href; a.textContent = text; go.append(a); };
    if (k.kind === 'star') { if (pages[k.index!]) link(`/stars/${pages[k.index!]}`, `Meet ${k.name}`); link(`/?go=star:${k.index}`, 'Fly to it in 3D'); }
    if (k.kind === 'planet') { link(`/${k.id}`, `About ${PLANET_NAMES[k.id]}`); link(`/?go=${k.id}`, 'Fly to it in 3D'); }
    if (k.kind === 'moon') link('/?go=moon', 'Fly to it in 3D');
    if (k.kind === 'sun') link('/sun', 'About the Sun');
    if (go.childElementCount) parts.push(go);
    fill(parts);
  }

  /** What is above the horizon, all round, in words. Worked out from the sums, not read off the picture, so it does not depend on which way the view is turned. */
  function upNow(m: Moment): void {
    const sun = toSky(sunFromEarth(m.T), m), moon = moonSky(m), out: string[] = [];
    if (sun.altDeg > 0) out.push(`The Sun is up, ${whereabouts(sun)}, so the stars are hidden by daylight. The picture shows what is behind the blue. Choose "Tonight" to see the sky after dark.`);
    const eye = PLANETS.filter((id) => id !== 'uranus' && id !== 'neptune').map((id) => ({ id, ...toSky(planetFromEarth(id, m.T).dir, m) })).filter((k) => k.altDeg > 3);
    out.push(eye.length ? `Planets you can see by eye: ${eye.map((k) => `${PLANET_NAMES[k.id]}, ${whereabouts(k)}`).join('; ')}.` : 'No planet bright enough to see by eye is above the horizon at this moment.');
    out.push(moon.altDeg > 0 ? `The Moon is up, ${whereabouts(moon)}, with ${nf(moon.lit * 100)} per cent of its face lit.` : 'The Moon is below the horizon.');
    out.push('Turn the picture, or choose "Whole sky", and touch anything bright to find out what it is.');
    list.replaceChildren(...out.map((t) => el('p', t)));
  }

  function pick(e: PointerEvent): void {
    const b = canvas.getBoundingClientRect(), x = e.clientX - b.left, y = e.clientY - b.top;
    let best: Mark | null = null, gap = 28;
    for (const k of marks) {
      // planets and the Moon win over a star beside them
      const d = Math.hypot(k.x - x, k.y - y) - (k.kind === 'star' ? 0 : 8) + (k.kind === 'star' ? (k.mag ?? 5) * 1.5 : 0);
      if (d < gap) { gap = d; best = k; }
    }
    if (best) { show(best); hint.classList.add('gone'); render(); }
  }

  // ---- place and time
  function setPlace(name: string, la: number, lo: number, why: string, chosen = true): void {
    where = { name, lat: la, lon: lo };
    if (chosen) keepPlace(where);
    $('sky-forget').hidden = !readPlace();
    lat.value = la.toFixed(2); lon.value = lo.toFixed(2);
    note.textContent = why; $('sky-where-name').textContent = name;
    render();
  }
  /** Minutes from now until it is properly dark, or 0 if it already is. Null where it does not get dark tonight. */
  function untilDark(): number | null {
    const sunAt = (mins: number) => { const m = moment(new Date(Date.now() + mins * 60000), where.lat, where.lon); return toSky(sunFromEarth(m.T), m).altDeg; };
    if (sunAt(0) < -9) return 0;
    for (let mins = 5; mins <= 1440; mins += 5) if (sunAt(mins) < -12) return mins;
    return null;
  }
  function tonight(auto: boolean): void {
    const wait = untilDark();
    dayShift = 0;
    if (wait === null) { shift.value = '0'; dayNote.textContent = `It does not get fully dark in ${from()} tonight, so this is the sky as it is now.`; dayNote.hidden = false; }
    else {
      const held = Math.min(720, wait); shift.value = String(held); dayShift = wait - held;
      dayNote.hidden = wait === 0;
      if (wait > 0) dayNote.textContent = auto ? 'It is still light where you are, so this is tonight, once it is dark. "Now" shows the sky at this moment.' : 'This is tonight, once it is dark.';
    }
    render();
  }

  place.addEventListener('change', () => {
    const i = Number(place.value);
    if (!Number.isNaN(i)) setPlace(CITIES[i][0], CITIES[i][1], CITIES[i][2], '');
  });
  $('sky-forget').addEventListener('click', () => {
    forgetPlace();
    const g = guess();
    place.value = String(g);
    setPlace(CITIES[g][0], CITIES[g][1], CITIES[g][2], 'Forgotten. Nothing about your place is kept on this device now.', false);
  });
  $('sky-here').addEventListener('click', () => {
    if (!navigator.geolocation) { note.textContent = 'This device cannot say where it is. Choose a city or type a position.'; return; }
    note.textContent = 'Asking your device…';
    navigator.geolocation.getCurrentPosition(
      (p) => { place.querySelector<HTMLOptionElement>('option[value="here"]')!.hidden = false; place.value = 'here'; setPlace('Where you are', p.coords.latitude, p.coords.longitude, 'Using your own position. It stays on this device.'); },
      () => { note.textContent = 'Your device would not share its position. Choose a city or type a position instead.'; },
      { maximumAge: 600000, timeout: 15000 },
    );
  });
  for (const input of [lat, lon]) input.addEventListener('change', () => {
    const la = Number(lat.value), lo = Number(lon.value);
    if (lat.value === '' || lon.value === '' || Math.abs(la) > 90 || Math.abs(lo) > 180) return;
    place.querySelector<HTMLOptionElement>('option[value="typed"]')!.hidden = false; place.value = 'typed';
    setPlace('The place you typed', la, lo, '');
  });
  shift.addEventListener('input', () => { dayNote.hidden = true; render(); });
  $('sky-now').addEventListener('click', () => { shift.value = '0'; dayShift = 0; dayNote.hidden = true; render(); });
  $('sky-tonight').addEventListener('click', () => tonight(false));
  for (const b of document.querySelectorAll<HTMLButtonElement>('#sky-controls [data-step]')) b.addEventListener('click', () => { dayShift += Number(b.dataset.step); dayNote.hidden = true; render(); });
  for (const b of document.querySelectorAll<HTMLButtonElement>('#sky-controls [data-face]')) b.addEventListener('click', () => { hint.classList.add('gone'); turnTo(facing(Number(b.dataset.face))); });
  $('sky-whole').addEventListener('click', () => { hint.classList.add('gone'); turnTo(wholeSky(w, h, room)); });
  for (const id of ['sky-figures', 'sky-names', 'sky-path']) $(id).addEventListener('change', render);
  // one small panel open at a time, and a touch anywhere else shuts it
  const pops = [...document.querySelectorAll<HTMLDetailsElement>('.pop')];
  for (const p of pops) p.addEventListener('toggle', () => { if (p.open) for (const other of pops) if (other !== p) other.open = false; });
  document.addEventListener('pointerdown', (e) => { for (const p of pops) if (p.open && !p.contains(e.target as Node)) p.open = false; });
  $('sky-controls').addEventListener('submit', (e) => e.preventDefault());

  new ResizeObserver(() => { const first = !w; fit(); if (first) view = facing(180); render(); }).observe(box);
  setInterval(() => { if (!document.hidden) render(); }, 30000);
  document.fonts?.ready.then(render);

  const first = guess(), kept = readPlace();
  if (kept) {
    const i = CITIES.findIndex(([name]) => name === kept.name);
    if (i < 0) place.querySelector<HTMLOptionElement>('option[value="typed"]')!.hidden = false;
    place.value = i < 0 ? 'typed' : String(i);
    setPlace(i < 0 ? 'The place you typed' : kept.name, kept.lat, kept.lon, 'The place you chose last time.', false);
  } else {
    place.value = String(first);
    setPlace(CITIES[first][0], CITIES[first][1], CITIES[first][2], `Guessed from your device's clock. For your exact sky, choose "Use where I am".`, false);
  }
  // by day the page opens on tonight's sky, since that is what people come for
  tonight(true);

  const hold = $('sky-hold');
  load().then((d) => {
    data = d; hold.remove(); paint();
    // a star page can send its star here to be pointed out
    const asked = new URLSearchParams(location.search).get('star');
    if (asked && /^\d+$/.test(asked)) {
      const looking = view;
      view = wholeSky(w, h, room); paint();
      const found = marks.find((k) => k.id === `star:${asked}`), name = d.names.get(Number(asked));
      view = looking;
      if (found) { view = { ...facing(found.azDeg), altDeg: Math.max(20, Math.min(80, found.altDeg)) }; paint(); const again = marks.find((k) => k.id === found.id); if (again) show(again); }
      else if (name) fill([el('p', 'A star', 'label'), el('h2', name), el('p', `${name} is below the horizon from ${from()} at this moment. Slide the time on, or choose another place, and touch it when it comes up.`, 'sky-card-text')]);
      hint.classList.add('gone'); render();
    }
  }).catch(() => { hold.textContent = 'The stars could not be fetched. Check your connection and load the page again.'; });
</script>

