---
// One star, introduced: what it is, how far, how bright, how hot, and where it is in your sky now.
import Base from '../../layouts/Base.astro';
import '../../styles/reading.css';
import '../../styles/star.css';
import { pageStars, type PageStar } from '../../lib/sky/starlist';
import { starPage } from '../../lib/sky/star';

export function getStaticPaths() {
  return pageStars().map((star) => ({ params: { star: star.slug }, props: { star } }));
}
const { star } = Astro.props as { star: PageStar };
const page = starPage(star);
---
<Base title={star.name} path={`/stars/${star.slug}`} description={page.description}>
  <article class="reading star" data-dir={star.dir.join(',')} data-name={star.name} data-rgb={page.rgb} data-lum={star.lumSun} set:html={page.html} />
</Base>

<script>
  import { enliven } from '../../lib/sky/starpage';
  enliven(document.querySelector<HTMLElement>('.star')!);
</script>
