---
// One star, introduced: what it is, how far, how bright, how hot, and where it is in your sky now.
import Base from '../../layouts/Base.astro';
import '../../styles/reading.css';
import { pageStars, type PageStar } from '../../lib/sky/starlist';
import { LY_PER_PC, temperature, tint, kind, nf, round2, distanceNote, DISTANCE_NOTES, MODERN, placing, tidySpect } from '../../lib/sky/star';

export function getStaticPaths() {
  return pageStars().map((star) => ({ params: { star: star.slug }, props: { star } }));
}
const { star } = Astro.props as { star: PageStar };
const ly = star.distPc * LY_PER_PC, kelvin = Math.round(temperature(star.bv) / 100) * 100, rgb = tint(star.bv).join(',');
const { colour, stage } = kind(star.spect);
const modern = MODERN[star.slug], spect = tidySpect(star.spect);
const doubt = modern?.note ?? DISTANCE_NOTES[star.slug] ?? distanceNote(star.distPc);
const rank = star.index + 1, byEye = star.appMag <= 6.5, onChart = star.appMag < 4.5;
const lum = star.lumSun;
const lumText = lum >= 1.5 ? `${round2(lum)} times as much visible light as the Sun` : lum > 0.67 ? 'about as much visible light as the Sun' : lum >= 0.01 ? `${round2(lum * 100)} per cent of the Sun's visible light` : `one ${round2(1 / lum)}th of the Sun's visible light`;
const lead = [colour ? `${star.name} is ${colour}` : `${star.name} is a star`, star.constellation ? `, in the constellation ${star.constellation}.` : '.'].join('');
const description = `${lead} It is ${round2(ly)} light years away.`;
const sight = !byEye ? 'It is too faint to see without a telescope.' : star.appMag <= 1.5 ? 'It is one of the brightest stars in the whole sky, easy to see even from a town.' : star.appMag <= 3.5 ? 'It is easy to see by eye on a clear night.' : star.appMag <= 5 ? 'It can be seen by eye away from bright lights.' : 'It can just be seen by eye from a really dark place.';
---
<Base title={star.name} path={`/stars/${star.slug}`} description={description}>
  <article class="reading star" data-dir={star.dir.join(',')} data-name={star.name} data-rgb={rgb} data-lum={lum}>
    <header class="star-head">
      <div>
        <p class="label"><a href="/stars">Meet a star</a>{star.constellation && ` / ${star.constellation}`}</p>
        <h1>{star.name}</h1>
        <p class="lead">{lead} {stage}</p>
        <p class="star-links">
          <a href={`/?go=star:${star.index}`}>Fly to it in 3D</a>
          {onChart && <a href={`/sky?star=${star.index}`}>Find it on the sky map</a>}
        </p>
      </div>
      <figure class="star-face">
        <canvas aria-hidden="true"></canvas>
        <figcaption>A drawing in the star's own colour, worked out from its measured colour index. It is not a photograph.</figcaption>
      </figure>
    </header>

    <section class="row">
      <div class="hang"><h2>How far</h2></div>
      <div class="prose">
        <p class="big"><span data-ly={star.distPc < 60 ? ly : ''}>{round2(ly)}</span> light years</p>
        <p>The light you see from {star.name} tonight set off <span id="star-left">about {round2(ly)} years ago</span>. Everything we know about it is that much out of date.</p>
        {doubt && <p>{doubt}</p>}
      </div>
    </section>

    <section class="row">
      <div class="hang"><h2>How bright</h2></div>
      <div class="prose">
        <p class="big">{lum >= 1.5 ? `${round2(lum)} Suns` : lum > 0.67 ? 'About one Sun' : `${round2(lum)} of a Sun`}</p>
        <p>It gives out {lumText}. {rank <= 20 ? `From the Earth it is ${placing(rank)} star in the night sky.` : rank <= 100 ? 'It is one of the hundred brightest stars in the night sky.' : ''} {sight}</p>
        <p>Astronomers put its brightness in our sky at magnitude {star.appMag.toFixed(2).replace('-', '−')}. Smaller numbers are brighter, and the faintest stars the eye can see are about 6.</p>
      </div>
    </section>

    <section class="row">
      <div class="hang"><h2>How hot</h2></div>
      <div class="prose">
        <p class="big">{star.bv < -0.05 ? `Hotter than ${nf(Math.floor(kelvin / 1000) * 1000)} K` : `About ${nf(kelvin)} K`}</p>
        <p>That is the temperature of its surface, worked out from its colour, so it is a guide and not a measurement. {star.bv < -0.05 ? 'For stars as blue as this one, colour is a poor thermometer: most of their light is ultraviolet, which the eye and this sum do not see, and the true figure can be far higher.' : 'It could be out by a few hundred degrees.'} The Sun's is 5,772 K. Hotter stars are bluer and cooler stars are redder, the same way a poker in a fire goes from red to white.</p>
        <p class="swatches"><span><i style={`background:rgb(${rgb})`}></i>{star.name}</span><span><i style="background:rgb(255,236,214)"></i>The Sun</span></p>
      </div>
    </section>

    {byEye && (
      <section class="row">
        <div class="hang"><h2>In your sky now</h2></div>
        <div class="prose"><p id="star-now">Working it out…</p></div>
      </section>
    )}

    <section class="row small">
      <div class="hang"><h2>Its names</h2></div>
      <div class="prose">
        <dl class="names">
          {star.catalogue && <div><dt>By constellation</dt><dd>{star.catalogue}</dd></div>}
          {star.hip && <div><dt>Hipparcos catalogue</dt><dd>HIP {star.hip}</dd></div>}
          {star.hd && <div><dt>Henry Draper catalogue</dt><dd>HD {star.hd}</dd></div>}
          {spect && <div><dt>Spectral type</dt><dd>{spect}</dd></div>}
        </dl>
      </div>
    </section>

    <section class="row small">
      <div class="hang"><h2>Where this comes from</h2></div>
      <div class="prose">
        <p>{modern ? 'Brightness in our sky, colour and spectral type' : 'Distance, brightness, colour and spectral type'} are from the <a href="https://codeberg.org/astronexus/hyg" rel="noopener">HYG star database, version 4.4</a>, by David Nash, shared under a <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener">Creative Commons Attribution-ShareAlike 4.0</a> licence. {modern ? <>The distance is from <a href={modern.url} rel="noopener">{modern.by}</a>, and the light the star gives out is worked out from that distance.</> : 'Its distances are those measured by the Hipparcos satellite.'} The temperature is worked out here from the colour with the formula of <a href="https://arxiv.org/abs/1201.1809" rel="noopener">Ballesteros (2012)</a>, and the words are written for this site.</p>
        <p>To read more: <a href="/learn/colour-and-brightness">Colour and brightness</a>, <a href="/learn/how-stars-live-and-die">How stars live and die</a>, <a href="/learn/measuring-distance">Measuring distance</a>.</p>
      </div>
    </section>
  </article>
</Base>

<script>
  import { moment, toSky, type Vec } from '../../lib/sky/place';
  import { CITIES, guess } from '../../lib/sky/cities';
  import { wayOf, heightOf } from '../../lib/sky/words';
  import { readPlace } from '../../lib/sky/remember';

  const page = document.querySelector<HTMLElement>('.star')!;
  // the year the light left
  const lyEl = page.querySelector<HTMLElement>('[data-ly]'), left = document.getElementById('star-left');
  if (lyEl && left) {
    const ly = Number(lyEl.dataset.ly), year = new Date().getFullYear() - Math.round(ly);
    if (ly > 0 && year > 0) left.textContent = `in about ${year}`;
  }
  // where it is now
  const now = document.getElementById('star-now');
  if (now) {
    const first = guess(), saved = readPlace() ?? { name: CITIES[first][0], lat: CITIES[first][1], lon: CITIES[first][2] };
    const dir = page.dataset.dir!.split(',').map(Number) as Vec, name = page.dataset.name!;
    const s = toSky(dir, moment(new Date(), saved.lat, saved.lon));
    // how high it gets and how low it sinks as the sky turns, from its height over a day
    let top = -90, low = 90;
    for (let h = 0; h < 24; h += 0.25) { const a = toSky(dir, moment(new Date(Date.now() + h * 3600000), saved.lat, saved.lon)).altDeg; top = Math.max(top, a); low = Math.min(low, a); }
    const from = saved.name === 'Where you are' ? 'where you are' : saved.name;
    now.textContent = top < 0 ? `${name} never rises above the horizon from ${from}. You would have to travel ${saved.lat > 0 ? 'south' : 'north'} to see it.`
      : s.altDeg > 0 ? `${name} is up now from ${from}: ${heightOf(s.altDeg)} in the ${wayOf(s.azDeg)}, ${Math.round(s.altDeg)}° above the horizon.${low > 0 ? ' From there it never sets.' : ''}`
      : `${name} is below the horizon from ${from} at this moment. At its highest it stands ${Math.round(top)}° up.`;
    const more = document.createElement('p');
    more.innerHTML = 'The place is the one you last chose on <a href="/sky">the sky map</a>, or a guess from your device\'s clock.';
    now.after(more);
  }

  // the star's face: a soft glow in its own colour, larger for a star that gives out more light
  const canvas = page.querySelector('canvas')!, ctx = canvas.getContext('2d')!;
  const rgb = page.dataset.rgb!, lum = Number(page.dataset.lum), calm = matchMedia('(prefers-reduced-motion: reduce)');
  function face(t: number): void {
    const box = canvas.getBoundingClientRect(), ratio = Math.min(devicePixelRatio || 1, 2), w = box.width, h = box.height;
    if (canvas.width !== Math.round(w * ratio)) { canvas.width = Math.round(w * ratio); canvas.height = Math.round(h * ratio); }
    ctx.setTransform(ratio, 0, 0, ratio, 0, 0); ctx.clearRect(0, 0, w, h);
    const s = Math.min(w, h), core = s * (0.06 + 0.014 * Math.max(-3, Math.min(5, Math.log10(lum)))), breathe = 1 + 0.025 * Math.sin(t / 1700);
    const halo = ctx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, s * 0.5);
    halo.addColorStop(0, `rgba(${rgb},.5)`); halo.addColorStop(0.25, `rgba(${rgb},.13)`); halo.addColorStop(1, `rgba(${rgb},0)`);
    ctx.fillStyle = halo; ctx.fillRect(0, 0, w, h);
    const disc = ctx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, core * 2.6 * breathe);
    disc.addColorStop(0, 'rgba(255,255,255,1)'); disc.addColorStop(0.3, `rgba(${rgb},1)`); disc.addColorStop(0.55, `rgba(${rgb},.5)`); disc.addColorStop(1, `rgba(${rgb},0)`);
    ctx.fillStyle = disc; ctx.beginPath(); ctx.arc(w / 2, h / 2, core * 2.6 * breathe, 0, Math.PI * 2); ctx.fill();
    if (!calm.matches && !document.hidden) requestAnimationFrame(face);
  }
  requestAnimationFrame(face);
  addEventListener('resize', () => { if (calm.matches) face(0); });
</script>

<style>
  .star-head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(16px, 4vw, 64px); align-items: center; margin-bottom: clamp(32px, 5vw, 64px); }
  .star-head .label { margin-bottom: 1.2rem; }
  .star-head h1 { font: 300 clamp(3rem, 9vw, 7rem)/.95 var(--r-serif); letter-spacing: -.03em; margin: 0 0 1.4rem; overflow-wrap: anywhere; }
  .star-head .lead { font: 300 clamp(1.12rem, 1rem + .45vw, 1.34rem)/1.55 var(--r-serif); color: var(--ink-soft); margin: 0 0 1.6rem; max-width: 34rem; }
  .star-links { display: flex; flex-wrap: wrap; gap: .4rem 1.8rem; margin: 0; font: 400 .76rem/1.4 var(--r-mono); letter-spacing: .1em; text-transform: uppercase; }
  .star-links a { text-decoration: none; padding: .55rem 0; border-bottom: 1px solid var(--accent); }
  .star-face { margin: 0; }
  .star-face canvas { display: block; width: 100%; aspect-ratio: 1; max-height: 62svh; }
  .star-face figcaption { font: italic 300 .84rem/1.45 var(--r-serif); color: var(--ink-faint); text-align: center; max-width: 24rem; margin: 0 auto; }
  .prose .big { font: 300 clamp(2rem, 5vw, 3.2rem)/1.05 var(--r-serif); color: var(--ink); letter-spacing: -.01em; margin: 0 0 .9rem; font-variant-numeric: lining-nums; }
  .swatches { display: flex; flex-wrap: wrap; gap: .6rem 2rem; font: 400 .76rem/1.4 var(--r-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); }
  .swatches span { display: inline-flex; align-items: center; gap: .6rem; }
  .swatches i { width: 1.4rem; height: 1.4rem; border-radius: 50%; display: inline-block; }
  .names { margin: 0; display: grid; gap: .7rem; }
  .names div { display: grid; grid-template-columns: minmax(0, 13rem) minmax(0, 1fr); gap: 1rem; }
  .names dt { font: 400 .72rem/1.6 var(--r-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); }
  .names dd { margin: 0; color: var(--ink); }
  @media (max-width: 760px) {
    .star-head { grid-template-columns: minmax(0, 1fr); }
    .star-face { order: -1; }
    .star-face canvas { max-height: 38svh; }
    .names div { grid-template-columns: minmax(0, 1fr); gap: 0; }
  }
</style>
