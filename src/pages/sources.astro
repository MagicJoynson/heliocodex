  .ledger-head { max-width: 46rem; margin: 0 0 clamp(48px, 7vw, 88px); }
  .ledger-kicker { font: 400 .74rem/1.4 var(--s-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 1.2rem; }
  .ledger h1 { font: 300 clamp(2.8rem, 7vw, 5.6rem)/.96 var(--s-serif); letter-spacing: -.02em; margin: 0 0 1.4rem; }
  .ledger-lead { font: 300 clamp(1.1rem, 1rem + .4vw, 1.3rem)/1.55 var(--s-serif); color: var(--ink-soft); margin: 0; }

  .entry { display: grid; grid-template-columns: minmax(0, 17rem) minmax(0, 40rem); gap: 1rem 4rem; padding: 2.2rem 0 2.4rem; border-top: 1px solid var(--rule); }
  .entry h2 { font: italic 300 clamp(1.5rem, 2.4vw, 1.9rem)/1.15 var(--s-serif); margin: 0; color: var(--ink); }
  .entry-body p { font: 300 1.1rem/1.65 var(--s-serif); color: var(--ink-soft); margin: 0 0 1em; }
  .entry-body p:last-child { margin-bottom: 0; }
  .sheets { list-style: none; margin: .2rem 0 1.2rem; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem 1.3rem; font: 400 .8rem/1.6 var(--s-mono); letter-spacing: .02em; }
  .drawn h2 { color: var(--accent); }
  .drawn-list { list-style: none; margin: 1.2rem 0 0; padding: 0; display: grid; gap: .9rem; }
  .drawn-list li { font: 300 1.05rem/1.55 var(--s-serif); color: var(--ink-soft); display: grid; grid-template-columns: 11rem 1fr; gap: 1.4rem; }
  .drawn-list span { font: 400 .74rem/1.9 var(--s-mono); letter-spacing: .04em; color: var(--ink); }

  .plates-sec { border-top: 1px solid var(--rule); padding: 2.4rem 0 3rem; }
  .plates-sec h2 { font: 300 clamp(2rem, 4vw, 3rem)/1 var(--s-serif); letter-spacing: -.015em; margin: 0 0 .9rem; }
  .plates-lead { font: 300 1.1rem/1.55 var(--s-serif); color: var(--ink-soft); max-width: 36em; margin: 0 0 2.4rem; }
  .plates { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr)); gap: 2.4rem 1.8rem; }
  .plate-img { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: #000; }
  .plate-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s ease, filter .6s; filter: saturate(.92); }
  .plate-img:hover img { transform: scale(1.03); filter: none; }
  .plate-world { font: 400 .7rem/1.4 var(--s-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); margin: .85rem 0 .35rem; }
