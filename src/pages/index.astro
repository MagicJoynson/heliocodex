---
import Analytics from '../components/Analytics.astro';
import '@fontsource/spectral/200.css';
import '@fontsource/spectral/300.css';
import '@fontsource/spectral/300-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import Margin from '../components/v2/Margin.astro';
const site = Astro.site!;
const title = 'Heliocodex · the Solar System at its true size';
const description = 'Fly through the Solar System at its true size and distance, from beyond Neptune down to the ground of Mars, then out past the stars to the oldest light there is. With lessons for wherever you are.';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL('/', site).toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL('/', site).toString()} />
    <meta property="og:site_name" content="Heliocodex" />
    <meta property="og:image" content={new URL('/brand/heliocodex-social-card-1200x630.png', site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Heliocodex: an amber Sun with a small dark world crossing it" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <Analytics />
  </head>
  <body>
    <canvas id="space" aria-label="The Solar System at its true size and distance, which you can fly through. Everything it shows is also on the Bodies, Learn and Atlas pages."></canvas>

    <header class="top">
      <a class="mark" href="/" aria-label="Heliocodex, home"><img src="/brand/heliocodex-lockup.svg" alt="" width="660" height="133" /></a>
      <nav class="pages" aria-label="Pages">
        <a href="/bodies">Bodies</a>
        <a href="/learn">Learn</a>
        <a href="/sky">Sky</a>
        <a href="/atlas">Atlas</a>
      </nav>
    </header>

    <section class="threshold" id="threshold">
      <p class="name">Heliocodex</p>
      <p class="line">The Sun and its worlds at their true size and distance. Fall in from beyond Neptune, skim the ground of Mars, then keep going, past the stars, out to the oldest light there is.</p>
      <button class="aperture" id="enter" type="button" aria-label="Enter">
        <svg viewBox="0 0 200 200" aria-hidden="true">
          <circle class="ring outer" cx="100" cy="100" r="96" />
          <circle class="ring inner" cx="100" cy="100" r="78" />
          <g class="ticks"></g>
        </svg>
        <span class="word">Enter</span>
      </button>
      <p class="note" id="status">Loading the Solar System…</p>
      <div class="nope" id="nope" hidden>
        <p>This browser cannot draw the 3D view, but the rest of Heliocodex works without it.</p>
        <p class="links"><a href="/bodies">Bodies</a><a href="/learn">Learn</a><a href="/sky">Tonight’s sky</a><a href="/atlas">Atlas</a></p>
      </div>
      <noscript><p class="nope-ns">The 3D view needs JavaScript. Everything else is on the <a href="/bodies">Bodies</a>, <a href="/learn">Learn</a>, <a href="/sky">Sky</a> and <a href="/atlas">Atlas</a> pages.</p></noscript>
    </section>

    <div class="hud" id="hud">
      <div class="readout">
        <span class="k" id="r-k">Distance to Mars</span>
        <span class="v" id="r-v">—</span>
        <span class="k2" id="r-k2"></span>
      </div>
      <button type="button" class="skip" id="skip">Skip ahead</button>
    </div>

    <div class="help" id="help">
      <p class="fine-only">Drag to look round. <b>W A S D</b> to fly, <b>E</b> and <b>Q</b> for up and down, <b>Shift</b> to go faster. Scroll to change your speed.</p>
      <p class="coarse-only">Drag to look round. Hold the pad to fly forwards, or its lower half to go back.</p>
      <p class="fine-only">Or open <b>Fly to</b> and pick somewhere.</p>
    </div>

    <div class="pad" id="pad" aria-hidden="true"><span>Fly</span><i></i><span>Back</span></div>
    <p class="tech" id="tech"></p>
    <p class="gen" id="gen"></p>
    <div class="goto" id="goto">
      <button type="button" class="goto-btn" id="goto-btn" aria-expanded="false" aria-controls="goto-list">Fly to</button>
      <nav class="goto-list" id="goto-list" aria-label="Fly to" hidden></nav>
    </div>
    <Margin />

    <script>
      import { createWorld } from '../lib/v2/engine/world';
      const $ = (id: string) => document.getElementById(id)!;

      const ticks = document.querySelector('.ticks')!;
      for (let i = 0; i < 120; i++) {
        const a = (i / 120) * Math.PI * 2, long = i % 10 === 0;
        const r1 = 86, r2 = long ? 92 : 89;
        const l = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        l.setAttribute('x1', String(100 + Math.cos(a) * r1)); l.setAttribute('y1', String(100 + Math.sin(a) * r1));
        l.setAttribute('x2', String(100 + Math.cos(a) * r2)); l.setAttribute('y2', String(100 + Math.sin(a) * r2));
        ticks.appendChild(l);
      }

      const AU = 149_597_870_700;
      const LY = 9.4607304725808e15;
      const fmt = (m: number) => {
        if (m > 1e9 * LY) return `${(m / LY / 1e9).toLocaleString('en-GB', { maximumFractionDigits: 1 })} billion light years`;
        if (m > 1e6 * LY) return `${(m / LY / 1e6).toLocaleString('en-GB', { maximumFractionDigits: 1 })} million light years`;
        if (m > 0.05 * LY) return `${(m / LY).toLocaleString('en-GB', { maximumFractionDigits: m > 100 * LY ? 0 : 2 })} light years`;
        if (m > 0.1 * AU) return `${(m / AU).toFixed(m > 10 * AU ? 1 : 2)} au`;
        if (m > 1e9) return `${(m / 1e9).toFixed(1)} million km`;
        if (m > 10_000) return `${Math.round(m / 1000).toLocaleString('en-GB')} km`;
        if (m > 1000) return `${(m / 1000).toFixed(2)} km`;
        return `${Math.max(0, Math.round(m)).toLocaleString('en-GB')} m`;
      };
      const fmtSpeed = (v: number) => (v > 3e9 ? `${fmt(v)} a second` : v > 1000 ? `${(v / 1000).toLocaleString('en-GB', { maximumFractionDigits: 1 })} km a second` : `${Math.round(v)} m a second`);

      const params = new URLSearchParams(location.search);
      let world: Awaited<ReturnType<typeof createWorld>>;
      const startedAt = performance.now();
      try {
        world = await createWorld({
          canvas: $('space') as HTMLCanvasElement,
          forceWebGL: params.has('gl') || (() => { try { return sessionStorage.getItem('hc-gl') === '1'; } catch { return false; } })(),
          onReadout(r) {
            if (r.mode === 'free') {
              $('r-k').textContent = r.far ? 'Distance from the Sun' : 'Height above the ground';
              $('r-v').textContent = fmt(r.alt);
              $('r-k2').textContent = fmtSpeed(r.speed);
            } else {
              $('r-k').textContent = r.far ? 'Distance from the Sun' : `Distance to ${r.target}`;
              $('r-v').textContent = fmt(r.dist);
              $('r-k2').textContent = '';
            }
            $('tech').textContent = r.tech;
            $('gen').textContent = r.note ?? '';
            // the ground test means nothing among the stars
            document.body.classList.toggle('far', !!r.far);
          },
          onArrive() {
            document.body.classList.add('in', 'arrived');
            // the controls fade once you have had time to read them
            setTimeout(() => document.body.classList.add('helped'), 40_000);
            // ?go=<id>&d=<km>: carry on to a place once the way in has arrived (the atlas links here)
            const go = params.get('go');
            // with ?low the engine arrives on its first frame, before createWorld has returned
            // a star waits for the catalogue to load, for up to 15 seconds
            const giveUp = performance.now() + 15_000;
            const goWhenReady = () => {
              if (!world || (go && !world.canFlyTo(go) && go.startsWith('star:') && performance.now() < giveUp)) { setTimeout(goWhenReady, 100); return; }
              if (go && world.canFlyTo(go)) {
                const d = Number(params.get('d'));
                world.flyTo({ target: go, distanceKm: d > 0 ? d : undefined }).catch(() => {});
              }
            };
            if (go) goWhenReady();
          },
          onLost() {
            // WebGPU that dies straight after starting is a driver problem: try once more on WebGL 2
            const early = performance.now() - startedAt < 15_000;
            let tried = false;
            try { tried = sessionStorage.getItem('hc-gl') === '1'; sessionStorage.setItem('hc-gl', '1'); } catch {}
            if (early && !params.has('gl') && !tried) { params.set('gl', ''); location.search = params.toString(); return; }
            $('status').textContent = 'The graphics stopped. Reload the page to carry on.';
            document.body.classList.remove('in', 'arrived');
          },
        });
        $('status').textContent = params.has('debug') ? `Ready · ${world.backend} · ${world.depthMode}` : matchMedia('(pointer: coarse)').matches ? 'Tap the ring to go in' : 'Click the ring, or press Enter';
        // every moon, where it really is; loaded after the engine is running
        import('../lib/v2/layers/moons').then(async ({ createMoonsLayer }) => {
          const { allBodies } = await import('../data/bodies/index');
          world.registerLayer(createMoonsLayer(allBodies));
        });
        // the guide: lessons, facts, glossary and atlas for wherever you are
        import('../lib/v2/margin/panel').then(({ mountMargin }) => mountMargin(world));
        // testing: ?debug exposes the engine to scripts
        if (params.has('debug')) (window as unknown as { __w: typeof world }).__w = world;
        // testing: ?t=2017-06-01 sets the clock
        if (params.get('t')) world.setTime(params.get('t'));
        // Fly to: the places, in groups, behind one button
        const list = $('goto-list'), btn = $('goto-btn');
        const GROUPS: [string, [string, string][]][] = [
          ['The Sun and planets', [['sun', 'The Sun'], ['mercury', 'Mercury'], ['venus', 'Venus'], ['earth', 'Earth'], ['mars', 'Mars'], ['jupiter', 'Jupiter'], ['saturn', 'Saturn'], ['uranus', 'Uranus'], ['neptune', 'Neptune']]],
          ['Moons and dwarfs', [['moon', 'The Moon'], ['io', 'Io'], ['titan', 'Titan'], ['pluto', 'Pluto']]],
          ['Further out', [['solar-system', 'The whole Solar System'], ['oort-cloud', 'The Oort cloud'], ['neighbourhood', 'Our neighbour stars'], ['night-sky', 'Every star you can see'], ['milky-way', 'The Milky Way'], ['local-group', 'The Local Group'], ['cosmic-web', 'The cosmic web'], ['cmb', 'The oldest light']]],
        ];
        const shut = () => { list.hidden = true; btn.setAttribute('aria-expanded', 'false'); };
        for (const [head, places] of GROUPS) {
          const h = document.createElement('p'); h.className = 'goto-h'; h.textContent = head; list.appendChild(h);
          const row = document.createElement('div'); row.className = 'goto-row';
          for (const [id, name] of places) {
            const b = document.createElement('button');
            b.type = 'button';
            b.textContent = name;
            b.addEventListener('click', () => { shut(); world.flyTo({ target: id }).catch(() => {}); });
            row.appendChild(b);
          }
          list.appendChild(row);
        }
        btn.addEventListener('click', () => { const open = list.hidden; list.hidden = !open; btn.setAttribute('aria-expanded', String(open)); if (open) (list.querySelector('button') as HTMLButtonElement | null)?.focus(); });
        addEventListener('keydown', (e) => { if (e.key === 'Escape' && !list.hidden) { shut(); btn.focus(); } });
        addEventListener('pointerdown', (e) => { if (!list.hidden && !$('goto').contains(e.target as Node)) shut(); });
        if (params.has('debug')) document.body.classList.add('debug');
      } catch (e) {
        $('status').hidden = true;
        $('enter').hidden = true;
        $('nope').hidden = false;
        console.error(e);
        throw e;
      }

      const ap = $('enter');
      function go() {
        if (document.body.classList.contains('in')) return;
        const r = ap.getBoundingClientRect();
        const [sx, sy] = world.sunScreen();
        ap.style.setProperty('--dx', `${sx - (r.left + r.width / 2)}px`);
        ap.style.setProperty('--dy', `${sy - (r.top + r.height / 2)}px`);
        document.body.classList.add('in');
        setTimeout(() => world.enter(16), 900);
      }
      ap.addEventListener('click', go);
      addEventListener('keydown', (e) => { if (e.key === 'Enter' && !document.body.classList.contains('in')) go(); });
      $('skip').addEventListener('click', () => world.skip());

      // the touch pad: top half flies forward, bottom half back
      const pad = $('pad');
      const padAt = (e: PointerEvent) => {
        const r = pad.getBoundingClientRect();
        world.setPad((e.clientY - r.top) / r.height < 0.5 ? 1 : -1);
      };
      pad.addEventListener('pointerdown', (e) => { pad.setPointerCapture(e.pointerId); padAt(e); pad.classList.add('on'); });
      pad.addEventListener('pointermove', (e) => { if (pad.hasPointerCapture(e.pointerId)) padAt(e); });
      const off = () => { world.setPad(0); pad.classList.remove('on'); };
      pad.addEventListener('pointerup', off);
      pad.addEventListener('pointercancel', off);

      if (params.has('low')) document.body.classList.add('in', 'arrived');
    </script>

    <style is:global>
      :root { --ink: #ece7dc; --soft: #b9b2a5; --faint: #7d786f; --warm: #f1c98e; --serif: 'Spectral', Georgia, serif; --mono: 'IBM Plex Mono', ui-monospace, monospace; }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; background: #000; color: var(--ink); overflow: hidden; }
      body { font-family: var(--serif); -webkit-font-smoothing: antialiased; }
      button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
      #space { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }

      /* threshold */
      /* a soft dark pool behind the words, so the orbits drawn behind them never cross the reading */
      .threshold::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(ellipse 46% 40% at 50% 46%, rgba(0,0,0,.82) 0%, rgba(0,0,0,.55) 55%, rgba(0,0,0,0) 100%); transition: opacity 1s ease; }
      body.in .threshold::before { opacity: 0; }
      .threshold { position: fixed; inset: 0; display: grid; place-content: center; justify-items: center; text-align: center; padding: 24px; gap: 0; transition: opacity 1.2s ease .2s; }
      .name { font: 200 clamp(2.8rem, 9vw, 6.4rem)/1 var(--serif); letter-spacing: .02em; margin: 0 0 .9rem; }
      .line { font: italic 300 clamp(1rem, .9rem + .5vw, 1.25rem)/1.5 var(--serif); color: var(--soft); margin: 0 0 clamp(36px, 7vh, 64px); max-width: 26em; }
      .aperture { position: relative; width: clamp(150px, 22vmin, 210px); aspect-ratio: 1; display: grid; place-items: center; transition: transform 1s cubic-bezier(.6,0,.3,1), opacity .6s ease .55s; }
      .aperture svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
      .ring { fill: none; stroke: rgba(236,231,220,.55); stroke-width: .8; vector-effect: non-scaling-stroke; transition: stroke .4s, r .9s cubic-bezier(.6,0,.3,1); }
      .ring.inner { stroke: rgba(236,231,220,.22); }
      .ticks line { stroke: rgba(236,231,220,.35); stroke-width: .7; vector-effect: non-scaling-stroke; }
      .ticks { transform-origin: 100px 100px; animation: turn 120s linear infinite; }
      @keyframes turn { to { transform: rotate(360deg); } }
      .word { font: 400 .78rem/1 var(--mono); letter-spacing: .32em; text-transform: uppercase; padding-left: .32em; transition: opacity .3s; }
      .aperture:hover .ring.outer, .aperture:focus-visible .ring.outer { stroke: var(--warm); }
      .aperture:hover .word, .aperture:focus-visible .word { color: var(--warm); }
      .aperture:focus-visible { outline: none; }
      .aperture::after { content: ''; position: absolute; inset: 47%; border-radius: 50%; background: radial-gradient(circle, #fff6e6 0%, rgba(255,214,150,.6) 35%, rgba(255,180,90,0) 70%); opacity: 0; transition: opacity .5s ease .35s, inset .9s cubic-bezier(.6,0,.3,1); }
      .gen { position: fixed; left: var(--gutter, 24px); bottom: 12px; margin: 0; font: italic 300 .85rem/1.4 var(--serif); color: var(--faint); pointer-events: none; text-shadow: 0 1px 6px #000; }
      .goto { position: fixed; right: clamp(16px, 4vw, 40px); bottom: max(clamp(16px, 4vh, 36px), env(safe-area-inset-bottom)); display: none; flex-direction: column; align-items: flex-end; z-index: 31; }
      body.arrived .goto { display: flex; }
      .goto-btn { order: 2; font: 400 .7rem/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--ink); background: rgba(10,10,12,.72); border: 1px solid rgba(236,231,220,.3); border-radius: 999px; padding: 11px 16px 11px 18px; }
      .goto-btn::after { content: ''; display: inline-block; width: 5px; height: 5px; margin-left: 10px; border: solid currentColor; border-width: 1px 1px 0 0; transform: translateY(1px) rotate(-45deg); transition: transform .2s; }
      .goto-btn[aria-expanded="true"]::after { transform: translateY(-2px) rotate(135deg); }
      .goto-btn:hover, .goto-btn:focus-visible, .goto-btn[aria-expanded="true"] { color: var(--warm); border-color: rgba(241,201,142,.6); outline: none; }
      .goto-list { order: 1; margin-bottom: 10px; width: min(22rem, calc(100vw - 32px)); max-height: min(62vh, 34rem); overflow-y: auto; padding: 14px 16px 6px; background: rgba(9,9,11,.94); border: 1px solid rgba(236,231,220,.2); }
      .goto-list[hidden] { display: none; }
      .goto-h { font: 400 .62rem/1.3 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--faint); margin: 0 0 6px; }
      .goto-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 12px; margin-bottom: 12px; }
      .goto-row button { text-align: left; font: 300 1rem/1.25 var(--serif); color: var(--soft); padding: 6px 0; border-bottom: 1px solid rgba(236,231,220,.08); }
      .goto-row button:hover, .goto-row button:focus-visible { color: var(--warm); outline: none; }

      /* the page's own header: the mark, and the way to the rest of the site */
      .top { position: fixed; z-index: 28; left: 0; right: 0; top: 0; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: max(clamp(14px, 3vh, 26px), env(safe-area-inset-top)) clamp(16px, 4vw, 40px) 0; pointer-events: none; }
      .top > * { pointer-events: auto; }
      body.margin-open .pages { opacity: 0; visibility: hidden; }
      .pages { transition: opacity .3s, visibility 0s; }
      .mark { display: block; opacity: 0; transition: opacity 1.2s ease 1.4s; }
      .mark img { display: block; height: 24px; width: auto; }
      body.in .mark { opacity: 1; }
      .pages { display: flex; gap: clamp(14px, 2.4vw, 26px); }
      .pages a { font: 400 .68rem/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--soft); text-decoration: none; padding: 8px 0; text-shadow: 0 1px 8px #000; }
      .pages a:hover, .pages a:focus-visible { color: var(--warm); outline: none; }
      @media (max-width: 420px) { .mark img { height: 19px; } .pages { gap: 12px; } .pages a { letter-spacing: .08em; font-size: .64rem; } }
      .nope { max-width: 26em; margin-top: 8px; }
      .nope p, .nope-ns { font: 300 1.05rem/1.55 var(--serif); color: var(--soft); margin: 0 0 1rem; }
      .nope .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 22px; }
      .nope a, .nope-ns a { color: var(--warm); }
      .nope .links a { font: 400 .72rem/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid rgba(241,201,142,.4); padding-bottom: 4px; }
      .note { margin: clamp(28px, 5vh, 48px) 0 0; font: 400 .7rem/1.5 var(--mono); letter-spacing: .08em; color: var(--faint); text-transform: uppercase; }

      /* going through */
      body.in .name, body.in .line, body.in .note { opacity: 0; transition: opacity .5s ease; }
      body.in .word { opacity: 0; }
      body.in .ring.outer { r: 3; } body.in .ring.inner { r: 1; }
      body.in .ticks { opacity: 0; transition: opacity .3s; }
      body.in .aperture { transform: translate(var(--dx, 0), var(--dy, 0)) scale(.35); opacity: 0; }
      body.in .aperture::after { opacity: 1; inset: 42%; }
      body.in .threshold { pointer-events: none; }


      /* instruments */
      .hud { position: fixed; left: 0; right: 0; bottom: 0; padding: 0 clamp(16px, 4vw, 40px) max(clamp(16px, 4vh, 36px), env(safe-area-inset-bottom)); display: flex; justify-content: space-between; align-items: end; opacity: 0; transition: opacity 1.4s ease 1.2s; pointer-events: none; }
      body.in .hud { opacity: 1; pointer-events: auto; }
      .readout { display: grid; gap: .3rem; }
      .readout .k, .readout .k2 { font: 400 .68rem/1.3 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--faint); }
      .readout .v { font: 200 clamp(2rem, 5vw, 3.4rem)/1 var(--serif); font-variant-numeric: tabular-nums; letter-spacing: -.01em; }
      .skip { font: 400 .68rem/1.3 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--soft); border-bottom: 1px solid rgba(236,231,220,.3); padding-bottom: 3px; }
      body.arrived .skip { opacity: 0; pointer-events: none; transition: opacity .6s; }

      /* arrival */
      .arrival { position: fixed; right: clamp(16px, 5vw, 64px); top: 50%; transform: translateY(-50%); width: min(23rem, calc(100% - 32px)); opacity: 0; pointer-events: none; transition: opacity 2s ease 1s; text-shadow: 0 1px 14px #000, 0 0 2px #000; }
      body.arrived .arrival { opacity: 1; }
      .a-kicker { font: 400 .68rem/1.3 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--warm); margin: 0 0 .8rem; }
      .arrival h1 { font: 200 clamp(3rem, 7vw, 5rem)/.95 var(--serif); margin: 0 0 1rem; letter-spacing: -.01em; }
      .arrival p { font: 300 1.08rem/1.6 var(--serif); color: var(--soft); margin: 0 0 1rem; }
      .arrival .a-note { font: italic 300 .95rem/1.5 var(--serif); color: var(--faint); }

      @media (max-width: 760px) {
        .arrival { top: auto; bottom: 8.5rem; transform: none; left: 16px; right: 16px; width: auto; }
        .arrival .a-note { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        .ticks { animation: none; }
      }

      /* instruments, help and the touch pad */
      .hud { pointer-events: none !important; } .hud .skip { pointer-events: auto; }
      .readout { text-shadow: 0 1px 10px rgba(0,0,0,.85), 0 0 2px rgba(0,0,0,.9); }
      .note b { font-weight: 400; color: var(--soft); }
