---
import Base from '../layouts/Base.astro';
import { siteLd } from '../lib/site';
import '../styles/reading.css';
import { portraits } from '../lib/portraits';
import { allLessons, STRAND_NAMES } from '../lib/v2/margin/content';
import facts from '../data/facts.json';
import { bodies } from '../data/bodies';
import { STRAND_ORDER } from '../lib/v2/margin/content';
import { WORLD_PAGES } from '../data/world-pages';
import { body } from '../data/bodies/index';
import { PACKS } from '../lib/learn/packs';
import { cover } from '../lib/learn/map';

const lessons = await allLessons();
// what the site holds, shown by name: ways into the lessons and every subject, and the moons with full pages (with their pictures)
const strands = STRAND_ORDER.map((strand) => ({ strand, name: STRAND_NAMES[strand], first: lessons.filter((l) => l.data.strand === strand).sort((a, b) => a.data.order - b.data.order)[0] })).filter((g) => g.first);
const moonCards = Object.entries(WORLD_PAGES).filter(([, pg]) => !!(pg.globe ?? pg.picture)).sort(([a], [b]) => (a === 'moon' ? -1 : b === 'moon' ? 1 : 0)).map(([id, pg]) => ({ id, name: body(id)!.name.replace(/^The /, 'The '), src: ['deimos', 'iapetus', 'ida', 'bennu', 'pallas'].includes(id) ? `/img/thumbs/${id}.jpg` : (pg.globe ?? pg.picture)!.src }));
// four ways into the lessons: the ten-lesson start, then three first looks from the stars out to the whole universe
const startPack = PACKS.find((p) => p.id === 'start-here')!;
const picks = ['how-stars-live-and-die', 'what-a-black-hole-is', 'the-expanding-universe'].map((id) => lessons.find((l) => l.id === id)!).map((l) => ({ id: l.id, title: l.data.title, summary: l.data.summary, pic: cover(l) }));
const plainCredit = (c: string) => c.replace(/<[^>]+>/g, '').replace(/^[\s\S]*?Credit:\s*/, '').replace(/\.$/, '').trim();
const pictureCredits = [`Earthrise, ${plainCredit(startPack.photo.caption)}`, ...picks.filter((p) => p.pic).map((p) => `${p.title}, ${plainCredit(p.pic!.caption)}`)].join('; ') + '.';
const tagline = Object.fromEntries(bodies.map((b) => [b.slug, b.tagline]));
const jupiterKm = portraits.find((p) => p.slug === 'jupiter')!.km;
// every picture is sized so that its disc is (diameter ÷ Jupiter's) × --j across
const strip = portraits.map((p) => ({ ...p, h: (p.km / jupiterKm) / p.disc, w: (p.km / jupiterKm) / p.disc * (p.width / p.height) }));
const sun = strip[0];
const worlds = strip.slice(1);
// distances on a doubling scale, from a quarter of the Earth's distance out to 40 times it
const LO = Math.log2(0.25), HI = Math.log2(40);
const au = (a: number) => (Math.log2(a) - LO) / (HI - LO);
const AU_TICKS = [0.25, 0.5, 1, 2, 4, 8, 16, 32].map((a) => ({ a, label: a === 0.25 ? '¼ au' : a === 0.5 ? '½ au' : `${a} au` }));
const lightTime = (a: number) => { const m = a * 8.317; if (m < 60) return `${Math.round(m)} light minutes`; const h = Math.floor(m / 60); return `${h} h ${String(Math.round(m - h * 60)).padStart(2, '0')} min of light`; };
const far = worlds.map((w) => {
  const a = (facts.planets as Record<string, { elements: { a_au: number } }>)[w.slug].elements.a_au;
  const d = 12 + 52 * Math.sqrt(w.km / jupiterKm);
  const ih = d / w.disc;
  return { ...w, a, x: au(a), d: Math.round(d), ih: Math.round(ih), iw: Math.round(ih * (w.width / w.height)), light: lightTime(a) };
});
import Tonight from '../components/Tonight.astro';
---
<Base title="Heliocodex: the Sun, its worlds and everything beyond" path="/" jsonld={{ '@context': 'https://schema.org', ...siteLd, potentialAction: { '@type': 'SearchAction', target: 'https://heliocodex.com/search?q={search_term_string}', 'query-input': 'required name=search_term_string' } }} description="The Sun, its planets and everything beyond, from real photographs and measurements. Explore it in 3D, learn how it works, or see what is above you tonight.">
  <script is:inline>
    // links made before the 3D view moved (/?go=mars and the like) still land in it
    if (/[?&](go|gl)=?/.test(location.search)) location.replace('/explore' + location.search + location.hash);
  </script>

  <section class="front" aria-labelledby="home-h">
   <div class="front-hero">
    <div class="front-text">
      <h1 id="home-h">The Sun, its worlds and everything beyond</h1>
      <p class="front-lede">Fly through the real Solar System at its true size and distance, or see what is above you tonight. The photographs are from real spacecraft and telescopes, and every figure has its source.</p>
    </div>
    <div class="front-scene">
      <svg class="front-orbits" viewBox="0 0 1200 420" aria-hidden="true" focusable="false"><ellipse class="ring" cx="600" cy="470" rx="150" ry="90" /><ellipse class="ring" cx="600" cy="470" rx="250" ry="160" /><ellipse class="ring" cx="600" cy="470" rx="380" ry="240" /><ellipse class="ring" cx="600" cy="470" rx="520" ry="330" /><ellipse class="ring" cx="600" cy="470" rx="680" ry="430" /><circle r="5" fill="#7fb2e8"><animateMotion dur="38s" begin="-4s" repeatCount="indefinite" path="M 350 470 a 250 160 0 1 1 500 0 a 250 160 0 1 1 -500 0" /></circle><circle r="4.5" fill="#d9784a"><animateMotion dur="70s" begin="-30s" repeatCount="indefinite" path="M 220 470 a 380 240 0 1 1 760 0 a 380 240 0 1 1 -760 0" /></circle><circle r="9" fill="#e3c79a"><animateMotion dur="120s" begin="-60s" repeatCount="indefinite" path="M 80 470 a 520 330 0 1 1 1040 0 a 520 330 0 1 1 -1040 0" /></circle><circle r="7" fill="#e9d9a8"><animateMotion dur="190s" begin="-20s" repeatCount="indefinite" path="M -80 470 a 680 430 0 1 1 1360 0 a 680 430 0 1 1 -1360 0" /></circle></svg>
      <a class="front-enter" href="/explore?enter=1"><span>Enter</span><b>fly it in 3D</b></a>
      <img class="front-sun" src={sun.src} alt="" width={sun.width} height={sun.height} fetchpriority="high" />
    </div>
    <nav class="front-more" aria-label="Other ways in"><a href="/explore?tour=1">Take the guided tour in 3D</a><a href="/sky">See tonight’s sky</a><a href="/learn/packs/start-here">Start with ten short lessons</a></nav>
   </div>
    <p class="front-credit">{sun.credit} The orbits above are drawn for effect, not to scale.</p>
  </section>

  <Tonight />

  <section class="home-hero" aria-label="The Sun and the eight planets">
    <figure class="family" tabindex="0" aria-label="The Sun's eight planets to one scale. On a phone, scroll sideways.">
      <div class="strip" style={`--sun-h:${sun.h}`}>
        <ol class="worlds">
          {worlds.map((w) => (
            <li class={`w-${w.slug}`} style={`--h:${w.h.toFixed(4)};--w:${w.w.toFixed(4)}`}>
              <a href={`/${w.slug}`}>
                <img src={w.src} alt={w.alt} width={w.width} height={w.height} loading="lazy" decoding="async" />
                <span>{w.name.replace('The ', '')}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <figcaption>
        The Sun and its eight planets in real spacecraft photographs, all drawn to one scale. The distances would never fit: at this size, Neptune would be <b id="nep">about 5 kilometres</b> off to the right. <a href="/explore">See it at true size and distance</a>.
      </figcaption>
    </figure>
    <div class="ledger"><p class="ledger-go"><a href="/worlds">Every moon and small world, by distance</a></p></div>
  </section>

  <div class="reading home">
    <section class="band" aria-labelledby="b-learn">
      <h2 id="b-learn"><a href="/learn">Learn</a></h2>
      <div class="b-body">
        <div class="b-learn">
          <a class="b-lead" href="/learn/packs/start-here">
            <img src={startPack.photo.src} alt="" width={startPack.photo.width} height={startPack.photo.height} loading="lazy" decoding="async" />
            <span class="b-lead-k">Start here</span>
            <b>{startPack.name}</b>
            <span class="b-lead-t">{startPack.blurb}</span>
          </a>
          <ul class="b-picks">
            {picks.map((l) => (
              <li><a href={`/learn/${l.id}`}>{l.pic && <img src={l.pic.src} alt="" width="160" height="160" loading="lazy" decoding="async" />}<span><b>{l.title}</b><span>{l.summary}</span></span></a></li>
            ))}
          </ul>
        </div>
        <p class="b-k">Or choose a subject</p>
        <p class="b-list b-subjects">{strands.map((g, i) => <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={`/learn/subject/${g.strand}`}>{g.name}</a></>)} <a class="b-all" href="/learn">All {lessons.length} lessons</a></p>
        <p class="b-credit">Pictures: {pictureCredits}</p>
      </div>
    </section>

    <section class="band" aria-labelledby="b-worlds">
      <h2 id="b-worlds"><a href="/worlds">Moons and small worlds</a></h2>
      <div class="b-body">
        <ul class="b-moons">
          {moonCards.slice(0, 16).map((m) => <li><a href={`/worlds/${m.id}`}><img src={m.src} alt="" width="96" height="96" loading="lazy" /><span>{m.name}</span></a></li>)}
        </ul>
        <p class="b-more-lessons"><a class="b-all" href="/worlds">Every moon and small world, by distance</a></p>
      </div>
    </section>

    <section class="far" aria-labelledby="far-h">
      <div class="far-head">
        <h2 id="far-h">How far out they are</h2>
        <p>The same worlds at their real distances from the Sun. Each mark is twice as far out as the one before, and the pictures are not drawn to the same scale as the distances; on an even scale, the four rocky planets would be squeezed into the first twentieth.</p>
      </div>
      <div class="orbitband">
        <span class="sunglow" aria-hidden="true"></span>
        <span class="axis" aria-hidden="true">{AU_TICKS.map((t) => <i style={`--x:${au(t.a)}`}><b>{t.label}</b></i>)}</span>
        <ol class="out">
          {far.map((p) => (
            <li style={`--x:${p.x};--d:${p.d}px;--iw:${p.iw}px;--ih:${p.ih}px`}>
              <a href={`/${p.slug}`}>
                <span class="o-name">{p.name.replace('The ', '')}</span>
                <span class="o-disc"><img src={`/img/bodies/cut/${p.slug}.webp`} alt="" width={p.width} height={p.height} loading="lazy" /></span>
                <span class="o-dist">{p.a.toFixed(p.a < 2 ? 2 : 1)} au</span>
                <span class="o-light">{p.light}</span>
                <span class="o-tag">{tagline[p.slug]}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <p class="far-more">Beyond the eight planets, the moons, dwarf planets, asteroids and comets are set out on <a href="/worlds">the map of the Solar System</a>.</p>
    </section>

  </div>

  <script>
    // the orbits in the front scene stand still for visitors who ask for less motion
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelector<SVGSVGElement>('.front-orbits')?.pauseAnimations();
    // How far off Neptune would sit if the strip's scale carried on: Jupiter is drawn --j pixels wide.
    const strip = document.querySelector<HTMLElement>('.strip');
    const out = document.getElementById('nep');
    if (strip && out) {
      const j = strip.querySelector<HTMLElement>('.w-jupiter img')!.getBoundingClientRect().height * 0.718; // Jupiter's disc, in CSS pixels
      const metres = (4.4951e9 / 139820) * j * 0.000264583; // Neptune's mean distance in Jupiter widths, at 0.26 mm per CSS pixel
      const km = metres / 1000;
      out.textContent = km >= 1 ? `about ${km < 10 ? km.toFixed(1) : Math.round(km)} kilometres` : `about ${Math.round(metres)} metres`;
    }
  </script>
</Base>

<style>

  /* the front door: a scene. The Sun rises over the bottom edge, orbits turn above it, and the ring enters the 3D model. The ring is the one action. */
  .front { position: relative; overflow: hidden; background: radial-gradient(1px 1px at 12% 18%, #fff8 50%, transparent 51%), radial-gradient(1px 1px at 78% 12%, #fff6 50%, transparent 51%), radial-gradient(1px 1px at 33% 40%, #fff5 50%, transparent 51%), radial-gradient(1.5px 1.5px at 90% 44%, #fff7 50%, transparent 51%), radial-gradient(1px 1px at 55% 8%, #fff6 50%, transparent 51%), #000; border-bottom: 1px solid rgba(236,231,220,.12); text-align: center; --ink: #ece7dc; --ink-soft: #d8d2c5; --ink-faint: #b3ad9f; --accent: #e9c48a; font-family: 'Spectral', Georgia, serif; }
  .front-text { position: relative; z-index: 3; max-width: 44rem; margin: 0 auto; padding: clamp(30px, 5vw, 60px) var(--gutter) 0; }
  .front h1 { font: 300 clamp(2rem, 4.4vw, 3.5rem)/1.06 'Spectral', Georgia, serif; letter-spacing: -.02em; margin: 0 0 .9rem; text-wrap: balance; color: var(--ink); }
  .front-lede { font: 300 clamp(1.05rem, 1rem + .35vw, 1.2rem)/1.5 'Spectral', Georgia, serif; color: var(--ink-soft); margin: 0 auto 1.4rem; max-width: 34rem; text-wrap: balance; }
  .front-scene { position: relative; z-index: 1; overflow: hidden; flex: 1 1 auto; height: auto; min-height: clamp(300px, 31vw, 450px); max-height: 760px; margin-top: clamp(-10px, 0vw, 0px); --sw: min(150vw, 1900px); --arc: clamp(90px, 15vw, 230px); }
  .front-sun { animation: sun-drift 90s ease-in-out infinite alternate; position: absolute; left: 50%; max-width: none; width: calc(var(--sw) * 1.03); height: auto; top: calc(100% - var(--arc) - var(--sw) * .120); transform: translateX(-50%); pointer-events: none; -webkit-mask-image: radial-gradient(closest-side, #000 74%, transparent 100%); mask-image: radial-gradient(closest-side, #000 74%, transparent 100%); }
  .front-enter { position: absolute; z-index: 3; left: 50%; top: calc(100% - var(--arc) - var(--sw) * .016 - 1.9rem); transform: translate(-50%, -50%); width: 8.2rem; height: 8.2rem; border-radius: 50%; display: grid; place-content: center; text-align: center; gap: .2rem; text-decoration: none; color: var(--ink); background: rgba(0,0,0,.55); border: 1px solid rgba(233,196,138,.8); box-shadow: 0 0 0 6px rgba(233,196,138,.12), 0 0 0 7px rgba(233,196,138,.35); transition: box-shadow .3s ease, background .3s ease; }
  .front-enter span { font: 400 1rem/1 'IBM Plex Mono', monospace; letter-spacing: .22em; text-transform: uppercase; }
  .front-enter b { font: italic 300 .9rem/1.2 'Spectral', Georgia, serif; font-weight: 300; color: var(--ink-soft); padding: 0 .8rem; }
  .front-enter:hover { background: rgba(233,196,138,.16); box-shadow: 0 0 0 9px rgba(233,196,138,.18), 0 0 0 10px rgba(233,196,138,.5); }
  @keyframes sun-drift { from { transform: translateX(-50%) scale(1); } to { transform: translateX(-50%) scale(1.035); } }
  @media (prefers-reduced-motion: reduce) { .front-sun { animation: none; } }
  .front-orbits { position: absolute; left: 50%; bottom: 0; width: min(1200px, 130vw); height: auto; transform: translateX(-50%); }
  .front-orbits { -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 16%, #000 55%, transparent 96%); mask-image: linear-gradient(to bottom, transparent 0, #000 16%, #000 55%, transparent 96%); }
  .front-orbits .ring { fill: none; stroke: rgba(236,231,220,.22); stroke-width: 1; }
  .front-hero { display: flex; flex-direction: column; min-height: calc(100vh - 56px); min-height: calc(100svh - 56px); }
  .front-more { position: relative; z-index: 3; display: flex; flex-wrap: wrap; justify-content: center; gap: 0 2.2rem; padding: .5rem var(--gutter); background: #000; border-top: 1px solid rgba(236,231,220,.12); font: 400 1.1rem/1.5 'Spectral', Georgia, serif; }
  .front-more a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); text-decoration: underline rgba(233,196,138,.7); text-underline-offset: .25em; text-decoration-thickness: 1px; }
  .front-more a::after { content: '→'; margin-left: .4em; color: var(--accent); text-decoration: none; }
  .front-more a:hover { color: var(--accent); }
  .front-more a:focus-visible, .front-enter:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .front-credit { position: relative; z-index: 3; margin: 0; max-width: none; padding: .7rem var(--edge) 1rem; background: #000; font: italic 300 .8125rem/1.4 'Spectral', Georgia, serif; color: var(--ink-faint); text-align: left; }
  @media (min-width: 761px) and (max-width: 1100px) { .front-hero { min-height: 0; } .front-scene { flex: none; height: clamp(420px, 56vw, 560px); max-height: none; } }
  @media (max-width: 760px) {
    .front-hero { min-height: 0; }
    .front-scene { flex: none; height: 350px; min-height: 0; max-height: none; --sw: 230vw; --arc: 110px; }
    .front-enter b { white-space: nowrap; padding: 0; }
    .front-enter { top: calc(100% - var(--arc) - var(--sw) * .016 - 6.2rem); width: 7.2rem; height: 7.2rem; }
    .front-orbits { width: 190vw; }
    .front-more { gap: 0 1.1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .front-enter { transition: none; } }

  .home-hero { position: relative; overflow: hidden; background: #000; border-bottom: 1px solid rgba(236,231,220,.12); font-family: 'Spectral', Georgia, serif; --ink: #ece7dc; --ink-soft: #d8d2c5; --ink-faint: #a8a296; --accent: #e9c48a; }
  .ledger { position: relative; z-index: 2; padding: clamp(14px, 2vw, 24px) var(--edge) clamp(24px, 3vw, 36px); margin-left: 0; }
  .ledger table { width: 100%; border-collapse: collapse; font: 400 1.02rem/1.3 'Spectral', Georgia, serif; color: var(--ink-soft); }
  .ledger caption { text-align: left; font: 400 .82rem/1.4 'IBM Plex Mono', monospace; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); padding: 0 0 .6rem; }
  .ledger th, .ledger td { text-align: left; padding: .42rem 1rem .42rem 0; border-top: 1px solid rgba(236,231,220,.12); font-weight: 400; }
  .ledger thead th { font: 400 .8rem/1.3 'IBM Plex Mono', monospace; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); border-top: 0; }
  .ledger .kind { display: block; font: 400 .78rem/1.3 'IBM Plex Mono', monospace; color: var(--ink-faint); }
  .ledger tbody th a { color: var(--ink); text-decoration: none; border-bottom: 1px solid rgba(233,196,138,.45); }
  .ledger tbody th a:hover { color: var(--accent); }
  .ledger-go { display: flex; flex-wrap: wrap; gap: .5rem 1.6rem; margin: 1rem 0 0; }
  .ledger-go a { font: 400 .82rem/1 'IBM Plex Mono', monospace; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); text-decoration: none; border-bottom: 1px solid rgba(233,196,138,.5); padding-bottom: 3px; }
  @media (max-width: 560px) { .ledger table { font-size: .92rem; } .ledger th, .ledger td { padding-right: .5rem; } }
  .home-hero .home-text { position: relative; z-index: 2; max-width: 46rem; padding: clamp(22px, 3.4vw, 40px) var(--gutter) 0; margin-left: 0; }
  .home-hero .label { font: 400 .72rem/1.5 'IBM Plex Mono', monospace; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 1.1rem; }
  .home-hero h1 { font: 300 clamp(1.7rem, 3vw, 2.4rem)/1.1 'Spectral', Georgia, serif; letter-spacing: -.02em; margin: 0 0 1.2rem; text-wrap: balance; color: var(--ink); }
  .home-hero .lead { font: 300 clamp(1.08rem, 1rem + .4vw, 1.3rem)/1.55 'Spectral', Georgia, serif; color: var(--ink-soft); max-width: 38rem; margin: 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px 22px; align-items: center; margin: 1.8rem 0 0; }
  .cta { font: 400 .78rem/1 'IBM Plex Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); text-decoration: none; padding: 15px 0; border-bottom: 1px solid rgba(233,196,138,.5); }
  .cta:hover { color: var(--accent); border-color: var(--accent); }
  .cta.primary { padding: 15px 22px; border: 1px solid var(--accent); border-radius: 999px; color: #160f05; background: var(--accent); }
  .cta.primary:hover { background: #f3d4a2; color: #160f05; }

  /* the family portrait: --j is Jupiter's width in pixels; everything else follows from real diameters */
  .family { margin: 0; padding: clamp(14px, 2.4vw, 28px) 0 4px; --j: clamp(64px, 11vw, 168px); }
  .strip { position: relative; display: flex; align-items: center; height: calc(var(--j) * 1.6); }
  .worlds { position: relative; list-style: none; margin: 0 var(--edge); padding: 0; display: flex; align-items: center; justify-content: space-between; gap: calc(var(--j) * .12); }
  .worlds li { flex: none; }
  .worlds a { display: grid; justify-items: center; gap: 10px; text-decoration: none; color: var(--ink-faint); }
  .worlds img { display: block; height: calc(var(--j) * var(--h)); width: calc(var(--j) * var(--w)); max-width: none; }
  .worlds span { font: 400 .75rem/1 'IBM Plex Mono', monospace; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; position: absolute; top: calc(50% + var(--j) * .62); }
  .worlds li { position: relative; display: grid; justify-items: center; min-width: 4.6rem; }
  .worlds a:hover span, .worlds a:focus-visible span { color: var(--accent); }
  .family figcaption { position: relative; z-index: 2; font: italic 300 .95rem/1.5 'Spectral', Georgia, serif; color: var(--ink-soft); max-width: none; padding: 1rem var(--edge) 0; margin-left: 0; }
  .family figcaption > * , .family figcaption { text-wrap: pretty; }
  .family figcaption b { font-weight: 400; color: var(--ink-soft); }
  .family figcaption a { color: var(--ink-soft); text-decoration-color: rgba(233,196,138,.5); text-underline-offset: .18em; }
  /* on a phone all eight fit across, still to one scale; the small rocky planets' names alternate above and below */
  @media (max-width: 760px) {
    .family { --j: 11vw; }
    .strip { height: calc(var(--j) * 2.2); }
    .worlds { margin-left: var(--gutter); padding-right: 6px; gap: 3px; }
    .worlds li { min-width: 1.5rem; }
    /* eight names at a readable size do not fit across a phone, so the row scrolls sideways; the names alternate above and below */
    .family { overflow-x: auto; overscroll-behavior-x: contain; }
    .strip { min-width: 33rem; height: calc(var(--j) * 2.4); }
    .worlds li { min-width: 3.9rem; }
    .worlds span { font-size: .8125rem; letter-spacing: .04em; top: calc(50% + var(--j) * .62); }
    .worlds li:nth-child(even) span { top: auto; bottom: calc(50% + var(--j) * .62); }
    .family figcaption { position: sticky; left: 0; max-width: 100vw; }
    .home-hero .home-text, .ledger, .family figcaption { margin-left: 0; }
    .ledger td, .ledger th { white-space: nowrap; }
    .ledger td:last-child { white-space: normal; }
    .ledger table { table-layout: auto; }
    .ledger table { font-size: .9rem; }
    .ledger thead th { white-space: normal; }
  }

