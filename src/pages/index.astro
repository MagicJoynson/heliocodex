---
import Base from '../layouts/Base.astro';
import '../styles/reading.css';
import { portraits } from '../lib/portraits';
import { PACKS, packLessons } from '../lib/learn/packs';
import { allLessons } from '../lib/v2/margin/content';
import { bodies } from '../data/bodies';

const lessons = await allLessons();
const tagline = Object.fromEntries(bodies.map((b) => [b.slug, b.tagline]));
const jupiterKm = portraits.find((p) => p.slug === 'jupiter')!.km;
// every picture is sized so that its disc is (diameter ÷ Jupiter's) × --j across
const strip = portraits.map((p) => ({ ...p, h: (p.km / jupiterKm) / p.disc, w: (p.km / jupiterKm) / p.disc * (p.width / p.height) }));
const sun = strip[0];
const worlds = strip.slice(1);
const packs = PACKS.slice(0, 3);
const elsewhere = [
  { href: '/sky', label: 'Tonight’s sky', about: 'A live map of what is above you right now, wherever you are, with every planet and bright star named.' },
  { href: '/stars', label: 'Meet a star', about: 'All 8,770 stars you can see by eye, each with its own page, and the one whose light set out when you were born.' },
  { href: '/atlas', label: 'The atlas', about: 'Flat charts of everything in the 3D view, drawn to scale and good enough to print.' },
  { href: '/glossary', label: 'Glossary', about: 'Every word on the site, explained plainly in a line or two.' },
];
---
<Base title="Heliocodex" path="/" description="The Sun, its planets and everything beyond, from real photographs and real measurements. Explore it in 3D, learn how it works, or find what is above you tonight.">
  <script is:inline>
    // links made before the 3D view moved (/?go=mars and the like) still land in it
    if (/[?&](go|gl)=?/.test(location.search)) location.replace('/explore' + location.search + location.hash);
  </script>

  <section class="home-hero" aria-labelledby="home-h">
    <div class="home-text">
      <p class="label">The Sun, its worlds and everything beyond</p>
      <h1 id="home-h">Our corner of the universe, at its true size</h1>
      <p class="lead">Real photographs and real measurements, from the Sun out to the oldest light there is. Fly through it in 3D, learn how it works in short lessons, or step outside and find what is above you tonight.</p>
      <p class="ctas">
        <a class="cta primary" href="/explore">Enter the 3D solar system</a>
        <a class="cta" href="/learn">Start learning</a>
      </p>
    </div>

    <figure class="family">
      <div class="strip" style={`--sun-h:${sun.h}`}>
        <img class="sunlimb" src={sun.src} alt={sun.alt} width={sun.width} height={sun.height} />
        <ol class="worlds">
          {worlds.map((w) => (
            <li class={`w-${w.slug}`} style={`--h:${w.h.toFixed(4)};--w:${w.w.toFixed(4)}`}>
              <a href={`/${w.slug}`}>
                <img src={w.src} alt={w.alt} width={w.width} height={w.height} loading="eager" />
                <span>{w.name.replace('The ', '')}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <figcaption>
        The Sun and its eight planets in real spacecraft photographs, all drawn to one scale. The distances would never fit: at this size, Neptune would be <b id="nep">about 5 kilometres</b> off to the right. <a href="/explore">See it at true size and distance</a>.
      </figcaption>
    </figure>
  </section>

  <div class="reading home">
    <section class="row">
      <div class="hang">
        <h2>Explore in 3D</h2>
        <p class="note">Works on a phone. Calm by default, with a minimap and big zoom buttons.</p>
      </div>
      <div>
        <a class="shot" href="/explore">
          <img src="/img/home/explore.jpg" alt="The 3D view: Mars close up against black space, with a small round map of the planets’ orbits in the corner and zoom buttons at the side." width="1280" height="720" loading="lazy" />
        </a>
        <p class="body">Every planet and its main moons where they are today, worked out from NASA’s orbital data. Click a world to glide to it, zoom out past the stars to the Milky Way and the cosmic web, or switch on <em>easier to see</em> to make the planets large enough to spot. Walk on a stretch of Mars made from its real colour map.</p>
        <p class="go"><a href="/explore">Enter the 3D solar system</a></p>
      </div>
    </section>

    <section class="row">
      <div class="hang">
        <h2>The planets</h2>
        <p class="note">One page each, with a fall from orbit to the ground.</p>
      </div>
      <ul class="plain-list planet-grid">
        {strip.map((p) => (
          <li>
            <a href={`/${p.slug}`}>
              <span class="disc"><img src={p.src} alt="" width={p.width} height={p.height} loading="lazy" style={`height:${(78 / p.disc).toFixed(1)}%`} /></span>
              <span class="pname">{p.name}</span>
              <span class="ptag">{tagline[p.slug]}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="row">
      <div class="hang">
        <h2>Learn</h2>
        <p class="note">{lessons.length} short lessons, each with real pictures and a deeper level beneath.</p>
      </div>
      <div>
        <ul class="plain-list pack-list">
          {packs.map((p) => (
            <li>
              <a href={`/learn/packs/${p.id}`}><img src={p.photo.src} alt="" width={p.photo.width} height={p.photo.height} loading="lazy" /><span>{p.name}</span></a>
              <p>{packLessons(p).length} lessons. {p.blurb}</p>
            </li>
          ))}
        </ul>
        <p class="go"><a href="/learn">Every lesson, by subject</a></p>
      </div>
    </section>

    <section class="row">
      <div class="hang">
        <h2>Look up</h2>
        <p class="note">For the sky over your own head.</p>
      </div>
      <ul class="plain-list elsewhere">
        {elsewhere.map((e) => <li><a href={e.href}>{e.label}</a><p>{e.about}</p></li>)}
      </ul>
    </section>
  </div>

  <script>
    // How far off Neptune would sit if the strip's scale carried on: Jupiter is drawn --j pixels wide.
    const strip = document.querySelector<HTMLElement>('.strip');
    const out = document.getElementById('nep');
    if (strip && out) {
      const j = strip.querySelector<HTMLElement>('.w-jupiter img')!.getBoundingClientRect().height * 0.718; // Jupiter's disc, in CSS pixels
      const metres = (4.4951e9 / 139820) * j * 0.000264583; // Neptune's mean distance in Jupiter widths, at 0.26 mm per CSS pixel
      const km = metres / 1000;
      out.textContent = km >= 1 ? `about ${km < 10 ? km.toFixed(1) : Math.round(km)} kilometres` : `about ${Math.round(metres)} metres`;
    }
  </script>
</Base>

<style>
  .home-hero { position: relative; overflow: hidden; background: #000; border-bottom: 1px solid rgba(236,231,220,.12); font-family: 'Spectral', Georgia, serif; --ink: #ece7dc; --ink-soft: #c4bdaf; --ink-faint: #8a8478; --accent: #e9c48a; }
  .home-hero .home-text { position: relative; z-index: 2; max-width: 46rem; padding: clamp(40px, 7vw, 96px) var(--gutter) 0; margin-left: clamp(0px, 14vw, 220px); }
  .home-hero .label { font: 400 .72rem/1.5 'IBM Plex Mono', monospace; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 1.1rem; }
  .home-hero h1 { font: 300 clamp(2.4rem, 6vw, 4.6rem)/1.02 'Spectral', Georgia, serif; letter-spacing: -.02em; margin: 0 0 1.2rem; text-wrap: balance; color: var(--ink); }
  .home-hero .lead { font: 300 clamp(1.08rem, 1rem + .4vw, 1.3rem)/1.55 'Spectral', Georgia, serif; color: var(--ink-soft); max-width: 38rem; margin: 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px 22px; align-items: center; margin: 1.8rem 0 0; }
  .cta { font: 400 .78rem/1 'IBM Plex Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); text-decoration: none; padding: 15px 0; border-bottom: 1px solid rgba(233,196,138,.5); }
  .cta:hover { color: var(--accent); border-color: var(--accent); }
  .cta.primary { padding: 15px 22px; border: 1px solid var(--accent); border-radius: 999px; color: #160f05; background: var(--accent); }
  .cta.primary:hover { background: #f3d4a2; color: #160f05; }

  /* the family portrait: --j is Jupiter's width in pixels; everything else follows from real diameters */
  .family { margin: 0; padding: clamp(28px, 5vw, 56px) 0 22px; --j: clamp(64px, 11vw, 168px); }
  .strip { position: relative; display: flex; align-items: center; height: calc(var(--j) * 1.6); }
  .sunlimb { position: absolute; top: 50%; height: calc(var(--j) * var(--sun-h)); width: auto; max-width: none; right: calc(100% - var(--j) * 1.35); transform: translateY(-50%); pointer-events: none; }
  .worlds { position: relative; list-style: none; margin: 0 0 0 calc(var(--j) * 1.6); padding: 0 var(--gutter) 0 0; display: flex; align-items: center; gap: calc(var(--j) * .12); }
  .worlds li { flex: none; }
  .worlds a { display: grid; justify-items: center; gap: 10px; text-decoration: none; color: var(--ink-faint); }
  .worlds img { display: block; height: calc(var(--j) * var(--h)); width: calc(var(--j) * var(--w)); max-width: none; }
  .worlds span { font: 400 .62rem/1 'IBM Plex Mono', monospace; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; position: absolute; top: calc(50% + var(--j) * .62); }
  .worlds li { position: relative; display: grid; justify-items: center; min-width: 4.6rem; }
  .worlds a:hover span, .worlds a:focus-visible span { color: var(--accent); }
  .family figcaption { font: italic 300 .95rem/1.5 'Spectral', Georgia, serif; color: var(--ink-faint); max-width: 44rem; padding: 2.4rem var(--gutter) 0; margin-left: clamp(0px, 14vw, 220px); }
  .family figcaption b { font-weight: 400; color: var(--ink-soft); }
  .family figcaption a { color: var(--ink-soft); text-decoration-color: rgba(233,196,138,.5); text-underline-offset: .18em; }
  @media (max-width: 700px) {
    .family { --j: 22vw; }
    .strip { overflow-x: auto; overflow-y: hidden; scrollbar-width: none; height: calc(var(--j) * 1.9); }
    .strip::-webkit-scrollbar { display: none; }
    .worlds span { font-size: .56rem; }
  }

  .home { padding-top: clamp(40px, 6vw, 80px); }
  .shot { display: block; border: 1px solid rgba(236,231,220,.14); line-height: 0; }
  .shot img { width: 100%; height: auto; display: block; }
  .shot:hover { border-color: rgba(233,196,138,.6); }
  .body { font: 300 1.12rem/1.6 var(--r-serif); color: var(--ink-soft); margin: 1.2rem 0 0; }
  .go { margin: 1rem 0 0; font: 400 .74rem/1.4 var(--r-mono); letter-spacing: .12em; text-transform: uppercase; }
  .go a { text-decoration: none; border-bottom: 1px solid rgba(233,196,138,.5); padding-bottom: 3px; }

  .planet-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr)); gap: 2rem 1.6rem; }
  .planet-grid a { display: grid; gap: .5rem; text-decoration: none; color: var(--ink); }
  .disc { display: grid; place-items: center; aspect-ratio: 1; background: #000; overflow: hidden; }
  .disc img { width: auto; max-width: none; transition: transform .4s ease; }
  .planet-grid li:nth-child(7) .disc img { height: auto !important; width: 100%; }
  .planet-grid a:hover .disc img { transform: scale(1.04); }
  .pname { font: 400 1.25rem/1.2 var(--r-serif); }
  .planet-grid a:hover .pname { color: var(--accent); }
  .ptag { font: 300 .98rem/1.4 var(--r-serif); color: var(--ink-faint); }

  .pack-list { display: grid; gap: 2.2rem 2rem; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); }
  .pack-list a { display: grid; gap: .8rem; text-decoration: none; color: var(--ink); }
  .pack-list img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; background: #000; }
  .pack-list span { font: 400 1.25rem/1.25 var(--r-serif); }
  .pack-list a:hover span { color: var(--accent); }
  .pack-list p { font: 300 1rem/1.5 var(--r-serif); color: var(--ink-soft); margin: .35rem 0 0; }

  .elsewhere { display: grid; gap: 1.6rem; }
  .elsewhere a { font: 400 1.32rem/1.25 var(--r-serif); text-decoration: none; background: linear-gradient(rgba(233,196,138,.5), rgba(233,196,138,.5)) 0 100% / 0 1px no-repeat; transition: background-size .3s ease; }
  .elsewhere a:hover { background-size: 100% 1px; }
  .elsewhere p { font: 300 1.06rem/1.5 var(--r-serif); color: var(--ink-soft); margin: .25rem 0 0; }
  @media (max-width: 760px) { .row { grid-template-columns: 1fr; } }
</style>
