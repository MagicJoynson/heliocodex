---
import Base from '../layouts/Base.astro';
import '../styles/reading.css';
import { portraits } from '../lib/portraits';
import { PACKS, packLessons } from '../lib/learn/packs';
import { allLessons, STRAND_NAMES } from '../lib/v2/margin/content';
import { PLACES, along } from '../lib/learn/map';
import facts from '../data/facts.json';
import { bodies } from '../data/bodies';
import { outlineWorlds } from '../lib/worlds';
import { plannedCount } from '../data/plan';

const lessons = await allLessons();
const tagline = Object.fromEntries(bodies.map((b) => [b.slug, b.tagline]));
const jupiterKm = portraits.find((p) => p.slug === 'jupiter')!.km;
// every picture is sized so that its disc is (diameter ÷ Jupiter's) × --j across
const strip = portraits.map((p) => ({ ...p, h: (p.km / jupiterKm) / p.disc, w: (p.km / jupiterKm) / p.disc * (p.width / p.height) }));
const sun = strip[0];
const worlds = strip.slice(1);
// distances on a doubling scale, from a quarter of the Earth's distance out to 40 times it
const LO = Math.log2(0.25), HI = Math.log2(40);
const au = (a: number) => (Math.log2(a) - LO) / (HI - LO);
const AU_TICKS = [0.25, 0.5, 1, 2, 4, 8, 16, 32].map((a) => ({ a, label: a === 0.25 ? '¼ au' : a === 0.5 ? '½' : a === 1 ? '1 au' : `${a}` }));
const lightTime = (a: number) => { const m = a * 8.317; if (m < 60) return `${Math.round(m)} light minutes`; const h = Math.floor(m / 60); return `${h} h ${String(Math.round(m - h * 60)).padStart(2, '0')} min of light`; };
const far = worlds.map((w) => {
  const a = (facts.planets as Record<string, { elements: { a_au: number } }>)[w.slug].elements.a_au;
  const d = 12 + 52 * Math.sqrt(w.km / jupiterKm);
  const ih = d / w.disc;
  return { ...w, a, x: au(a), d: Math.round(d), ih: Math.round(ih), iw: Math.round(ih * (w.width / w.height)), light: lightTime(a) };
});
const tint = (t: number) => `color-mix(in oklab, #f0c27a, #8eaeff ${Math.round(t * 100)}%)`;
const places = PLACES.filter((p) => lessons.some((l) => l.data.strand === p.strand)).map((p) => ({ ...p, name: STRAND_NAMES[p.strand], a: along(p.from), b: along(p.to), tint: tint((along(p.from) + along(p.to)) / 2) }));
---
<Base title="Heliocodex" path="/" description="The Sun, its planets and everything beyond, from real photographs and real measurements. Explore it in 3D, learn how it works, or find what is above you tonight.">
  <script is:inline>
    // links made before the 3D view moved (/?go=mars and the like) still land in it
    if (/[?&](go|gl)=?/.test(location.search)) location.replace('/explore' + location.search + location.hash);
  </script>

  <section class="home-hero" aria-labelledby="home-h">
    <div class="home-text">
      <p class="label">The Sun, its worlds and everything beyond</p>
      <h1 id="home-h">Our corner of the universe, at its true size</h1>
      <p class="lead">Real photographs and real measurements, from the Sun out to the oldest light there is. Fly through it in 3D, learn how it works in short lessons, or step outside and find what is above you tonight.</p>
      <p class="ctas">
        <a class="cta primary" href="/explore">Enter the 3D solar system</a>
        <a class="cta" href="/learn">Start learning</a>
      </p>
    </div>

    <figure class="family">
      <div class="strip" style={`--sun-h:${sun.h}`}>
        <img class="sunlimb" src={sun.src} alt={sun.alt} width={sun.width} height={sun.height} />
        <ol class="worlds">
          {worlds.map((w) => (
            <li class={`w-${w.slug}`} style={`--h:${w.h.toFixed(4)};--w:${w.w.toFixed(4)}`}>
              <a href={`/${w.slug}`}>
                <img src={w.src} alt={w.alt} width={w.width} height={w.height} loading="eager" />
                <span>{w.name.replace('The ', '')}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <figcaption>
        The Sun and its eight planets in real spacecraft photographs, all drawn to one scale. The distances would never fit: at this size, Neptune would be <b id="nep">about 5 kilometres</b> off to the right. <a href="/explore">See it at true size and distance</a>.
      </figcaption>
    </figure>
  </section>

  <div class="reading home">
    <section class="row wide feature">
      <a class="shot" href="/explore">
        <img src="/img/home/explore.jpg" alt="The 3D view seen from above at a slant: the paths of the planets round the Sun as fine rings, the planets as points of light on them, and the stars behind." width="1280" height="720" loading="lazy" />
      </a>
      <div class="feature-words">
        <p class="label">Explore in 3D</p>
        <h2>The whole Solar System, where it is today</h2>
        <p class="body">Every planet and its main moons in their real places, worked out from NASA’s orbital data. Click a world to glide to it, zoom out past the stars to the Milky Way and the cosmic web, or switch on <em>easier to see</em> to make the planets large enough to spot. Works on a phone.</p>
        <p class="go"><a class="btn" href="/explore">Enter the 3D solar system</a></p>
      </div>
    </section>

    <section class="far" aria-labelledby="far-h">
      <div class="far-head">
        <h2 id="far-h">How far out they are</h2>
        <p>The same worlds at their real distances from the Sun. Each mark is twice as far out as the one before; on an even scale, the four rocky planets would be squeezed into the first twentieth.</p>
      </div>
      <div class="orbitband">
        <span class="sunglow" aria-hidden="true"></span>
        <span class="axis" aria-hidden="true">{AU_TICKS.map((t) => <i style={`--x:${au(t.a)}`}><b>{t.label}</b></i>)}</span>
        <ol class="out">
          {far.map((p) => (
            <li style={`--x:${p.x};--d:${p.d}px;--iw:${p.iw}px;--ih:${p.ih}px`}>
              <a href={`/${p.slug}`}>
                <span class="o-name">{p.name.replace('The ', '')}</span>
                <span class="o-disc"><img src={`/img/bodies/cut/${p.slug}.webp`} alt="" width={p.width} height={p.height} loading="lazy" /></span>
                <span class="o-dist">{p.a.toFixed(p.a < 2 ? 2 : 1)} au</span>
                <span class="o-light">{p.light}</span>
                <span class="o-tag">{tagline[p.slug]}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <p class="far-more"><a href="/worlds" data-outline>Beyond the eight planets: {outlineWorlds.length} moons, dwarf planets, asteroids and comets</a> are set out on the map of worlds. Their pages are outlines for now, and are being written.</p>
    </section>

    <section class="learnband" aria-labelledby="learn-h">
      <div class="lb-words">
        <p class="label">Learn</p>
        <h2 id="learn-h">From the ground under your feet to the oldest light</h2>
        <p class="body">{lessons.length} short lessons, each written at more than one depth, set out by how long their light takes to reach you. Begin with ten first looks that cover the whole subject, or go straight to the part you want. {plannedCount} more are outlined and being written.</p>
        <p class="go"><a class="btn" href={`/learn/${packLessons(PACKS[0])[0]}`}>Begin with ten lessons</a> <a class="lb-all" href="/learn">All {lessons.length} lessons</a></p>
      </div>
      <ol class="ladder" aria-label="Subjects, nearest first">
        {places.map((p) => (
          <li>
            <a href={`/learn/subject/${p.strand}`} style={`--a:${p.a};--b:${p.b};--tint:${p.tint}`}>
              <span class="l-name">{p.name}</span>
              <span class="l-track" aria-hidden="true"><span class:list={['l-bar', { dot: p.b - p.a < 0.012 }]} /></span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="lookup" aria-labelledby="look-h">
      <a class="dome" href="/sky" aria-label="Tonight’s sky">
        <span class="dome-sky"><img src="/img/home/sky.jpg" alt="" width="960" height="600" loading="lazy" /></span>
        <span class="dome-ground" aria-hidden="true"><b>E</b><b>S</b><b>W</b></span>
      </a>
      <div class="look-words">
        <p class="label">Look up</p>
        <h2 id="look-h">What is above you tonight</h2>
        <p class="body">A live map of your own sky, for wherever you are and whenever you look, with every planet and bright star named.</p>
        <p class="go"><a class="btn" href="/sky">Open tonight’s sky</a></p>
        <ul class="refs">
          <li><a href="/stars">Meet a star</a><span>All 8,770 stars you can see by eye, and the one whose light set out when you were born.</span></li>
          <li><a href="/atlas">The atlas</a><span>Flat charts of everything in the 3D view, drawn to scale and good enough to print.</span></li>
          <li><a href="/glossary">Glossary</a><span>Every word on the site, explained in a line.</span></li>
        </ul>
      </div>
    </section>
  </div>

  <script>
    // How far off Neptune would sit if the strip's scale carried on: Jupiter is drawn --j pixels wide.
    const strip = document.querySelector<HTMLElement>('.strip');
    const out = document.getElementById('nep');
    if (strip && out) {
      const j = strip.querySelector<HTMLElement>('.w-jupiter img')!.getBoundingClientRect().height * 0.718; // Jupiter's disc, in CSS pixels
      const metres = (4.4951e9 / 139820) * j * 0.000264583; // Neptune's mean distance in Jupiter widths, at 0.26 mm per CSS pixel
      const km = metres / 1000;
      out.textContent = km >= 1 ? `about ${km < 10 ? km.toFixed(1) : Math.round(km)} kilometres` : `about ${Math.round(metres)} metres`;
    }
  </script>
</Base>

<style>
  .home-hero { position: relative; overflow: hidden; background: #000; border-bottom: 1px solid rgba(236,231,220,.12); font-family: 'Spectral', Georgia, serif; --ink: #ece7dc; --ink-soft: #d8d2c5; --ink-faint: #a8a296; --accent: #e9c48a; }
  .home-hero .home-text { position: relative; z-index: 2; max-width: 46rem; padding: clamp(40px, 7vw, 96px) var(--gutter) 0; margin-left: clamp(0px, 14vw, 220px); }
  .home-hero .label { font: 400 .72rem/1.5 'IBM Plex Mono', monospace; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 1.1rem; }
  .home-hero h1 { font: 300 clamp(2.4rem, 6vw, 4.6rem)/1.02 'Spectral', Georgia, serif; letter-spacing: -.02em; margin: 0 0 1.2rem; text-wrap: balance; color: var(--ink); }
  .home-hero .lead { font: 300 clamp(1.08rem, 1rem + .4vw, 1.3rem)/1.55 'Spectral', Georgia, serif; color: var(--ink-soft); max-width: 38rem; margin: 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px 22px; align-items: center; margin: 1.8rem 0 0; }
  .cta { font: 400 .78rem/1 'IBM Plex Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); text-decoration: none; padding: 15px 0; border-bottom: 1px solid rgba(233,196,138,.5); }
  .cta:hover { color: var(--accent); border-color: var(--accent); }
  .cta.primary { padding: 15px 22px; border: 1px solid var(--accent); border-radius: 999px; color: #160f05; background: var(--accent); }
  .cta.primary:hover { background: #f3d4a2; color: #160f05; }

  /* the family portrait: --j is Jupiter's width in pixels; everything else follows from real diameters */
  .family { margin: 0; padding: clamp(28px, 5vw, 56px) 0 22px; --j: clamp(64px, 11vw, 168px); }
  .strip { position: relative; display: flex; align-items: center; height: calc(var(--j) * 1.6); }
  .sunlimb { position: absolute; top: 50%; height: calc(var(--j) * var(--sun-h)); width: auto; max-width: none; right: calc(100% - var(--j) * 1.35); transform: translateY(-50%); pointer-events: none; }
  .worlds { position: relative; list-style: none; margin: 0 0 0 calc(var(--j) * 1.6); padding: 0 var(--gutter) 0 0; display: flex; align-items: center; gap: calc(var(--j) * .12); }
  .worlds li { flex: none; }
  .worlds a { display: grid; justify-items: center; gap: 10px; text-decoration: none; color: var(--ink-faint); }
  .worlds img { display: block; height: calc(var(--j) * var(--h)); width: calc(var(--j) * var(--w)); max-width: none; }
  .worlds span { font: 400 .62rem/1 'IBM Plex Mono', monospace; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; position: absolute; top: calc(50% + var(--j) * .62); }
  .worlds li { position: relative; display: grid; justify-items: center; min-width: 4.6rem; }
  .worlds a:hover span, .worlds a:focus-visible span { color: var(--accent); }
  .family figcaption { font: italic 300 .95rem/1.5 'Spectral', Georgia, serif; color: var(--ink-faint); max-width: 44rem; padding: 2.4rem var(--gutter) 0; margin-left: clamp(0px, 14vw, 220px); }
  .family figcaption b { font-weight: 400; color: var(--ink-soft); }
  .family figcaption a { color: var(--ink-soft); text-decoration-color: rgba(233,196,138,.5); text-underline-offset: .18em; }
  @media (max-width: 700px) {
    .family { --j: 22vw; }
    .strip { overflow-x: auto; overflow-y: hidden; scrollbar-width: none; height: calc(var(--j) * 1.9); }
    .strip::-webkit-scrollbar { display: none; }
    .worlds span { font-size: .56rem; }
  }

  .home { padding-top: clamp(24px, 4vw, 48px); }
  .feature { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 2rem 3.5rem; align-items: center; border-top: 0; }
  .feature h2 { font: 300 clamp(1.8rem, 3.2vw, 2.7rem)/1.1 var(--r-serif); letter-spacing: -.015em; margin: .8rem 0 0; text-wrap: balance; }
  .shot { display: block; border: 1px solid rgba(236,231,220,.14); line-height: 0; border-radius: 4px; overflow: hidden; }
  .shot img { width: 100%; height: auto; display: block; transition: transform .6s ease; }
  .shot:hover { border-color: rgba(233,196,138,.6); }
  .shot:hover img { transform: scale(1.02); }
  .body { font: 300 1.12rem/1.6 var(--r-serif); color: var(--ink-soft); margin: 1.1rem 0 0; }
  .go { margin: 1.6rem 0 0; }
  .btn { display: inline-block; font: 400 .76rem/1 var(--r-mono); letter-spacing: .12em; text-transform: uppercase; text-decoration: none; padding: 15px 22px; border-radius: 999px; color: #160f05 !important; background: var(--accent); }
  .btn:hover { background: #f3d4a2; }

  .home h2 { font: 300 clamp(1.8rem, 3.2vw, 2.7rem)/1.1 var(--r-serif); letter-spacing: -.015em; margin: .8rem 0 0; text-wrap: balance; }

  /* the planets at their distances: a doubling scale running out from the Sun's glow */
  .far { padding: 3rem 0 1rem; border-top: 1px solid var(--rule); }
  .far-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .6rem 3rem; }
  .far-head h2 { margin: 0; }
  .far-more { margin: 1.4rem 0 0; font: 300 1rem/1.5 var(--r-serif); color: var(--ink-faint); max-width: 40rem; }
  .far-head p { font: 300 1.02rem/1.5 var(--r-serif); color: var(--ink-faint); max-width: 34rem; margin: 0; }
  .orbitband { position: relative; height: 17rem; margin: 2.4rem 0 0; }
  .far { overflow-x: clip; }
  .sunglow { position: absolute; left: -15rem; top: 50%; width: 17rem; height: 17rem; transform: translateY(-50%); border-radius: 50%; background: radial-gradient(circle, #ffd27a 0, #f39a2e 55%, #b4521a 70%, rgba(180,82,26,0) 71%); box-shadow: 0 0 60px 10px rgba(243,154,46,.35); pointer-events: none; }
  .axis { position: absolute; left: 3rem; right: 0; top: 50%; height: 1px; background: linear-gradient(90deg, rgba(240,194,122,.5), var(--rule) 30%); }
  .axis i { position: absolute; left: calc(var(--x) * 100%); top: -4px; width: 1px; height: 9px; background: rgba(236,231,220,.25); font-style: normal; }
  .axis b { position: absolute; top: 5.6rem; left: 0; transform: translateX(-50%); font: 400 .62rem/1 var(--r-mono); letter-spacing: .08em; color: var(--ink-faint); white-space: nowrap; font-weight: 400; }
  .out { list-style: none; margin: 0; padding: 0; position: absolute; left: 3rem; right: 0; top: 0; bottom: 0; }
  .out li { position: absolute; left: calc(var(--x) * 100%); top: 0; bottom: 0; transform: translateX(-50%); }
  .out a { display: grid; grid-template-rows: 1fr 4.4rem 1fr; justify-items: center; height: 100%; text-decoration: none; color: var(--ink); }
  .o-name { align-self: end; font: 400 1.05rem/1.2 var(--r-serif); padding-bottom: .7rem; white-space: nowrap; }
  .o-disc { display: grid; place-items: center; width: var(--d); height: 4.4rem; }
  .o-disc img { width: var(--iw); height: var(--ih); max-width: none; transition: transform .4s ease; }
  .o-dist { align-self: start; padding-top: .7rem; font: 400 .7rem/1.4 var(--r-mono); letter-spacing: .06em; color: var(--ink-soft); white-space: nowrap; }
  .o-light, .o-tag { display: none; }
  .out a:hover .o-name { color: var(--accent); }
  .out a:hover .o-disc img { transform: scale(1.12); }

  /* learn: the subjects as a ladder of light-travel time */
  .learnband { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 2.5rem 5rem; align-items: center; padding: 4rem 0; margin-top: 2rem; border-top: 1px solid var(--rule); }
  .learnband .go { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; }
  .lb-all { font: 400 .76rem/1 var(--r-mono); letter-spacing: .12em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid rgba(233,196,138,.5); padding-bottom: 3px; }
  .ladder { list-style: none; margin: 0; padding: 0; }
  .ladder a { display: grid; grid-template-columns: 15rem minmax(0, 1fr); gap: 1.2rem; align-items: center; padding: .42rem 0; text-decoration: none; color: var(--ink-soft); border-top: 1px solid rgba(236,231,220,.07); }
  .l-name { font: 400 1rem/1.25 var(--r-serif); text-align: right; }
  .ladder a:hover .l-name { color: var(--accent); }
  .l-track { position: relative; height: 1rem; margin: 0 8px; }
  .l-track::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--rule); }
  .l-bar { position: absolute; top: 50%; left: calc(var(--a) * 100%); width: max(calc((var(--b) - var(--a)) * 100%), 10px); height: 4px; margin-top: -2px; border-radius: 2px; background: var(--tint); }
  .l-bar.dot { width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; }

  /* look up: tonight's sky drawn as a dome over the horizon */
  .lookup { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 2.5rem 4.5rem; align-items: center; padding: 4rem 0 2rem; border-top: 1px solid var(--rule); }
  .dome { display: block; position: relative; text-decoration: none; }
  .dome-sky { display: block; aspect-ratio: 2 / 1; border-radius: 50% 50% 0 0 / 100% 100% 0 0; overflow: hidden; background: #0a0e1c; box-shadow: inset 0 0 60px rgba(0,0,0,.6); }
  .dome-sky img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; display: block; transition: transform .8s ease; }
  .dome:hover .dome-sky img { transform: scale(1.04); }
  .dome-ground { display: flex; justify-content: space-between; padding: .6rem 4% 0; border-top: 1px solid rgba(236,231,220,.4); font: 400 .7rem/1 var(--r-mono); letter-spacing: .12em; color: var(--ink-faint); }
  .dome-ground b { font-weight: 400; }
  .refs { list-style: none; margin: 2.2rem 0 0; padding: 0; }
  .refs li { display: grid; gap: .2rem; padding: .8rem 0; border-top: 1px solid var(--rule); }
  .refs a { font: 400 1.15rem/1.3 var(--r-serif); text-decoration: none; }
  .refs span { font: 300 .95rem/1.45 var(--r-serif); color: var(--ink-faint); }

  @media (max-width: 900px) {
    .orbitband { height: auto; margin-top: 1.6rem; }
    .sunglow { display: none; }
    .axis { display: none; }
    .out { position: relative; left: 0; border-left: 1px solid var(--rule); margin-left: 2.2rem; }
    .out li { position: relative; left: 0; transform: none; }
    .out a { grid-template-columns: 5rem minmax(0, 1fr) auto; grid-template-rows: auto auto; grid-template-areas: 'disc name dist' 'disc tag light'; gap: .15rem .8rem; height: auto; padding: .8rem 0; margin-left: -2.2rem; justify-items: start; align-items: center; }
    .o-disc { grid-area: disc; justify-self: center; height: 3.6rem; width: 5rem; }
    .o-disc img { width: calc(var(--iw) * .52); height: calc(var(--ih) * .52); }
    .o-name { grid-area: name; padding: 0; align-self: end; }
    .o-dist { grid-area: dist; padding: 0; align-self: end; justify-self: end; }
    .o-tag { grid-area: tag; display: block; font: 300 .9rem/1.4 var(--r-serif); color: var(--ink-faint); align-self: start; }
    .o-light { grid-area: light; display: block; font: 400 .62rem/1.4 var(--r-mono); color: var(--ink-faint); justify-self: end; align-self: start; white-space: nowrap; }
    .learnband, .lookup { grid-template-columns: minmax(0, 1fr); }
    .ladder a { grid-template-columns: 11rem minmax(0, 1fr); }
  }
  @media (max-width: 480px) { .ladder a { grid-template-columns: 8.5rem minmax(0, 1fr); } .l-name { font-size: .9rem; } .o-light { display: none; } }
  @media (prefers-reduced-motion: reduce) { .o-disc img, .dome-sky img { transition: none; } }
  @media (max-width: 900px) { .feature { grid-template-columns: 1fr; } .home .feature h2 { margin-top: .8rem; } }
  @media (max-width: 760px) { .row { grid-template-columns: 1fr; } }
</style>
