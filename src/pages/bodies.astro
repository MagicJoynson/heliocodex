---
import Reading from '../layouts/Reading.astro';
import { bodies } from '../data/bodies';
import { phys, fmt, hoursToDay, daysToYear } from '../lib/format';
import { portraits } from '../lib/portraits';
import facts from '../data/facts.json';

const kindWord: Record<string, string> = { star: 'Our star', terrestrial: 'Rocky planet', 'gas giant': 'Gas giant', 'ice giant': 'Ice giant' };
// where each page's fall ends, in a line
const landings: Record<string, string> = {
  sun: 'Drift a few thousand kilometres over the boiling surface, towards a sunspot.',
  mercury: 'Stand on a crater rim near the north pole, the Sun low on the horizon.',
  venus: 'Sink through the acid cloud to the orange ground the Venera landers saw.',
  earth: 'Come down through the cloud to open sea off O‘ahu.',
  mars: 'Land in Gale crater, under Mount Sharp, where Curiosity is working.',
  jupiter: 'Skim the cloud tops beside the Great Red Spot, with Io overhead.',
  saturn: 'Hang in the haze at 40° north, under the arch of the rings.',
  uranus: 'Midnight at 45° north. The Sun is still up, and five moons sit in a row.',
  neptune: 'Ride above the blue at 29° north, where white streaks cast their shadows.',
};
const photo = Object.fromEntries(portraits.map((p) => [p.slug, p]));
const list = bodies.map((b) => {
  const p = phys(b.slug) as Record<string, number> | undefined;
  const e = (facts.planets as any)[b.slug]?.elements;
  return {
    slug: b.slug,
    name: b.slug === 'sun' ? 'The Sun' : b.slug === 'earth' ? 'The Earth' : b.name,
    kind: kindWord[b.kind],
    tagline: b.tagline,
    land: landings[b.slug],
    photo: photo[b.slug],
    rows: b.slug === 'sun'
      ? [['Width', '1,392,700 km'], ['Surface', 'about 5,500 °C'], ['One turn', '25 to 35 days'], ['Light to the Earth', '8 min 20 s']]
      : [
          ['Width', `${fmt(p!.radius_mean_km * 2)} km`],
          ['From the Sun', `${fmt(e.a_au, 2)} au`],
          ['Year', daysToYear(p!.orbit_period_days)],
          ['Day', hoursToDay(p!.day_hours)],
          ['Moons', `${p!.moons}`],
        ],
  };
});
---
<Reading title="The Sun and planets" path="/bodies" description="The Sun and its eight planets, each with a real spacecraft photograph, its key numbers from NASA, and a page that falls from orbit to the ground.">
  <header class="reading-head with-pic" style="--pic: url(/img/bodies/jupiter.jpg)">
    <p class="label">Planets</p>
    <h1>The Sun and its eight planets</h1>
    <p class="lead">Each has its own page: a fall from orbit down to the ground, or as near to a ground as that world has, with the story of what you pass on the way. Every photograph here is real, taken by a spacecraft or by astronauts.</p>
  </header>

  <ol class="plain-list bodies">
    {list.map((w) => (
      <li class={`b b-${w.slug}`}>
        <a class="pic" href={`/${w.slug}`} tabindex="-1" aria-hidden="true"><img src={w.photo.src} alt="" width={w.photo.width} height={w.photo.height} loading="lazy" style={`--s:${w.slug === 'saturn' ? 1 : (0.82 / w.photo.disc).toFixed(3)}`} /></a>
        <div class="txt">
          <p class="label">{w.kind}</p>
          <h2><a href={`/${w.slug}`}>{w.name}</a></h2>
          <p class="tag">{w.tagline}</p>
          <dl>{w.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          <p class="land">{w.land}</p>
          <p class="links"><a href={`/${w.slug}`}>Fall to the surface</a><a href={`/explore?go=${w.slug}`}>See it in 3D</a></p>
          <p class="credit">{w.photo.credit}</p>
        </div>
      </li>
    ))}
  </ol>

  <section class="row quiet">
    <div class="hang"><h2>And the rest</h2></div>
    <div class="more">
      <p>The dwarf planets, the moons, the asteroids and the comets are all in the <a href="/explore">3D view</a> and on the charts of the <a href="/atlas">atlas</a>. Distances are averages, in astronomical units: 1 au is the Earth’s distance from the Sun, about 150 million km. Figures are from NASA’s planetary fact sheets and JPL; the full list is on the <a href="/sources">sources</a> page.</p>
    </div>
  </section>
</Reading>

<style>
  .bodies { display: grid; gap: 0; margin: 0 0 3rem; }
  .b { display: grid; grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); gap: 1.5rem 3.5rem; align-items: center; padding: 2.6rem 0; border-top: 1px solid var(--rule); }
  .pic { position: relative; display: block; aspect-ratio: 1; background: #000; line-height: 0; overflow: hidden; }
  .pic img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: contain; transform: scale(var(--s, 1)); }
  .txt h2 { font: 300 clamp(2rem, 4vw, 3rem)/1.05 var(--r-serif); letter-spacing: -.015em; margin: .5rem 0 .4rem; }
  .txt h2 a { text-decoration: none; }
  .tag { font: italic 300 1.2rem/1.4 var(--r-serif); color: var(--ink-soft); margin: 0 0 1.2rem; }
  dl { display: flex; flex-wrap: wrap; gap: .9rem 2rem; margin: 0 0 1.2rem; }
  dt { font: 400 .66rem/1.4 var(--r-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); }
  dd { margin: .15rem 0 0; font: 400 .95rem/1.3 var(--r-mono); color: var(--ink); }
  .land { font: 300 1.08rem/1.55 var(--r-serif); color: var(--ink-soft); margin: 0 0 1rem; max-width: 36rem; }
  .links { display: flex; flex-wrap: wrap; gap: .6rem 1.6rem; margin: 0 0 1rem; font: 400 .74rem/1.4 var(--r-mono); letter-spacing: .12em; text-transform: uppercase; }
  .links a { text-decoration: none; border-bottom: 1px solid rgba(233,196,138,.5); padding-bottom: 3px; }
  .credit { font: italic 300 .86rem/1.45 var(--r-serif); color: var(--ink-faint); margin: 0; max-width: 36rem; }
  .more p { font: 300 1.06rem/1.6 var(--r-serif); color: var(--ink-soft); margin: 0; }
  @media (max-width: 760px) { .b { grid-template-columns: 1fr; } .pic { max-width: 22rem; } }
</style>
