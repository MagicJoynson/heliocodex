{
  "name": "heliocodex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-budget.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "facts": "python3 -I scripts/build-facts.py",
    "test:content": "python3 -I scripts/check-content.py",
    "check:links": "node scripts/check-links.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:atlas-labels": "node scripts/check-atlas-labels.mjs",
    "test:sky": "rolldown src/lib/sky/sky.test.ts --file node_modules/.cache/sky-test.mjs --platform node --log-level warn && node node_modules/.cache/sky-test.mjs",
    "test:search": "rolldown src/lib/search.test.ts --file node_modules/.cache/search-test.mjs --platform node --log-level warn && node node_modules/.cache/search-test.mjs",
    "test:atlas": "rolldown src/lib/v2/atlas/chart.test.ts --file node_modules/.cache/atlas-test.mjs --platform node --log-level warn && node node_modules/.cache/atlas-test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bevan": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/italiana": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "astro": "^7.4.7",
    "katex": "^0.19.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
